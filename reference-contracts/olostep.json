    "/apis/v1/olostep/web-scrape": {
      "post": {
        "description": "This is the fixed one-credit surface. Olostep parsers and LLM extraction are not accepted by this catalog tool; a team can call them directly through its own raw Olostep tool.\n\n<!-- aisa-pricing:start -->\nA request reference price is not currently available; use a request quote where supported. Declared unit rate: $0.000001 USD per provider_credit. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "olostep.web-scrape",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url_to_scrape": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "formats": {
                    "items": {
                      "enum": [
                        "markdown"
                      ],
                      "type": "string"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array",
                    "description": "Structured parsers, JSON extraction and llm_extract are deliberately excluded because they have separate variable credit prices."
                  },
                  "max_age": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 604800,
                    "description": "Reuse an Olostep scrape no older than this many seconds; 0 requests a fresh scrape."
                  },
                  "remove_images": {
                    "type": "boolean",
                    "default": false
                  },
                  "transformer": {
                    "type": "string",
                    "enum": [
                      "postlight",
                      "none"
                    ]
                  },
                  "links_on_page": {
                    "type": "object",
                    "properties": {
                      "query_to_order_links_by": {
                        "type": "string"
                      },
                      "include_links": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "exclude_links": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "formats",
                  "url_to_scrape"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Scrape a web page",
        "tags": [
          "Olostep"
        ],
