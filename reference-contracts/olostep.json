  "paths": {
    "/apis/v1/olostep/web-map-search": {
      "post": {
        "description": "Olostep bills one credit for the first 1,000 returned URLs and another credit per additional 1,000. Requiring top_n <= 1,000 makes the platform hold exact. Unbounded mapping is available through a team's own raw Olostep tool.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.002 USD (not a fixed price). Declared unit rate: $0.000001 USD per provider_credit. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "olostep.web-map-search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "search_query": {
                    "minLength": 1,
                    "type": "string",
                    "examples": [
                      "billing and credit documentation"
                    ]
                  },
                  "top_n": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer",
                    "description": "The 1,000-URL cap keeps this request inside Olostep's first one-credit map band.",
                    "examples": [
                      10
                    ]
                  },
                  "include_subdomain": {
                    "type": "boolean",
                    "default": true
                  },
                  "include_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "exclude_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "search_query",
                  "top_n",
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Find relevant URLs on a website",
        "tags": [
          "Olostep"
        ],
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
          "quote": {
