        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "minLength": 1,
                    "type": "string",
                    "examples": [
                      "Olostep API documentation"
                    ]
                  },
                  "limit": {
                    "maximum": 25,
                    "minimum": 1,
                    "type": "integer",
                    "examples": [
