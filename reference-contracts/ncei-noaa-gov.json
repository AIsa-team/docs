    "/apis/v1/ncei-noaa-gov/storm-events/records-get": {
      "post": {
        "description": "Fetch one storm event with its track points and fatality records when the EVENT_ID and the data year are known.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0005 USD (not a fixed price). Declared unit rate: $0.0001 USD per provider_credit. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
