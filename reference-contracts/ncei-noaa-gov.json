    "/apis/v1/ncei-noaa-gov/storm-events/records-list": {
      "post": {
        "description": "Full collection of a year's details, locations or fatalities rows. Pass type and year for the first page, then only the cursor.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0005 USD (not a fixed price). Declared unit rate: $0.0001 USD per provider_credit. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "ncei-noaa-gov.storm-events.records-list",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "cursor": {
                    "type": "string",
                    "description": "`next_cursor` of the previous page; carries the segment, so type and year may be omitted (if given they must match).",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "page_size": {
                    "type": "number",
                    "description": "Rows per page, at most 2000.\n\nProvider reference: minimum 1; maximum 2000; default 2000.",
                    "default": 2000,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 2000
                    }
                  },
                  "type": {
                    "type": "string",
                    "description": "Required without a cursor.\n\nProvider reference: allowed values [\"details\", \"locations\", \"fatalities\"].",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "oneOf": [
                        "details",
                        "locations",
                        "fatalities"
                      ]
                    }
                  },
                  "year": {
                    "type": "number",
                    "description": "Data year (the `d` part of the file name), 1950 to the current year.\n\nProvider reference: minimum 1950; maximum 2100.",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1950,
                      "max": 2100
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "page_size": 2,
                    "type": "details",
                    "year": 2026
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One page of rows from one bulk file (ep-3), segment key (type, year). Each page re-fetches the gzip, stream-decompresses it through an RFC 4180 parser (narratives hold commas, quotes and newlines), skips to the row offset, returns up to 2000 typed rows and stops. The cursor pins file name and ETag; if NCEI reissued the file in between (new c date, missing old name or different ETag) the call fails with upstream_error `publication_changed: ...` instead of mixing versions. Every row carries source_record_id, source_url, publication_id and retrieved_at; DAMAGE_* are kept verbatim with a parsed USD value beside them.\n\nThe response contains the tool result directly.\n\nThe provider identifies `records` as the primary payload key.\n\nThe provider does not publish a field list for this tool.\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
