        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "event_id": {
                    "type": "string",
                    "description": "EVENT_ID as in the CSVs and the event page URL."
                  },
                  "year": {
                    "type": "number",
                    "description": "The data year whose files hold the event (BEGIN year).\n\nProvider reference: minimum 1950; maximum 2100."
                  }
                },
                "required": [
                  "event_id",
                  "year"
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Request verified on 2026-11-11",
                  "value": {
                    "event_id": "1318063",
                    "year": 2026
                  }
                }
              }
            }
          }
        },
