  "paths": {
    "/apis/v1/hlrlookup/people-phone-network": {
      "post": {
        "description": "Answers arrive in results[0]: current_network_details and is_ported. live_status is NOT_AVAILABLE_NETWORK_ONLY because this route does not check the line; use hlrlookup.people.phone.verify for that. For +1 numbers telephone_number_type is omitted. NO_COVERAGE, BAD_FORMAT and per-result errors are free.\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.003304 USD（不是固定价格）。 声明的单位费率：每 provider_credit $0.000001 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "hlrlookup.people-phone-network",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "telephone_number": {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                    "description": "International E.164 digits without the leading +, or a national number with input_format."
                  },
                  "input_format": {
                    "enum": [
                      "GBR"
                    ],
                    "minLength": 1,
                    "type": "string",
                    "description": "ISO3 country code when telephone_number is in national format, e.g. GBR."
                  },
                  "output_format": {
                    "type": "string",
                    "description": "Format of formatted_telephone_number: E164, PLUS_E164, NATIONAL, or an ISO3 country code."
                  },
                  "save_to_cache": {
                    "enum": [
                      "PRIVATE"
                    ],
                    "minLength": 1,
                    "type": "string",
                    "description": "The result is cached only for this account, never shared."
                  },
                  "cache_days_global": {
                    "enum": [
                      0
                    ],
                    "maximum": 0,
                    "minimum": 0,
                    "type": "integer",
                    "description": "0 never reads the shared cache, so the lookup is live."
                  },
                  "cache_days_private": {
                    "enum": [
                      0
                    ],
                    "maximum": 0,
                    "minimum": 0,
                    "type": "integer",
                    "description": "0 never reads this account's cache, so the lookup is live."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "cache_days_global",
                  "cache_days_private",
                  "input_format",
                  "save_to_cache",
                  "telephone_number"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功响应"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Find which network serves a phone number",
        "tags": [
          "HLR Lookup"
        ],
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
          "quote": {
            "header": "X-AISA-Cost-Mode",
            "value": "quote"
          },
          "mpp": false,
          "mpp_methods": [],
          "x402": false
        },
