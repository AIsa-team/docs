        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "company domains",
                    "examples": [
                      [
                        "stripe.com"
                      ]
                    ]
                  },
                  "professional_network_profile_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "company profile URLs"
                  },
                  "names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "company names; use a stronger identifier when possible"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "field groups to return; technographics adds 2 credits when data is returned"
                  }
                }
              }
            }
          }
        },
