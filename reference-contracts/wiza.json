    "/apis/v1/wiza/companies-enrich": {
      "post": {
        "description": "Provide at least one company identifier. Domain or LinkedIn identity is more precise than name alone.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.05 USD (not a fixed price). Declared unit rate: $0.000001 USD per provider_credit. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "wiza.companies-enrich",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_name": {
                    "type": "string",
                    "examples": [
                      "Wiza"
                    ]
                  },
                  "company_domain": {
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string"
                  },
                  "company_linkedin_id": {
                    "type": "string",
                    "examples": [
                      "67160217"
                    ]
                  },
                  "company_linkedin_slug": {
                    "type": "string",
                    "examples": [
                      "wiza"
                    ]
                  }
                },
                "required": [
                  "company_domain"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
