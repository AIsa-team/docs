{
  "schema_version": 1,
  "description": "Public vocabulary rules for customer-visible Docs text (Spec #1285 R1 G2). Supplier names are never listed here: they come from the SUPPLIER_VOCAB_JSON secret and from the Runtime provider registry.",
  "internal_note": [
    {
      "id": "IN01",
      "pattern": "(?i)\\bPRICE\\s+DIAL\\b"
    },
    {
      "id": "IN02",
      "pattern": "\\b(?:NOT )?VERIFIED\\b"
    },
    {
      "id": "IN03",
      "pattern": "(?i)\\bcost\\s+verified\\b"
    },
    {
      "id": "IN04",
      "pattern": "(?i)\\bper\\s+served\\s+call\\b"
    },
    {
      "id": "IN05",
      "pattern": "(?i)\\bcredits?\\s+per\\s+(?:call|request|served)\\b"
    },
    {
      "id": "IN06",
      "pattern": "(?i)\\btrial\\s+plan\\b"
    },
    {
      "id": "IN07",
      "pattern": "(?i)\\bcuration\\b"
    },
    {
      "id": "IN08",
      "pattern": "(?i)\\bdoes\\s+not\\s+pre-?check\\b"
    },
    {
      "id": "IN09",
      "pattern": "(?i)\\bshared\\s+tier\\b"
    },
    {
      "id": "IN10",
      "pattern": "(?i)\\bnobody-[a-z0-9._-]*(?:@|%40)"
    },
    {
      "id": "IN11",
      "pattern": "(?i)\\$[0-9][0-9.]*\\s+per\\s+(?:call|request|credit|row|result)\\b"
    },
    {
      "id": "IN12",
      "pattern": "(?i)\\bshared\\s+key\\b"
    },
    {
      "id": "IN13",
      "pattern": "(?i)\\bTODO\\b|\\bFIXME\\b"
    }
  ],
  "hash_field": [
    {
      "id": "HF01",
      "pattern": "(?i)\\b(?:upstream|origin)[_-](?:path|origin)?[_-]?sha256\\b"
    },
    {
      "id": "HF02",
      "pattern": "(?i)(?:upstream|origin|path)[\"'_ -]*(?:sha256)?[\"']?\\s*[:=]\\s*[\"']?[0-9a-f]{64}\\b"
    }
  ],
  "public_brands": [
    "crawl4ai",
    "serpapi",
    "serper",
    "hunter",
    "tiktok",
    "instagram",
    "facebook",
    "linkedin",
    "youtube",
    "twitter",
    "telegram",
    "amazon",
    "google",
    "reddit",
    "github",
    "spotify",
    "yelp",
    "walmart"
  ]
}
