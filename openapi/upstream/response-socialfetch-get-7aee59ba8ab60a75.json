                            "hasCustomTimelines": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether the account has custom timelines."
                            },
                            "isTranslator": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether X marks the account as a translator."
                            },
                            "defaultProfile": {
                              "type": "boolean",
