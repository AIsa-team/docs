                              "type": "object",
                              "properties": {
                                "description": {
                                  "type": "string",
                                  "description": "Affiliate or business label text shown on the profile."
                                },
                                "badgeUrl": {
                                  "type": "string",
                                  "description": "Badge image URL when X provides one."
                                },
                                "url": {
                                  "type": "string",
                                  "description": "Destination URL for the label link."
                                },
                                "type": {
                                  "type": "string",
                                  "description": "X label type, such as `BusinessLabel` for an affiliation or `AutomatedLabel` for a bot account."
                                },
                                "longDescription": {
                                  "type": "string",
                                  "description": "Longer label text when X provides one, such as `Automated by @owner`."
                                }
                              },
                              "required": [
                                "description"
                              ],
                              "description": "Affiliate or business label when X provides one."
                            },
