                                      "name": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "Category name shown on the profile, such as `Science & Technology`."
                                      },
                                      "icon_name": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "X's icon name for the category, such as `IconBriefcaseStroke`."
                                      }
                                    },
                                    "required": [
                                      "id",
                                      "name",
                                      "icon_name"
                                    ],
                                    "description": "A professional category X shows on the profile."
