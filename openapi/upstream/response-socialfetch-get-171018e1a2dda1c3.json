  "paths": {
    "/apis/v1/socialfetch/v1/apple-music/track": {
      "get": {
        "responses": {
          "200": {
            "description": "Track lookup result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "Whether the track was found."
                        },
                        "track": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "platform": {
                              "type": "string",
                              "enum": [
                                "apple_music"
                              ],
                              "description": "Platform for this track."
                            },
                            "trackId": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Stable Apple Music song identifier."
                            },
                            "title": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Track title."
                            },
                            "durationMs": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Track duration in milliseconds when available."
                            },
                            "trackNumber": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "exclusiveMinimum": true,
                              "description": "Track number on the album when available."
                            },
                            "explicit": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether the track is marked explicit when available."
                            },
                            "artistName": {
                              "type": "string",
                              "nullable": true,
                              "description": "Primary artist display name when available."
                            },
                            "albumTitle": {
                              "type": "string",
                              "nullable": true,
                              "description": "Album title when available."
                            },
                            "artworkUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Best available square artwork image URL when available."
                            },
                            "previewUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Short audio preview URL when available."
                            },
                            "trackUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Canonical public Apple Music song URL when available."
                            }
                          },
                          "required": [
                            "platform",
                            "trackId",
                            "title",
                            "durationMs",
                            "trackNumber",
                            "explicit",
                            "artistName",
                            "albumTitle",
                            "artworkUrl",
                            "previewUrl",
                            "trackUrl"
                          ],
                          "description": "Track details when available."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "track"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v1"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata describing the request and billing outcome."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "description": "Standard success response envelope."
                },
