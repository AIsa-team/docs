  "paths": {
    "/delete_twitter": {
      "post": {
        "summary": "Delete an authorized account tweet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "aisa_api_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "AIsa API key bound to the OAuth account; the wrapper requires this body field in addition to gateway authorization."
                  },
                  "tweet_id": {
                    "type": "string",
                    "x-aisa-normalized-schema": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "description": "The service strips surrounding whitespace first; the result must contain 1 to 64 characters. Length limits apply after normalization, not to the raw input.",
                    "x-aisa-normalization": "strip"
                  }
                },
                "required": [
                  "aisa_api_key",
                  "tweet_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ApiResponse returned by the owning service; result data is not inferred."
          }
        }
      }
    }
