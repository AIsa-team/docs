  "paths": {
    "/apis/v1/socialfetch/v2/instagram/hashtags/{hashtag}": {
      "get": {
        "responses": {
          "200": {
            "description": "The hashtag.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "`found`, or `not_found` when nobody has used the hashtag (Instagram has no posts under it)."
                        },
                        "hashtag": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "string",
                              "nullable": true,
                              "pattern": "^\\d+$",
                              "description": "Hashtag id."
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Tag name, without #."
                            },
                            "mediaCount": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Posts using the tag. Null when Instagram doesn't report a real count."
                            },
                            "isTrending": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether Instagram marks it trending."
                            },
                            "isRestricted": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether Instagram restricts the tag, so its feed is empty (for example a tag it hides as sensitive). Null when this view doesn't say."
                            },
                            "url": {
                              "type": "string",
                              "format": "uri",
                              "description": "Public tag page URL."
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "mediaCount",
                            "isTrending",
                            "isRestricted",
                            "url"
                          ],
                          "description": "The hashtag. Null when not found."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "hashtag"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "examples": {
                  "found": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "hashtag": {
                          "id": "17841562438105667",
                          "name": "coffee",
                          "mediaCount": 185434115,
                          "isTrending": true,
                          "isRestricted": false,
                          "url": "https://www.instagram.com/explore/tags/coffee/"
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_hashtag_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "not_found": {
                    "value": {
                      "data": {
                        "lookupStatus": "not_found",
                        "hashtag": null
                      },
                      "meta": {
                        "requestId": "req_01example_hashtag_v2_not_found",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Hashtag name, with or without `#`, or its instagram.com tag link."
            },
            "required": true,
            "description": "Hashtag name, with or without `#`, or its instagram.com tag link.",
            "name": "hashtag",
            "in": "path"
          }
        ]
      }
    }
  },
