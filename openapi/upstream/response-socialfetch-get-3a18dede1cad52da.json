                          "description": "Whether member data was returned for this community."
                        },
                        "members": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Numeric X user id as a string."
                              },
                              "handle": {
                                "type": "string",
                                "description": "X screen name (handle) without the leading @."
                              },
                              "displayName": {
                                "type": "string",
                                "nullable": true,
                                "description": "Display name shown on the profile."
                              },
                              "description": {
                                "type": "string",
                                "nullable": true,
                                "description": "Profile biography text."
                              },
                              "avatarUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Best available square avatar image URL."
                              },
                              "bannerUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Profile banner image URL when available."
                              },
                              "location": {
                                "type": "string",
                                "nullable": true,
                                "description": "Location string from the profile when provided."
                              },
                              "website": {
                                "type": "string",
                                "nullable": true,
                                "description": "Primary outbound link (expanded URL) from the profile."
                              },
                              "verified": {
                                "type": "boolean",
                                "description": "Whether X marks the profile with legacy verification (not necessarily paid blue)."
                              },
                              "isBlueVerified": {
                                "type": "boolean",
                                "description": "Whether the account has X blue (paid) verification."
                              },
                              "isProtected": {
                                "type": "boolean",
                                "description": "Whether the account is protected (private)."
                              },
                              "followerCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Follower count from X when available."
                              },
                              "followingCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Following (friends) count from X when available."
                              },
                              "tweetCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Total post (status) count from X when available."
                              },
                              "listedCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Listed count when X provides it."
                              },
                              "createdAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time",
                                "description": "Account creation time (ISO-8601) when derivable."
                              },
                              "profileUrl": {
                                "type": "string",
                                "description": "Canonical public profile URL on x.com (`https://x.com/<handle>`)."
                              },
                              "profileImageShape": {
                                "type": "string",
                                "nullable": true,
                                "description": "Avatar crop shape reported by X, such as Circle or Square."
                              },
                              "verifiedType": {
                                "type": "string",
                                "nullable": true,
                                "description": "X verification type label when provided (for example a government or organization note)."
                              },
                              "pinnedTweetIds": {
                                "type": "array",
                                "nullable": true,
                                "items": {
                                  "type": "string"
                                },
                                "description": "Pinned tweet ids from X, in display order."
                              },
                              "professional": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Professional account type from X, when present."
                                  },
                                  "category": {
                                    "type": "array",
                                    "nullable": true,
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": {
                                          "type": "integer",
                                          "nullable": true,
                                          "description": "X's numeric id for the category."
                                        },
                                        "name": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "Category name shown on the profile, such as `Science & Technology`."
                                        },
                                        "icon_name": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "X's icon name for the category, such as `IconBriefcaseStroke`."
                                        }
                                      },
                                      "required": [
                                        "id",
                                        "name",
                                        "icon_name"
                                      ],
                                      "description": "A professional category X shows on the profile."
                                    },
                                    "description": "Professional categories X shows on the profile."
                                  },
                                  "restId": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Professional account rest id from X, when present."
                                  }
                                },
                                "required": [
                                  "type",
                                  "category",
                                  "restId"
                                ],
                                "description": "X professional-account metadata when the account is marked professional."
                              },
                              "withheldInCountries": {
                                "type": "array",
                                "nullable": true,
                                "items": {
                                  "type": "string"
                                },
                                "description": "Country codes where the profile is withheld."
                              },
                              "favoritesCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Total likes (favorites) on the profile when available."
                              },
                              "mediaCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Media item count when X provides it."
                              },
                              "affiliateLabel": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "description": {
                                    "type": "string",
                                    "description": "Affiliate or business label text shown on the profile."
                                  },
                                  "badgeUrl": {
                                    "type": "string",
                                    "description": "Badge image URL when X provides one."
                                  },
                                  "url": {
                                    "type": "string",
                                    "description": "Destination URL for the label link."
                                  },
                                  "type": {
                                    "type": "string",
                                    "description": "X label type, such as `BusinessLabel` for an affiliation or `AutomatedLabel` for a bot account."
                                  },
                                  "longDescription": {
                                    "type": "string",
                                    "description": "Longer label text when X provides one, such as `Automated by @owner`."
                                  }
                                },
                                "required": [
                                  "description"
                                ],
                                "description": "Affiliation or automated-account label shown next to the name, when X provides one."
                              },
                              "role": {
                                "type": "string",
                                "enum": [
                                  "member",
                                  "moderator",
                                  "admin",
                                  "unknown"
                                ],
                                "description": "Community role reported by X. `unknown` when the role is missing or unrecognized."
                              },
                              "joinedAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time",
                                "description": "When the user joined the community (ISO-8601), when available."
