  "paths": {
    "/apis/v1/tiktok/videos": {
      "get": {
        "responses": {
          "200": {
            "description": "Video metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
