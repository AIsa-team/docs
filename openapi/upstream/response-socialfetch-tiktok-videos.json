                              },
                              "originalUrl": {
                                "type": "string",
                                "description": "The platform's own URL for the file. It can expire. When it isn't known, this is the same link as `cdnUrl`."
                              },
                              "cdnUrl": {
                                "type": "string",
                                "description": "Link to the downloaded file, always on a Social Fetch domain. Normally it's on our media CDN and works until the file's retention ends (90 days). For zero-retention workspaces we keep no copy: the link goes through the API, streams the file, and works for 24 hours. Save the file if you need it longer."
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "video",
                                  "image"
                                ],
                                "description": "Asset type."
                              }
                            },
                            "required": [
                              "originalUrl",
                              "cdnUrl",
                              "type"
                            ],
                            "description": "A hosted media asset."
                          },
                          "description": "Populated only when `downloadMedia=true` was passed and media was available."
                        },
                        "details": {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": {
                            "nullable": true
                          },
                          "description": "Additional TikTok-native fields from the post (author, music, video, etc.), minus keys already promoted above."
