  "paths": {
    "/apis/v1/socialfetch/v1/tiktok/ad-library/ads/search": {
      "get": {
        "responses": {
          "200": {
            "description": "TikTok Ad Library search results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "query": {
                          "type": "string",
                          "description": "Keyword query that was evaluated for this response."
                        },
                        "advertiserName": {
                          "type": "string",
                          "nullable": true,
                          "description": "Advertiser name filter that was evaluated, when searching by advertiser."
                        },
                        "resolvedAdvertiserName": {
                          "type": "string",
                          "nullable": true,
                          "description": "Advertiser TikTok resolved `advertiserName` to, when searching by advertiser and a match was found."
                        },
                        "advertiserMatches": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Advertiser name as TikTok lists it."
                              },
                              "businessId": {
                                "type": "string",
                                "minLength": 1,
                                "description": "TikTok advertiser business ID. Pass it as `advertiserBusinessId`, with this `name` as `advertiserName`, to search only this advertiser."
                              }
                            },
                            "required": [
                              "name",
                              "businessId"
                            ],
                            "description": "An advertiser TikTok matched to the requested advertiser name."
                          },
                          "description": "Advertisers TikTok matched to `advertiserName`. Empty for keyword searches or when none are reported."
                        },
                        "source": {
                          "type": "string",
                          "nullable": true,
                          "enum": [
                            "tiktok_ads_library",
                            "top_ads",
                            null
                          ],
                          "description": "Listing source when reported. `tiktok_ads_library` is the public Ads Library."
                        },
                        "ads": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Stable identifier for the ad."
                              },
                              "title": {
                                "type": "string",
                                "nullable": true,
                                "description": "Ad title or caption when available."
                              },
                              "brandName": {
                                "type": "string",
                                "nullable": true,
                                "description": "Brand or advertiser name when available."
                              },
                              "cost": {
                                "type": "number",
                                "nullable": true,
                                "description": "Relative cost signal when available."
                              },
                              "ctr": {
                                "type": "number",
                                "nullable": true,
                                "description": "Click-through rate when available."
                              },
                              "likeCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Like count when available."
                              },
                              "industryKey": {
                                "type": "string",
                                "nullable": true,
                                "description": "Industry key reported for the ad when available."
                              },
                              "objective": {
                                "type": "string",
                                "nullable": true,
                                "description": "Campaign objective key when available."
                              },
                              "url": {
                                "type": "string",
                                "nullable": true,
                                "description": "Public TikTok Ads Library detail URL when available."
                              },
                              "firstShownAt": {
                                "type": "string",
                                "nullable": true,
                                "description": "ISO-8601 timestamp for when the ad was first shown, when available."
                              },
                              "lastShownAt": {
                                "type": "string",
                                "nullable": true,
                                "description": "ISO-8601 timestamp for when the ad was last shown, when available."
                              },
                              "estimatedAudience": {
                                "type": "string",
                                "nullable": true,
                                "description": "Estimated audience band when available."
                              },
                              "video": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Video id when available."
                                  },
                                  "durationSeconds": {
                                    "type": "number",
                                    "nullable": true,
                                    "description": "Video duration in seconds when available. Null for results from the public TikTok Ads Library, which does not report duration."
                                  },
                                  "coverUrl": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Cover image URL when available."
                                  },
                                  "width": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Video width in pixels when available."
                                  },
                                  "height": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Video height in pixels when available."
                                  },
                                  "urls": {
                                    "type": "object",
                                    "nullable": true,
                                    "properties": {
                                      "p360": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "360p video URL when available."
                                      },
                                      "p480": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "480p video URL when available."
                                      },
                                      "p540": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "540p video URL when available."
                                      },
                                      "p720": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "720p video URL when available."
                                      },
                                      "p1080": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "1080p video URL when available."
                                      }
                                    },
                                    "required": [
                                      "p360",
                                      "p480",
                                      "p540",
                                      "p720",
                                      "p1080"
                                    ],
                                    "description": "Playback URLs by resolution when available."
                                  }
                                },
                                "required": [
                                  "id",
                                  "durationSeconds",
                                  "coverUrl",
                                  "width",
                                  "height",
                                  "urls"
                                ],
                                "description": "Video creative when available."
                              },
                              "advertiserBusinessId": {
                                "type": "string",
                                "nullable": true,
                                "description": "TikTok business ID of the ad's advertiser when available. Pass it as `advertiserBusinessId` with `advertiserName` to search only that advertiser."
                              },
                              "format": {
                                "type": "string",
                                "nullable": true,
                                "enum": [
                                  "video",
                                  "images",
                                  null
                                ],
                                "description": "Creative format: `video` for video ads, `images` for photo or carousel ads. Null when no creative is reported."
                              },
                              "videos": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Video id when available."
                                    },
                                    "durationSeconds": {
                                      "type": "number",
                                      "nullable": true,
                                      "description": "Video duration in seconds when available. Null for results from the public TikTok Ads Library, which does not report duration."
                                    },
                                    "coverUrl": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Cover image URL when available."
                                    },
                                    "width": {
                                      "type": "integer",
                                      "nullable": true,
                                      "minimum": 0,
                                      "description": "Video width in pixels when available."
                                    },
                                    "height": {
                                      "type": "integer",
                                      "nullable": true,
                                      "minimum": 0,
                                      "description": "Video height in pixels when available."
                                    },
                                    "urls": {
                                      "type": "object",
                                      "nullable": true,
                                      "properties": {
                                        "p360": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "360p video URL when available."
                                        },
                                        "p480": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "480p video URL when available."
                                        },
                                        "p540": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "540p video URL when available."
                                        },
                                        "p720": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "720p video URL when available."
                                        },
                                        "p1080": {
                                          "type": "string",
                                          "nullable": true,
                                          "description": "1080p video URL when available."
                                        }
                                      },
                                      "required": [
                                        "p360",
                                        "p480",
                                        "p540",
                                        "p720",
                                        "p1080"
                                      ],
                                      "description": "Playback URLs by resolution when available."
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "durationSeconds",
                                    "coverUrl",
                                    "width",
                                    "height",
                                    "urls"
                                  ],
                                  "description": "Video creative for a TikTok Ad Library ad."
                                },
                                "description": "Every video creative reported for the ad. `video` is the first entry. Empty for image ads."
                              },
                              "imageUrls": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "description": "Image URLs for photo or carousel ads, in display order. Empty for video ads."
                              },
                              "category": {
                                "type": "string",
                                "nullable": true,
                                "description": "Ad category as TikTok labels it, such as `News & Entertainment`, when available."
                              },
                              "moderation": {
                                "type": "object",
                                "properties": {
                                  "auditStatus": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Review status code exactly as TikTok reports it, such as `1`. TikTok does not document these codes. Null when not reported."
                                  },
                                  "rejectionReason": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Rejection details as TikTok reports them, when the ad was rejected. Null otherwise."
                                  }
                                },
                                "required": [
                                  "auditStatus",
                                  "rejectionReason"
                                ],
                                "description": "TikTok's review information for the ad."
                              }
                            },
                            "required": [
                              "id",
                              "title",
                              "brandName",
                              "cost",
                              "ctr",
                              "likeCount",
                              "industryKey",
                              "objective",
                              "url",
                              "firstShownAt",
                              "lastShownAt",
                              "estimatedAudience",
                              "video",
                              "advertiserBusinessId",
                              "format",
                              "videos",
                              "imageUrls",
                              "category",
                              "moderation"
                            ],
                            "description": "A TikTok Ad Library ad returned by search."
                          },
                          "description": "Ads returned for the requested search. This array may be empty when no ads match."
