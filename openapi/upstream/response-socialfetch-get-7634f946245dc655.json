                            "url": "https://ensembledata.com",
                            "content": "With our social media scraping APIs, you can fetch user profiles, posts, comments, replies, engagement metrics (likes, views, shares), hashtags, keywords, and brand mentions."
                          }
                        ],
                        "page": {
                          "page": 1,
                          "hasMore": true,
                          "nextPage": 2
                        }
                      },
                      "meta": {
                        "requestId": "req_01example",
                        "creditsCharged": 1,
