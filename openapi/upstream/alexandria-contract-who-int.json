  "paths": {
    "/apis/v1/who-int/indicators/data": {
      "post": {
        "operationId": "who-int.indicators.data",
        "summary": "Data",
        "description": "Fetch one page of observations for a GHO indicator, filtered by spatial type (COUNTRY, REGION, WORLDBANKINCOMEGROUP, GLOBAL), ISO3/region codes, year range and Dim1/Dim2/Dim3 codes (sex, age group, ...). Each record keeps the source Id, numeric value with low/high bounds as decimal strings, the display string, comments, data source and modification date; source_updated_at is the indicator's newest modification date. Unknown indicator codes fail with not_found.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "cursor": {
                    "type": "string",
                    "description": "next_cursor from the previous page of the same filters and page_size.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "dim1": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Dim1 value codes, e.g. SEX_FMLE or AGEGROUP_YEARS0-4.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "dim2": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "dim2",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "dim3": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "dim3",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "indicator_code": {
                    "type": "string",
                    "description": "GHO indicator code, e.g. WHOSIS_000001 (life expectancy at birth) or MDG_0000000001 (infant mortality rate). Pattern: ^[A-Za-z0-9_.+-]{1,64}$.",
                    "x-alexandria-option-metadata": {
                      "required": true,
                      "in": "body"
                    }
                  },
                  "page_size": {
                    "type": "number",
                    "description": "Rows per page; the GHO server caps $top at 1000.\n\nProvider reference: minimum 1; maximum 1000; default 100.",
                    "default": 100,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 1000
                    }
                  },
                  "spatial_dim_type": {
                    "type": "string",
                    "description": "Restrict to one spatial level. Omit for all levels; spatial_dim_type on each record says which.\n\nProvider reference: allowed values [\"COUNTRY\", \"REGION\", \"WORLDBANKINCOMEGROUP\", \"GLOBAL\", \"null\"].",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "oneOf": [
                        "COUNTRY",
                        "REGION",
                        "WORLDBANKINCOMEGROUP",
                        "GLOBAL",
                        "null"
                      ]
                    }
                  },
                  "spatial_dims": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "ISO3 country codes (BRA), WHO region codes (AFR), income-group codes (WB_HI) or GLOBAL.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "time_from": {
                    "type": "number",
                    "description": "Inclusive first year (TimeDim ge).\n\nProvider reference: minimum 1000; maximum 9999.",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1000,
                      "max": 9999
                    }
                  },
                  "time_to": {
                    "type": "number",
                    "description": "Inclusive last year (TimeDim le).\n\nProvider reference: minimum 1000; maximum 9999.",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1000,
                      "max": 9999
                    }
                  }
                },
                "required": [
                  "indicator_code"
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "indicator_code": "WHOSIS_000001",
                    "page_size": 5,
                    "spatial_dims": [
                      "BRA"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fetch one page of observations for a GHO indicator, filtered by spatial type (COUNTRY, REGION, WORLDBANKINCOMEGROUP, GLOBAL), ISO3/region codes, year range and Dim1/Dim2/Dim3 codes (sex, age group, ...). Each record keeps the source Id, numeric value with low/high bounds as decimal strings, the display string, comments, data source and modification date; source_updated_at is the indicator's newest modification date. Unknown indicator codes fail with not_found.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `complete` | boolean |  |\n| `indicator` | object |  |\n| `license` | object | Source-defined WHO metadata. |\n| `next_cursor` | string |  |\n| `odata_filter` | string | The exact $filter sent upstream. |\n| `page` | object | Source-defined WHO metadata. |\n| `records` | object[] |  |\n| `retrieved_at` | string |  |\n| `schema_version` | string |  |\n| `source_updated_at` | string | Newest Date across the whole indicator, RFC 3339 UTC; null if that lookup failed (then complete=false). |\n| `source_url` | string |  |\n| `total_count` | number | @odata.count of rows matching the filter. |\n| `upstream_requests` | number |  |\n| `warnings` | string[] |  |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
