                            "profileUrl": "https://github.com/sonichi",
                            "avatarUrl": "https://avatars.githubusercontent.com/u/4250911?s=96&v=4",
                            "popularRepository": {
                              "owner": "sonichi",
                              "repo": "sutando",
                              "fullName": "sonichi/sutando",
                              "url": "https://github.com/sonichi/sutando",
                              "name": "sutando",
                              "description": "My AI Stand. Realtime by day, rewriting itself by night. Summon my AI superpower."
                            }
                          }
                        ],
                        "totalResults": 2
                      },
                      "meta": {
                        "requestId": "req_01example_github_trending_developers",
