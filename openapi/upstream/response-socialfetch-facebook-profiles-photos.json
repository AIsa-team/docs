                                    },
                                    "width": {
                                      "type": "integer",
                                      "nullable": true,
                                      "minimum": 0,
                                      "exclusiveMinimum": true,
                                      "description": "Pixel width when known."
                                    },
                                    "height": {
                                      "type": "integer",
                                      "nullable": true,
                                      "minimum": 0,
                                      "exclusiveMinimum": true,
                                      "description": "Pixel height when known."
                                    },
                                    "entityId": {
                                      "type": "string",
                                      "minLength": 1,
                                      "description": "Opaque parent entity id for this asset (post, reel, photo, or video id)."
                                    },
                                    "postId": {
                                      "type": "string",
                                      "minLength": 1,
