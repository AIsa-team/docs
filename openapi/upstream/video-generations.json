{
  "openapi": "3.1.0",
  "info": {
    "title": "Video Generation",
    "version": "1.0.0",
    "description": "Asynchronous `POST /v1/video/generations`. The gateway requires `model`; the remaining fields are the selected model's own request fields and are forwarded to it. Poll `GET /v1/video/generations/{task_id}` with the returned id.",
    "x-aisa-source": {
      "kind": "manual",
      "url": "https://github.com/AIsa-team/AIsaServices/blob/c03a076b24caee6fed1665fede5f72fa1f7b6700/services/api-service/internal/httpapi/api_contract_media.go",
      "fetched_at": "2026-10-30T20:00:00+08:00",
      "content_hash": "sha256:989befbd5e6a4c0106a71aa7064db1749cef3232f0396b1ab715623d87943f0e",
      "converter": "manual:aisaservices-video-handler-contract@1",
      "path_space": "public",
      "owner": "AIsa-team/docs",
      "refresh_policy": "manual",
      "review_period_days": 30,
      "policy_revision": "sha256:39ef87da0423db20b45d0ea4cc09a0b2c1aac7c3710f536685de2165cef00bf0"
    }
  },
  "servers": [
    {
      "url": "https://api.aisa.one/v1"
    }
  ],
  "paths": {
    "/video/generations": {
      "post": {
        "operationId": "createVideoGeneration",
        "summary": "Create a video generation task",
        "description": "Starts an asynchronous video generation task. A video usually takes one to three minutes; poll the task with the returned id until its status is completed, failed or cancelled.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A video model from GET /v1/models, for example dreamina-seedance-2-0-260128 or wan2.7-t2v."
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Text prompt, for models that take a plain prompt."
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "additionalProperties": true,
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "text, image_url or video_url."
                        },
                        "text": {
                          "type": "string"
                        },
                        "image_url": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          }
                        },
                        "video_url": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          }
                        },
                        "role": {
                          "type": "string",
                          "description": "For images: first_frame, last_frame or reference_image; for videos: reference_video."
                        }
                      }
                    },
                    "description": "Prompt and reference media, for Seedance models."
                  },
                  "duration": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Output length in seconds; part of the price."
                  },
                  "resolution": {
                    "type": "string",
                    "description": "For example 720p or 1080p; part of the price."
                  },
                  "ratio": {
                    "type": "string",
                    "description": "Aspect ratio, for example 16:9, 9:16 or 1:1."
                  },
                  "generate_audio": {
                    "type": "boolean"
                  },
                  "watermark": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "model": "dreamina-seedance-2-0-260128",
                "content": [
                  {
                    "type": "text",
                    "text": "A small red boat on a calm lake at dawn"
                  }
                ],
                "ratio": "16:9",
                "duration": 5,
                "generate_audio": true,
                "watermark": false
              }
            }
          }
        }
      }
    }
  }
}
