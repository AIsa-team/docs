                        "tools": {
                          "type": "array",
                          "description": "Tool contracts discovered from the Alexandria catalogue. Present when `alexandria` is among the sources or when `domainTools` was requested; up to `limit` results per discovery source (semantic matches from the `alexandria` source, domain matches from `domainTools`).",
                          "items": {
                            "$ref": "#/components/schemas/DiscoveredTool"
                          }
                        }
                      },
                      "description": "The search results. The arrays available will depend on the sources you specified in the request. By default, the `web` array will be returned."
