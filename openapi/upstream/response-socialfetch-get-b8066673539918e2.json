  "paths": {
    "/apis/v1/socialfetch/v2/instagram/media/{media}/transcript": {
      "get": {
        "responses": {
          "200": {
            "description": "Instagram media transcript.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "`found` when the video was transcribed (even with no speech), or `not_found` when the post doesn't exist, is private, or has no video."
                        },
                        "transcript": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "language": {
                              "type": "string",
                              "nullable": true,
                              "description": "Language code, such as en."
                            },
                            "text": {
                              "type": "string",
                              "nullable": true,
                              "description": "Full transcript text. Null when none."
                            },
                            "segments": {
                              "type": "array",
                              "nullable": true,
                              "items": {
                                "type": "object",
                                "properties": {
                                  "start": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Start, in seconds."
                                  },
                                  "end": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "End, in seconds."
                                  },
                                  "text": {
                                    "type": "string",
                                    "description": "Spoken text."
                                  }
                                },
                                "required": [
                                  "start",
                                  "end",
                                  "text"
                                ],
                                "description": "A timed part of a transcript."
                              },
                              "description": "Timed parts. Null when timings aren't available."
                            },
                            "durationSec": {
                              "type": "number",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Length of the transcribed video, in seconds. Null when not reported."
                            }
                          },
                          "required": [
                            "language",
                            "text",
                            "segments",
                            "durationSec"
                          ],
                          "description": "What is said in the video. `text` is null when the video has no speech. Null when `lookupStatus` is `not_found`."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "transcript"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "examples": {
                  "found": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "transcript": {
                          "language": null,
                          "text": "I see the trolls. I hear the chatter. What? Y'all had a lot to say about the first four. I heard it all. I have to be serious. I get it. Every year y'all find a new reason it shouldn't be me. But it is me, whoops. Five to be exact. Whoops again. So keep talking, but if I'm always on your mind, just say you a fan.",
                          "segments": null,
                          "durationSec": 30.114
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_media_transcript_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "noSpeech": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "transcript": {
                          "language": null,
                          "text": null,
                          "segments": null,
                          "durationSec": null
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_media_transcript_v2_no_speech",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "notFound": {
                    "value": {
                      "data": {
                        "lookupStatus": "not_found",
                        "transcript": null
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_media_transcript_v2_not_found",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Shortcode, post or Reel URL, or numeric media id."
            },
            "required": true,
            "description": "Shortcode, post or Reel URL, or numeric media id.",
            "name": "media",
            "in": "path"
          }
        ]
      }
    }
  },
