  "paths": {
    "/apis/v1/socialfetch/v1/soundcloud/profiles/{handle}": {
      "get": {
        "responses": {
          "200": {
            "description": "SoundCloud profile lookup result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "Whether the profile was found."
                        },
                        "profile": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "platform": {
                              "type": "string",
                              "enum": [
                                "soundcloud"
                              ],
                              "description": "Social platform for this profile."
                            },
                            "handle": {
                              "type": "string",
                              "minLength": 1,
                              "description": "SoundCloud handle without the leading @."
                            },
                            "platformUserId": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Stable SoundCloud user id as a string."
                            },
                            "displayName": {
                              "type": "string",
                              "nullable": true,
                              "description": "Public display name shown on the profile."
                            },
                            "bio": {
                              "type": "string",
                              "nullable": true,
                              "description": "Profile biography text."
                            },
                            "avatarUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Best available avatar image URL for the profile."
                            },
                            "bannerUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Profile banner image URL when available."
                            },
                            "profileUrl": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Canonical public SoundCloud profile URL."
                            },
                            "verified": {
                              "type": "boolean",
                              "description": "Whether the profile is marked as verified."
                            },
                            "city": {
                              "type": "string",
                              "nullable": true,
                              "description": "City listed on the profile."
                            },
                            "countryCode": {
                              "type": "string",
                              "nullable": true,
                              "description": "Country code listed on the profile."
                            },
                            "createdAt": {
                              "type": "string",
                              "nullable": true,
                              "description": "ISO-8601 timestamp when the profile was created."
                            }
                          },
                          "required": [
                            "platform",
                            "handle",
                            "platformUserId",
                            "displayName",
                            "bio",
                            "avatarUrl",
                            "bannerUrl",
                            "profileUrl",
                            "verified",
                            "city",
                            "countryCode",
                            "createdAt"
                          ],
                          "description": "Profile details when available."
                        },
                        "metrics": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "followers": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Follower count for the profile when available."
                            },
                            "following": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Following count for the profile when available."
                            },
                            "tracks": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Number of public tracks on the profile when available."
                            },
                            "playlists": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Number of public playlists on the profile when available."
                            },
                            "likes": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Number of tracks the profile has liked when available."
                            },
                            "comments": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Number of comments the profile has left when available."
                            },
                            "reposts": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Number of reposts on the profile when available."
                            }
                          },
                          "required": [
                            "followers",
                            "following",
                            "tracks",
                            "playlists",
                            "likes",
                            "comments",
                            "reposts"
                          ],
                          "description": "Profile metrics when available."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "profile",
                        "metrics"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v1"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata describing the request and billing outcome."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "description": "Standard success response envelope."
                },
                "examples": {
                  "found": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "profile": {
                          "platform": "soundcloud",
                          "handle": "kehlanimusic",
                          "platformUserId": "51562330",
                          "displayName": "Kehlani",
                          "bio": "\"Folded\" out now!\n\nSinger/Songwriter \nOakland to Los Angeles\n\nMGMT:\ndavid@abvgrnd.com\ninfo@thetsunamimob.com\n\nBOOKING:\nCaroline Yim\ncaroline.yim@caa.com",
                          "avatarUrl": "https://i1.sndcdn.com/avatars-4pU1zic9ZyyDdF4G-dF6LHA-large.jpg",
                          "bannerUrl": "https://i1.sndcdn.com/visuals-000051562330-BFF9AP-original.jpg",
                          "profileUrl": "https://soundcloud.com/kehlanimusic",
                          "verified": true,
                          "city": "Oakland, CA",
                          "countryCode": "US",
                          "createdAt": null
                        },
                        "metrics": {
                          "followers": 846352,
                          "following": 0,
                          "tracks": 341,
                          "playlists": 27,
                          "likes": 11,
                          "comments": 0,
                          "reposts": null
                        }
                      },
                      "meta": {
                        "requestId": "req_01example",
                        "creditsCharged": 1,
                        "version": "v1"
                      }
                    }
                  },
                  "not_found": {
                    "value": {
                      "data": {
                        "lookupStatus": "not_found",
                        "profile": null,
                        "metrics": null
                      },
                      "meta": {
                        "requestId": "req_01example_nf",
                        "creditsCharged": 1,
                        "version": "v1"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "SoundCloud handle to look up, with or without a leading @."
            },
            "required": true,
            "description": "SoundCloud handle to look up, with or without a leading @.",
            "name": "handle",
            "in": "path"
          }
        ]
      }
    }
