                          "bio": "\u0e2b\u0e22\u0e01\u0e23\u0e35\u0e27\u0e34\u0e27\u0e17\u0e39\u0e49\u0e01\u0e01\u0e01\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e07\u0e07\ud83e\udd70"
                        },
