  "paths": {
    "/apis/v1/socialfetch/v2/instagram/locations/{locationId}": {
      "get": {
        "responses": {
          "200": {
            "description": "Instagram location.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "`found`, or `not_found` when the location id doesn't exist."
                        },
                        "location": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^\\d+$",
                              "description": "Location id."
                            },
                            "name": {
                              "type": "string",
                              "nullable": true,
                              "description": "Place name."
                            },
                            "lat": {
                              "type": "number",
                              "nullable": true,
                              "description": "Latitude."
                            },
                            "lng": {
                              "type": "number",
                              "nullable": true,
                              "description": "Longitude."
                            },
                            "category": {
                              "type": "string",
                              "nullable": true,
                              "description": "Place category."
                            },
                            "address": {
                              "type": "string",
                              "nullable": true,
                              "description": "Street address. Often null."
                            },
                            "city": {
                              "type": "string",
                              "nullable": true,
                              "description": "City. Often null."
                            },
                            "description": {
                              "type": "string",
                              "nullable": true,
                              "description": "Short description of the place. Null when none is shown."
                            },
                            "imageUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Picture of the place. Null when none is shown. Instagram CDN URL; it expires after a while."
                            },
                            "facebookPlacesId": {
                              "type": "string",
                              "nullable": true,
                              "pattern": "^\\d+$",
                              "description": "Facebook Places id of the same place. Null when none is linked."
                            },
                            "url": {
                              "type": "string",
                              "format": "uri",
                              "description": "Public location page URL."
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "lat",
                            "lng",
                            "category",
                            "address",
                            "city",
                            "description",
                            "imageUrl",
                            "facebookPlacesId",
                            "url"
                          ],
                          "description": "The place. Null when not found."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "location"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "examples": {
                  "landmark": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "location": {
                          "id": "384695225271379",
                          "name": "Times Square",
                          "lat": 40.757661950891,
                          "lng": -73.985295709611,
                          "category": "Landmark & Historical Place",
                          "address": null,
                          "city": null,
                          "description": "Times Square is a major commercial intersection, tourist destination, entertainment hub, and neighborhood in the Midtown Manhattan section of New York City. It is formed by the junction of Broadway, Seventh Avenue, and 42nd Street. Together with adjacent Duffy Square, Times Square is a bowtie-shaped plaza five blocks long between 42nd and 47th Streets.",
                          "imageUrl": null,
                          "facebookPlacesId": "384695225271379",
                          "url": "https://www.instagram.com/explore/locations/384695225271379/"
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_location_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "venue": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "location": {
                          "id": "3001476",
                          "name": "Caf\u00e9 Du Monde",
                          "lat": 29.957398554945,
                          "lng": -90.061970094506,
                          "category": "Cafe",
                          "address": null,
                          "city": null,
                          "description": "Original Cafe Au Lait and Beignets",
                          "imageUrl": "https://scontent.cdninstagram.com/v/t51.2885-15/16bd4c40adf2.jpg?stp=example",
                          "facebookPlacesId": "130205706997542",
                          "url": "https://www.instagram.com/explore/locations/3001476/"
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_location_v2_venue",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "not_found": {
                    "value": {
                      "data": {
                        "lookupStatus": "not_found",
                        "location": null
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_location_v2_missing",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Location id (digits) or its instagram.com location URL."
            },
            "required": true,
            "description": "Location id (digits) or its instagram.com location URL.",
            "name": "locationId",
            "in": "path"
          }
        ]
      }
    }
  },
