  "paths": {
    "/apis/v1/socialfetch/v1/github/profiles/{handle}": {
      "get": {
        "responses": {
          "200": {
            "description": "GitHub profile lookup result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
