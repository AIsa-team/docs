  "paths": {
    "/apis/v1/socialfetch/v1/yelp/businesses/search": {
      "get": {
        "responses": {
          "200": {
            "description": "Yelp business pages found for this query and location.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "query": {
                          "type": "string"
                        },
                        "location": {
                          "type": "string"
                        },
                        "sort": {
                          "type": "string",
                          "enum": [
                            "recommended",
                            "highest_rated",
                            "most_reviewed"
                          ],
                          "description": "Result order. `recommended` is Yelp's default ranking. `highest_rated` and `most_reviewed` use Yelp's own sorts."
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "yelp",
                            "web_index"
                          ],
                          "description": "`yelp`: Yelp's own search results with verified listing data. `web_index`: fallback from a web search index when Yelp search is unavailable; fields it cannot see are null."
                        },
                        "totalResults": {
                          "type": "integer",
                          "nullable": true,
                          "minimum": 0,
                          "description": "Total results Yelp reports for this search (Yelp shows at most 240); null for web-index results."
                        },
                        "resolvedLocation": {
                          "type": "string",
                          "nullable": true,
                          "description": "Where Yelp actually searched, as Yelp describes it (e.g. `Austin, Texas`). Check it for ambiguous place names: a bare `Glasgow` can resolve to Glasgow, Delaware; add the country to disambiguate. Null for web-index results."
                        },
                        "businesses": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "alias": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 200,
                                "description": "Business alias from its Yelp URL."
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "url": {
                                "type": "string",
                                "format": "uri"
                              },
                              "ranking": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 1,
                                "description": "Position in Yelp's results for this search; null for web-index results."
                              },
                              "rating": {
                                "type": "number",
                                "nullable": true,
                                "minimum": 0,
                                "maximum": 5
                              },
                              "reviewCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0
                              },
                              "priceRange": {
                                "type": "string",
                                "nullable": true
                              },
                              "phone": {
                                "type": "string",
                                "nullable": true
                              },
                              "categories": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "alias": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "title": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "alias",
                                    "title"
                                  ]
                                }
                              },
                              "address": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "line1": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "line2": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "city": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "region": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "postalCode": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "country": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "formatted": {
                                    "type": "string",
                                    "nullable": true
                                  }
                                },
                                "required": [
                                  "line1",
                                  "line2",
                                  "city",
                                  "region",
                                  "postalCode",
                                  "country",
                                  "formatted"
                                ]
                              },
                              "coordinates": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "latitude": {
                                    "type": "number"
                                  },
                                  "longitude": {
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "latitude",
                                  "longitude"
                                ]
                              },
                              "photoUrl": {
                                "type": "string",
                                "nullable": true,
                                "format": "uri"
                              },
                              "isClosed": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "True when the listing is marked closed; null when not reported."
                              }
                            },
                            "required": [
                              "alias",
                              "name",
                              "url",
                              "ranking",
                              "rating",
                              "reviewCount",
                              "priceRange",
                              "phone",
                              "categories",
                              "address",
                              "coordinates",
                              "photoUrl",
                              "isClosed"
                            ]
                          }
                        },
                        "page": {
                          "type": "object",
                          "properties": {
                            "page": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "hasMore": {
                              "type": "boolean"
                            },
                            "nextPage": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 2
                            }
                          },
                          "required": [
                            "page",
                            "hasMore",
                            "nextPage"
                          ]
                        }
                      },
                      "required": [
                        "query",
                        "location",
                        "sort",
                        "source",
                        "totalResults",
                        "resolvedLocation",
                        "businesses",
                        "page"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v1"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata describing the request and billing outcome."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "description": "Standard success response envelope."
                }
              }
            }
          }
        }
      }
    }
  },
