  "paths": {
    "/apis/v1/socialfetch/v2/instagram/locations/search": {
      "get": {
        "responses": {
          "200": {
            "description": "Places matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "locations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^\\d+$",
                                "description": "Location id."
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "description": "Place name."
                              },
                              "lat": {
                                "type": "number",
                                "nullable": true,
                                "description": "Latitude."
                              },
                              "lng": {
                                "type": "number",
                                "nullable": true,
                                "description": "Longitude."
                              },
                              "category": {
                                "type": "string",
                                "nullable": true,
                                "description": "Place category."
                              },
                              "address": {
                                "type": "string",
                                "nullable": true,
                                "description": "Street address. Often null."
                              },
                              "city": {
                                "type": "string",
                                "nullable": true,
                                "description": "City. Often null."
                              },
                              "description": {
                                "type": "string",
                                "nullable": true,
                                "description": "Short description of the place. Null when none is shown."
                              },
                              "imageUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Picture of the place. Null when none is shown. Instagram CDN URL; it expires after a while."
                              },
                              "facebookPlacesId": {
                                "type": "string",
                                "nullable": true,
                                "pattern": "^\\d+$",
                                "description": "Facebook Places id of the same place. Null when none is linked."
                              },
                              "url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Public location page URL."
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "lat",
                              "lng",
                              "category",
                              "address",
                              "city",
                              "description",
                              "imageUrl",
                              "facebookPlacesId",
                              "url"
                            ],
                            "description": "A place."
                          },
                          "description": "Places matching the query, in Instagram's relevance order. Each `id` works with `GET /v2/instagram/locations/{locationId}` and its `/media`. Matching is fuzzy, so a query with no real match can still return loosely related places. One set per query: there is no next page."
                        }
                      },
                      "required": [
                        "locations"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
