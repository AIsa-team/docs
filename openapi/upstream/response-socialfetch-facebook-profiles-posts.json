                              },
                              "videoSdUrl": {
                                "type": "string",
                                "description": "Source-platform CDN URL for standard-definition video when available. It can expire or be rejected outside the original retrieval context; it is not a SocialFetch-hosted asset. For durable hosted copies on this list route, pass `hostMedia=true` (HD is preferred when both are present)."
                              },
                              "videoHdUrl": {
                                "type": "string",
                                "description": "Source-platform CDN URL for high-definition video when available. It can expire or be rejected outside the original retrieval context; it is not a SocialFetch-hosted asset. For durable hosted copies on this list route, pass `hostMedia=true`."
                              },
                              "videoThumbnailUrl": {
                                "type": "string",
