                            "asc": {
                              "type": [
                                "boolean",
                                "null"
                              ],
                              "description": "Orders the results by ascending or descending"
                            },
                            "sort": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Selects a specific metric to order results by"
                            }
