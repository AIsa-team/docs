                            },
                            "web_source": {
                              "type": "string",
                              "description": "The device/platform the traffic is coming from",
                              "enum": [
                                "desktop",
                                "mobile_web",
                                "total"
                              ]
                            },
                            "metrics": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "description": "Comma-separated list of metrics: clicks, paid_clicks, classic_organic_clicks, organic_serp_features_clicks, search_ads_clicks, pla_clicks, total_valid_serp_clicks, total_volume, zero_clicks_searches, difficulty, competition, ai_overview, cpc_low_bid, cpc_high_bid, transactional_intent_volume, informational_intent_volume, navigational_intent_volume, local_intent_volume, job_search_intent_volume",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "clicks",
                                  "paid_clicks",
                                  "classic_organic_clicks",
                                  "organic_serp_features_clicks",
                                  "search_ads_clicks",
                                  "pla_clicks",
                                  "total_valid_serp_clicks",
                                  "volume",
                                  "zero_clicks",
                                  "difficulty",
                                  "competition",
                                  "ai_overview",
                                  "cpc_low_bid",
                                  "cpc_high_bid",
                                  "transactional_intent_volume",
                                  "informational_intent_volume",
                                  "navigational_intent_volume",
                                  "local_intent_volume",
                                  "job_search_intent_volume"
                                ]
                              }
                            },
                            "is_keyword_group": {
                              "type": "boolean",
                              "description": "A boolean flag to specify if a keyword group is provided or a single keyword. Default is 'false'"
                            }
                          },
                          "required": [
                            "keyword"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "success",
                            "error"
                          ]
                        },
                        "error_code": {
                          "type": [
                            "integer",
                            "null"
                          ],
