  "paths": {
    "/apis/v1/socialfetch/v1/soundcloud/tracks": {
      "get": {
        "responses": {
          "200": {
            "description": "SoundCloud track lookup result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "Whether the track was found."
                        },
                        "track": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Stable SoundCloud track id as a string."
                            },
                            "title": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Track title."
                            },
                            "url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Canonical public SoundCloud URL for the track."
                            },
                            "permalink": {
                              "type": "string",
                              "nullable": true,
                              "description": "Track slug within the creator's profile when available."
                            },
                            "description": {
                              "type": "string",
                              "nullable": true,
                              "description": "Track description text when available."
                            },
                            "genre": {
                              "type": "string",
                              "nullable": true,
                              "description": "Genre label when available."
                            },
                            "tags": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "description": "Creator-supplied tags for the track (may be empty)."
                            },
                            "artworkUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Track artwork image URL when available."
                            },
                            "durationMs": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Full track duration in milliseconds when available."
                            },
                            "createdAt": {
                              "type": "string",
                              "nullable": true,
                              "description": "ISO-8601 timestamp when the track was uploaded."
                            },
                            "releaseDate": {
                              "type": "string",
                              "nullable": true,
                              "description": "ISO-8601 release date when available."
                            },
                            "labelName": {
                              "type": "string",
                              "nullable": true,
                              "description": "Record label credited on the track when available."
                            },
                            "license": {
                              "type": "string",
                              "nullable": true,
                              "description": "License the track is published under when available."
                            },
                            "isrc": {
                              "type": "string",
                              "nullable": true,
                              "description": "International Standard Recording Code when available."
                            },
                            "albumTitle": {
                              "type": "string",
                              "nullable": true,
                              "description": "Album or release the track belongs to when available."
                            },
                            "artistName": {
                              "type": "string",
                              "nullable": true,
                              "description": "Credited artist name from the release metadata."
                            },
                            "explicit": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether the release metadata marks the track as explicit."
                            },
                            "downloadable": {
                              "type": "boolean",
                              "description": "Whether the creator allows downloads for this track."
                            },
                            "artist": {
                              "type": "object",
                              "nullable": true,
                              "properties": {
                                "platform": {
                                  "type": "string",
                                  "enum": [
                                    "soundcloud"
                                  ],
                                  "description": "Social platform for this creator."
                                },
                                "platformUserId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Stable SoundCloud user id as a string."
                                },
                                "handle": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "SoundCloud handle without a leading @."
                                },
                                "displayName": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Public display name when available."
                                },
                                "avatarUrl": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Avatar image URL when available."
                                },
                                "profileUrl": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Canonical public SoundCloud profile URL."
                                },
                                "verified": {
                                  "type": "boolean",
                                  "description": "Whether the creator is marked as verified."
                                },
                                "followers": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "description": "Follower count for the creator when available."
                                }
                              },
                              "required": [
                                "platform",
                                "platformUserId",
                                "handle",
                                "displayName",
                                "avatarUrl",
                                "profileUrl",
                                "verified",
                                "followers"
                              ],
                              "description": "Creator who uploaded the track when available."
                            },
                            "metrics": {
                              "type": "object",
                              "properties": {
                                "plays": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "description": "Play count when available."
                                },
                                "likes": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "description": "Like count when available."
                                },
                                "reposts": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "description": "Repost count when available."
                                },
                                "comments": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "description": "Comment count when available."
                                },
                                "downloads": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "description": "Download count when available."
                                }
                              },
                              "required": [
                                "plays",
                                "likes",
                                "reposts",
                                "comments",
                                "downloads"
                              ],
                              "description": "Engagement metrics for the track."
                            }
                          },
                          "required": [
                            "id",
                            "title",
                            "url",
                            "permalink",
                            "description",
                            "genre",
                            "tags",
                            "artworkUrl",
                            "durationMs",
                            "createdAt",
                            "releaseDate",
                            "labelName",
                            "license",
                            "isrc",
                            "albumTitle",
                            "artistName",
                            "explicit",
                            "downloadable",
                            "artist",
                            "metrics"
                          ],
                          "description": "Track details when available."
                        }
