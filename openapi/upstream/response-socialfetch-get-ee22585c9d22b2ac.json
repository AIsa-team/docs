                                    "description": "YouTube channel id when available."
                                  },
                                  "verified": {
                                    "type": "boolean",
                                    "description": "Whether the commenter channel is verified."
                                  },
                                  "creator": {
                                    "type": "boolean",
                                    "description": "Whether the commenter is the video creator."
                                  },
                                  "avatarUrl": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Profile image URL for the commenter when available."
                                  },
                                  "channelUrl": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Channel page URL when available."
                                  }
                                },
                                "required": [
