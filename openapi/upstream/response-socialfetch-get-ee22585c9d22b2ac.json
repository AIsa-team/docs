                                "description": "Human-readable relative publish time when available."
                              },
                              "likeCount": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Like count on the comment."
                              },
                              "replyCount": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Direct reply count for the comment thread."
                              },
                              "repliesCursor": {
                                "type": "string",
                                "nullable": true,
                                "description": "Use as `cursor` on comment replies. Null when unavailable."
                              },
