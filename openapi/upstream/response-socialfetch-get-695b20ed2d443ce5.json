  "paths": {
    "/apis/v1/socialfetch/v2/instagram/audio/search": {
      "get": {
        "responses": {
          "200": {
            "description": "Audio matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "audio": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^\\d+$",
                                "description": "Audio id. The audio endpoints take it as `audioId`, and it matches `audio.id` on a Reel."
                              },
                              "assetId": {
                                "type": "string",
                                "nullable": true,
                                "pattern": "^\\d+$",
                                "description": "A second id Instagram gives some audio, set only when it differs from `id`. If `GET /v2/instagram/audio/{audioId}` answers not_found for an `id` from search, try `assetId`. Null when none."
                              },
                              "title": {
                                "type": "string",
                                "nullable": true,
                                "description": "Song or sound title."
                              },
                              "artist": {
                                "type": "string",
                                "nullable": true,
                                "description": "Artist name."
                              },
                              "artistHandle": {
                                "type": "string",
                                "nullable": true,
                                "description": "Username of the account behind the audio: the creator of original audio, or the artist's account for licensed music when Instagram links one. Null when none or not reported."
                              },
                              "durationMs": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Length in milliseconds."
                              },
                              "isOriginal": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether it is original audio rather than licensed music."
                              },
                              "isExplicit": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether it is marked explicit."
                              },
                              "reelCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Reels using it, as an exact count. Null when Instagram only gives a rounded figure (such as 2.5M)."
                              },
                              "isTrending": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether Instagram marks it trending."
                              },
                              "coverUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Cover art. Null for original audio. Instagram CDN URL; it expires after a while."
                              },
                              "previewUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Short audio clip of the track. Null for original audio and when Instagram gives none. Instagram CDN URL; it expires after a while."
                              },
                              "spotifyUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Spotify page of the track. Null for original audio and when Instagram links none."
                              },
                              "hasLyrics": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether Instagram has lyrics for the track. Null for original audio and when not reported."
                              }
                            },
                            "required": [
                              "id",
                              "assetId",
                              "title",
                              "artist",
                              "artistHandle",
                              "durationMs",
                              "isOriginal",
                              "isExplicit",
                              "reelCount",
                              "isTrending",
                              "coverUrl",
                              "previewUrl",
                              "spotifyUrl",
                              "hasLyrics"
                            ],
                            "description": "A song or original sound."
                          },
                          "description": "Audio matching the query, in Instagram's ranking. Licensed music and original sounds are mixed. Instagram returns one ranked set per query, so there are no further pages. Instagram matches loosely, so an unrelated query can still return results. Each `id` works as `audioId` on the audio endpoints."
                        }
                      },
                      "required": [
                        "audio"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
