  "paths": {
    "/apis/v1/socialfetch/v2/instagram/audio/{audioId}": {
      "get": {
        "responses": {
          "200": {
            "description": "The audio, or not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "`found` when Instagram has the audio, with or without Reels; `not_found` when it doesn't know the id."
                        },
                        "audio": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^\\d+$",
                              "description": "Audio id. The audio endpoints take it as `audioId`, and it matches `audio.id` on a Reel."
                            },
                            "assetId": {
                              "type": "string",
                              "nullable": true,
                              "pattern": "^\\d+$",
                              "description": "A second id Instagram gives some audio, set only when it differs from `id`. If `GET /v2/instagram/audio/{audioId}` answers not_found for an `id` from search, try `assetId`. Null when none."
                            },
                            "title": {
                              "type": "string",
                              "nullable": true,
                              "description": "Song or sound title."
                            },
                            "artist": {
                              "type": "string",
                              "nullable": true,
                              "description": "Artist name."
                            },
                            "artistHandle": {
                              "type": "string",
                              "nullable": true,
                              "description": "Username of the account behind the audio: the creator of original audio, or the artist's account for licensed music when Instagram links one. Null when none or not reported."
                            },
                            "durationMs": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Length in milliseconds."
                            },
                            "isOriginal": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether it is original audio rather than licensed music."
                            },
                            "isExplicit": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether it is marked explicit."
                            },
                            "reelCount": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "description": "Reels using it, as an exact count. Null when Instagram only gives a rounded figure (such as 2.5M)."
                            },
                            "isTrending": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether Instagram marks it trending."
                            },
                            "coverUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Cover art. Null for original audio. Instagram CDN URL; it expires after a while."
                            },
                            "previewUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Short audio clip of the track. Null for original audio and when Instagram gives none. Instagram CDN URL; it expires after a while."
                            },
                            "spotifyUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Spotify page of the track. Null for original audio and when Instagram links none."
                            },
                            "hasLyrics": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether Instagram has lyrics for the track. Null for original audio and when not reported."
                            }
                          },
                          "required": [
                            "id",
                            "assetId",
                            "title",
                            "artist",
                            "artistHandle",
                            "durationMs",
                            "isOriginal",
                            "isExplicit",
                            "reelCount",
                            "isTrending",
                            "coverUrl",
                            "previewUrl",
                            "spotifyUrl",
                            "hasLyrics"
                          ],
                          "description": "The song or original sound. Null when `lookupStatus` is `not_found`."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "audio"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "examples": {
                  "music": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "audio": {
                          "id": "2336759673035513",
                          "assetId": "221324808426784",
                          "title": "Bitter Sweet Symphony",
                          "artist": "The Verve",
                          "artistHandle": "officialtheverve",
                          "durationMs": 469733,
                          "isOriginal": false,
                          "isExplicit": false,
                          "reelCount": 79287,
                          "isTrending": false,
                          "coverUrl": "https://scontent.cdninstagram.com/v/t39.30808-6/4278c1e3d7a2.jpg?stp=example",
                          "previewUrl": null,
                          "spotifyUrl": "https://open.spotify.com/track/1KkP6yoIZ6bKfPCwP4KqFW",
                          "hasLyrics": true
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_audio_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "original": {
                    "value": {
                      "data": {
                        "lookupStatus": "found",
                        "audio": {
                          "id": "29040682308951909",
                          "assetId": null,
                          "title": "Original audio",
                          "artist": "Nike",
                          "artistHandle": "nike",
                          "durationMs": 30030,
                          "isOriginal": true,
                          "isExplicit": false,
                          "reelCount": 13,
                          "isTrending": false,
                          "coverUrl": null,
                          "previewUrl": null,
                          "spotifyUrl": null,
                          "hasLyrics": null
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_audio_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "not_found": {
                    "value": {
                      "data": {
                        "lookupStatus": "not_found",
                        "audio": null
                      },
                      "meta": {
                        "requestId": "req_01example_instagram_audio_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Audio id from audio search or a Reel's `audio.id`."
            },
            "required": true,
            "description": "Audio id from audio search or a Reel's `audio.id`.",
            "name": "audioId",
            "in": "path"
          }
        ]
      }
    }
  },
  "components": {}
}
