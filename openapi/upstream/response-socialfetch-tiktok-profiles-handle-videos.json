                            "createdAt": "2025-09-01T12:00:00.000Z",
                            "url": "https://www.tiktok.com/@stoolpresidente/video/7470123456789012345",
                            "thumbnailUrl": "https://example.com/video-cover.jpg",
                            "durationMs": 15000,
                            "pinned": false,
                            "isAd": false,
                            "stats": {
                              "views": 1000,
                              "likes": 50,
                              "comments": 5,
                              "shares": 2,
                              "saves": 1
                            },
                            "media": {
                              "downloadUrl": "https://example.com/video-watermarked.mp4",
                              "downloadWithoutWatermarkUrl": "https://example.com/video-clean.mp4"
                            }
                          }
                        ],
                        "page": {
                          "nextCursor": "1737000000000",
                          "hasMore": true
                        }
                      },
                      "meta": {
                        "requestId": "req_01example_tiktok_profile_videos_sparse",
                        "creditsCharged": 1,
                        "version": "v1"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
