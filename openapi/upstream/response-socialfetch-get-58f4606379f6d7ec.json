  "paths": {
    "/apis/v1/socialfetch/v2/instagram/media/{media}/comments/{commentId}/replies": {
      "get": {
        "responses": {
          "200": {
            "description": "One page of the comment's replies.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "`found` when the comment exists on the post (with or without replies), `not_found` when the comment or the post doesn't exist, or the post belongs to a private account."
                        },
                        "comments": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^\\d+$",
                                "description": "Comment id."
                              },
                              "text": {
                                "type": "string",
                                "description": "Comment text. Empty on a GIF-only comment."
                              },
                              "gifUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "The GIF a GIF comment carries. Null when the comment has none. Instagram CDN URL; it expires after a while."
                              },
                              "createdAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time",
                                "description": "When it was posted."
                              },
                              "author": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "nullable": true,
                                    "pattern": "^\\d+$",
                                    "description": "Instagram user id."
                                  },
                                  "handle": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Username, without @."
                                  },
                                  "displayName": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Display name."
                                  },
                                  "avatarUrl": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Profile picture. Instagram CDN URL; it expires after a while."
                                  },
                                  "verified": {
                                    "type": "boolean",
                                    "nullable": true,
                                    "description": "Whether the account is verified."
                                  },
                                  "privateAccount": {
                                    "type": "boolean",
                                    "nullable": true,
                                    "description": "Whether the account is private."
                                  }
                                },
                                "required": [
                                  "id",
                                  "handle",
                                  "displayName",
                                  "avatarUrl",
                                  "verified",
                                  "privateAccount"
                                ],
                                "description": "Who wrote it. Null when unknown."
                              },
                              "likeCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Likes."
                              },
                              "replyCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Replies. Can exceed the replies listed, as Instagram hides some. Null when this view doesn't report it (replies carry no reply count)."
                              },
                              "isPinned": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether the owner pinned the comment to the top. Null when this view doesn't say."
                              },
                              "isByOwner": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether the media's owner wrote the comment. Null when this view doesn't say."
                              },
                              "isLikedByOwner": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether the media's owner liked the comment. Null when this view doesn't say."
                              }
                            },
                            "required": [
                              "id",
                              "text",
                              "gifUrl",
                              "createdAt",
                              "author",
                              "likeCount",
                              "replyCount",
                              "isPinned",
                              "isByOwner",
                              "isLikedByOwner"
                            ],
                            "description": "A comment or a reply."
                          },
                          "description": "One page of replies to the comment, oldest first. Empty when it has none, or the list has ended."
                        },
                        "page": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "cursor",
                                "offset",
                                "page"
                              ]
                            },
                            "nextCursor": {
                              "type": "string",
                              "nullable": true
                            },
                            "hasMore": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Null when continuation is unknown for this page."
                            },
                            "start": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            },
                            "page": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "exclusiveMinimum": true
                            },
                            "count": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            },
                            "returnedCount": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "total": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            },
                            "totalPages": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            }
                          },
                          "required": [
                            "kind",
                            "nextCursor",
                            "hasMore",
                            "start",
                            "page",
                            "count",
                            "returnedCount",
                            "total",
                            "totalPages"
                          ],
                          "description": "Pagination state. Pass `nextCursor` as `cursor` for the next page while `hasMore` is true."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "comments",
                        "page"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
