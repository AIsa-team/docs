                                  },
                                  "saves": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Save or collection count reported by TikTok for the video."
                                  }
                                },
                                "required": [
                                  "views",
                                  "likes",
                                  "comments",
                                  "shares",
                                  "saves"
                                ],
