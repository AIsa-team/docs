                                    },
                                    "description": "Ordered image URLs for photo slideshow posts. Empty for videos."
                                  }
                                },
                                "required": [
                                  "downloadUrl",
                                  "downloadWithoutWatermarkUrl",
                                  "slideshowImages"
                                ],
