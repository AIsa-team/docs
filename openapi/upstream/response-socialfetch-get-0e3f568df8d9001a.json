                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            },
                            "page": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0,
                              "exclusiveMinimum": true
                            },
                            "count": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            },
                            "returnedCount": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "total": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            },
                            "totalPages": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            }
                          },
                          "required": [
                            "kind",
                            "nextCursor",
                            "hasMore",
                            "start",
                            "page",
                            "count",
                            "returnedCount",
                            "total",
                            "totalPages"
                          ],
                          "description": "Pagination state. Every highlight comes in one response, so `hasMore` is always false."
                        }
