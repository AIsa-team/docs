  "paths": {
    "/apis/v1/socialfetch/v2/instagram/profiles/{profile}/highlights": {
      "get": {
        "responses": {
          "200": {
            "description": "Story highlights for the requested profile.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "private",
                            "not_found"
                          ],
                          "description": "`found`; `private` when the account is private (only what Instagram shows publicly is returned); `not_found` when it doesn't exist."
                        },
                        "highlights": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^\\d+$",
                                "description": "Highlight id."
                              },
                              "title": {
                                "type": "string",
                                "nullable": true,
                                "description": "Highlight title."
                              },
                              "coverUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Cover image. On a profile's first lookup it can be a smaller one. Instagram CDN URL; it expires after a while."
                              },
                              "mediaCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Stories in the highlight. Can be null on a profile's first lookup."
                              },
                              "createdAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time",
                                "description": "When it was created. Can be null on a profile's first lookup."
                              },
                              "updatedAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time",
                                "description": "When it was last changed: a story was added, or it was edited. Never before `createdAt`. Can be null on a profile's first lookup."
                              }
                            },
                            "required": [
                              "id",
                              "title",
                              "coverUrl",
                              "mediaCount",
                              "createdAt",
                              "updatedAt"
                            ],
                            "description": "A story highlight."
                          },
                          "description": "The profile's story highlights. Empty when there are none."
                        },
                        "page": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
