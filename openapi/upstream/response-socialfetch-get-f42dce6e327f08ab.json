                            "handle",
                            "profileUrl"
                          ],
                          "description": "Profile identity when the lookup resolved."
                        },
                        "region": {
                          "type": "string",
                          "nullable": true,
                          "minLength": 1,
                          "description": "Country or region code reported for the profile when available. Null when the profile could not be resolved."
                        }
                      },
                      "required": [
