  "paths": {
    "/apis/v1/socialfetch/v2/instagram/hashtags/search": {
      "get": {
        "responses": {
          "200": {
            "description": "Hashtags matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "hashtags": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "nullable": true,
                                "pattern": "^\\d+$",
                                "description": "Hashtag id."
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Tag name, without #."
                              },
                              "mediaCount": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0,
                                "description": "Posts using the tag. Null when Instagram doesn't report a real count."
                              },
                              "isTrending": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether Instagram marks it trending."
                              },
                              "isRestricted": {
                                "type": "boolean",
                                "nullable": true,
                                "description": "Whether Instagram restricts the tag, so its feed is empty (for example a tag it hides as sensitive). Null when this view doesn't say."
                              },
                              "url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Public tag page URL."
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "mediaCount",
                              "isTrending",
                              "isRestricted",
                              "url"
                            ],
                            "description": "A hashtag."
                          },
                          "description": "Hashtags matching the query, in Instagram's ranking, with their post counts. One page: there is no cursor. Empty when nothing matches. `isTrending` is always null here: search doesn't report it."
                        }
                      },
                      "required": [
                        "hashtags"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v2"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata about the API response."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "examples": {
                  "found": {
                    "value": {
                      "data": {
                        "hashtags": [
                          {
                            "id": "17841563515097659",
                            "name": "nikerunclub",
                            "mediaCount": 2029454,
                            "isTrending": null,
                            "isRestricted": null,
                            "url": "https://www.instagram.com/explore/tags/nikerunclub/"
                          },
                          {
                            "id": "17843784100048263",
                            "name": "nike",
                            "mediaCount": 118632374,
                            "isTrending": null,
                            "isRestricted": null,
                            "url": "https://www.instagram.com/explore/tags/nike/"
                          },
                          {
                            "id": "17843698711048751",
                            "name": "nikerunning",
                            "mediaCount": 7472478,
                            "isTrending": null,
                            "isRestricted": null,
                            "url": "https://www.instagram.com/explore/tags/nikerunning/"
                          },
                          {
                            "id": "17843798875001583",
                            "name": "nikeplus",
                            "mediaCount": 6332883,
                            "isTrending": null,
                            "isRestricted": null,
                            "url": "https://www.instagram.com/explore/tags/nikeplus/"
                          }
                        ]
                      },
                      "meta": {
                        "requestId": "req_01example_hashtags_search_v2",
                        "creditsCharged": 1,
                        "version": "v2"
                      }
                    }
                  },
                  "no_results": {
                    "value": {
                      "data": {
                        "hashtags": []
                      },
