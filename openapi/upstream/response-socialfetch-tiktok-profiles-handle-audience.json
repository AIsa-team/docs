  "paths": {
    "/apis/v1/tiktok/profiles/{handle}/audience": {
      "get": {
        "responses": {
          "200": {
            "description": "TikTok profile audience demographics.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "Whether audience demographics could be resolved for the handle."
                        },
                        "profile": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "platform": {
                              "type": "string",
                              "enum": [
                                "tiktok"
                              ],
                              "description": "Social platform for this profile."
                            },
                            "handle": {
                              "type": "string",
                              "description": "TikTok username without the leading @."
                            },
                            "profileUrl": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Canonical public TikTok profile URL."
                            }
                          },
                          "required": [
                            "platform",
                            "handle",
                            "profileUrl"
                          ],
                          "description": "Profile identity when the lookup resolved."
                        },
                        "audienceLocations": {
                          "type": "array",
                          "nullable": true,
                          "items": {
                            "type": "object",
                            "properties": {
                              "country": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Country name for this audience segment."
                              },
                              "countryCode": {
                                "type": "string",
                                "minLength": 1,
                                "description": "ISO country code for this audience segment."
                              },
                              "count": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Audience count reported for this country."
                              },
                              "percentage": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Share of the audience for this country, as a percentage string (for example \"15.96%\")."
                              }
                            },
                            "required": [
                              "country",
                              "countryCode",
                              "count",
                              "percentage"
                            ],
                            "description": "One country row in the audience location breakdown."
                          },
                          "description": "Country-level audience breakdown when available. Null when the profile could not be resolved."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "profile",
                        "audienceLocations"
                      ],
                      "description": "Endpoint-specific response payload."
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unique request identifier for tracing this API call."
                        },
                        "creditsCharged": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Credits charged for this request."
                        },
                        "version": {
                          "type": "string",
                          "enum": [
                            "v1"
                          ],
                          "description": "Public API version that served the response."
                        }
                      },
                      "required": [
                        "requestId",
                        "creditsCharged",
                        "version"
                      ],
                      "description": "Metadata describing the request and billing outcome."
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "description": "Standard success response envelope."
                },
                "examples": {
