  "paths": {
    "/apis/v1/socialfetch/v1/twitter/profiles/{handle}/about": {
      "get": {
        "responses": {
          "200": {
            "description": "Twitter account transparency details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
