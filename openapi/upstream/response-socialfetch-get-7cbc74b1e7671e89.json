                          "description": "Whether the account was found."
                        },
                        "about": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "string",
                              "nullable": true,
                              "description": "Numeric X user id as a string."
                            },
                            "username": {
                              "type": "string",
                              "nullable": true,
                              "description": "X screen name (handle) without the leading @."
                            },
                            "name": {
                              "type": "string",
                              "nullable": true,
                              "description": "Display name shown on the profile."
                            },
                            "createdAt": {
                              "type": "string",
                              "nullable": true,
                              "description": "Account creation time as returned by X (raw string). Prefer `accountCreatedAt` for ISO-8601."
                            },
                            "accountCreatedAt": {
                              "type": "string",
                              "format": "date-time",
                              "description": "Account creation time (ISO-8601) when derivable."
                            },
                            "verified": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether X marks the account with legacy verification (not necessarily paid blue)."
                            },
                            "isBlueVerified": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether the account has X blue (paid) verification."
                            },
                            "isProtected": {
                              "type": "boolean",
                              "nullable": true,
                              "description": "Whether the account is protected (private)."
                            },
                            "avatarUrl": {
                              "type": "string",
                              "nullable": true,
                              "description": "Best available square avatar image URL."
                            },
                            "profileImageShape": {
                              "type": "string",
                              "nullable": true,
                              "description": "Avatar crop shape reported by X, such as Circle or Square."
                            },
                            "verifiedSince": {
                              "type": "string",
                              "nullable": true,
                              "description": "When X verification became effective (ISO-8601). Invalid dates are null."
                            },
                            "affiliate": {
                              "type": "object",
                              "nullable": true,
                              "properties": {
                                "username": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Affiliate organization username."
                                },
                                "description": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Affiliate label text shown on the profile."
                                },
                                "badgeUrl": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Affiliate badge image URL."
                                }
                              },
                              "required": [
                                "username",
                                "description",
                                "badgeUrl"
                              ],
                              "description": "Affiliate or organization relationship when present."
                            },
                            "aboutProfile": {
                              "type": "object",
                              "nullable": true,
                              "properties": {
                                "accountBasedIn": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Country or region X associates with the account."
                                },
                                "locationAccurate": {
                                  "type": "boolean",
                                  "nullable": true,
                                  "description": "Whether X considers the location signal accurate."
                                },
                                "learnMoreUrl": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Help URL explaining X account transparency or verification."
                                },
                                "affiliateUsername": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Affiliate organization username when X shows one."
                                },
                                "source": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Account creation source, such as an app store locale."
                                },
                                "usernameChanges": {
                                  "type": "object",
                                  "nullable": true,
                                  "properties": {
                                    "count": {
                                      "type": "integer",
                                      "nullable": true,
                                      "minimum": 0,
                                      "description": "Number of username changes X reports for this account."
                                    },
                                    "lastChangedAt": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "When the username last changed (ISO-8601), when X reports a timestamp."
                                    }
                                  },
                                  "required": [
                                    "count",
                                    "lastChangedAt"
                                  ],
                                  "description": "Username-change history when X provides it."
                                }
                              },
                              "required": [
                                "accountBasedIn",
                                "locationAccurate",
                                "learnMoreUrl",
                                "affiliateUsername",
                                "source",
                                "usernameChanges"
                              ],
                              "description": "Transparency payload (location, source, username history)."
                            }
                          },
                          "required": [
                            "id",
                            "username",
                            "name",
                            "createdAt",
                            "verified",
                            "isBlueVerified",
                            "isProtected",
                            "avatarUrl",
                            "profileImageShape",
                            "verifiedSince",
                            "affiliate",
                            "aboutProfile"
                          ],
                          "description": "Account transparency details when found."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "about"
