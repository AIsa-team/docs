                              "type": "string",
                              "minLength": 1,
                              "description": "Public URL of the LinkedIn post that was requested (same as the lookup input)."
                            }
                          },
                          "required": [
                            "url"
                          ],
                          "description": "Post identity when the lookup resolved; otherwise null."
                        },
                        "transcript": {
                          "type": "string",
                          "nullable": true,
                          "description": "Plain transcript text when available; null when a transcript is not available."
                        }
                      },
                      "required": [
