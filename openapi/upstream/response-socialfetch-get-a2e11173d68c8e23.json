                            },
                            "media": {
                              "downloadUrl": "https://example.com/video-watermarked.mp4",
                              "downloadWithoutWatermarkUrl": "https://example.com/video-no-watermark.mp4"
                            }
                          }
                        ],
                        "page": {
                          "nextCursor": "eyJjIjoiMzAifQ",
                          "hasMore": true
                        }
                      },
                      "meta": {
                        "requestId": "req_01example",
                        "creditsCharged": 1,
                        "version": "v1"
                      }
                    }
                  },
                  "empty": {
                    "value": {
                      "data": {
                        "query": "web scraping",
                        "videos": [],
                        "page": {
                          "nextCursor": null,
                          "hasMore": false
                        }
                      },
