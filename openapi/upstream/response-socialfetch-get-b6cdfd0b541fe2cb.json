                            "properties": {
                              "id": {
                                "type": "string",
                                "nullable": true,
                                "minLength": 1,
                                "description": "LinkedIn activity id for the post (the number in urn:li:activity:<id>) when available. Matches the id returned by the company and profile post lists."
                              },
                              "url": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Canonical public URL for this LinkedIn post."
                              },
                              "title": {
                                "type": "string",
                                "nullable": true,
                                "description": "Page title for the post when available, usually a short headline followed by the author name. Article and video posts often carry their own title here."
                              },
                              "text": {
                                "type": "string",
                                "nullable": true,
                                "description": "Full text body of the post when available."
                              },
                              "publishedAt": {
                                "type": "string",
                                "nullable": true,
                                "description": "ISO-8601 timestamp for when the post was published, when available."
                              },
                              "mediaUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Primary media URL for the post when available."
                              },
                              "imageUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Primary image URL for the post when available."
                              },
                              "imageUrls": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "description": "Image URLs associated with the post when available."
                              },
                              "thumbnailUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Source-platform CDN URL for a video cover or thumbnail when available. It can expire or be rejected outside the original retrieval context; it is not a SocialFetch-hosted asset."
                              },
                              "author": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Display name of the author."
                                  },
                                  "profileUrl": {
                                    "type": "string",
                                    "nullable": true,
                                    "format": "uri",
                                    "description": "Public profile URL for the author when available."
                                  },
                                  "avatarUrl": {
                                    "type": "string",
                                    "nullable": true,
                                    "format": "uri",
                                    "description": "Avatar image URL when available."
                                  },
                                  "followers": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Follower count when available."
                                  }
