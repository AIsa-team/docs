                                      "type": "string",
                                      "nullable": true,
                                      "description": "Display name of the commenter."
                                    },
                                    "text": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Comment body text."
                                    },
                                    "profileUrl": {
                                      "type": "string",
                                      "nullable": true,
                                      "format": "uri",
                                      "description": "Public profile URL for the commenter when available."
                                    },
                                    "id": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Comment identifier on the source platform when available."
                                    },
                                    "urn": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Comment URN on the source platform when available."
                                    },
                                    "publishedAt": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "When the comment was published as an ISO 8601 timestamp, or null when the source gives no date or it cannot be parsed."
                                    },
                                    "reactions": {
                                      "type": "integer",
                                      "nullable": true,
                                      "minimum": 0,
                                      "description": "Reaction count on the comment when available."
                                    }
                                  },
                                  "required": [
                                    "authorName",
                                    "text",
                                    "profileUrl",
                                    "id",
                                    "urn",
                                    "publishedAt",
                                    "reactions"
                                  ],
                                  "description": "A single top-level comment."
                                },
                                "description": "Top-level comments shown with the post, in the same shape as linkedin.post.get. Usually a few top comments, not the full thread. Empty when none are available."
                              }
                            },
