                                "type": "object",
                                "properties": {
                                  "reactions": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Total reactions when available."
                                  },
                                  "comments": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Comment count when available."
                                  }
                                },
                                "required": [
                                  "reactions",
                                  "comments"
                                ],
                                "description": "Engagement metrics for the post."
                              },
                              "comments": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
