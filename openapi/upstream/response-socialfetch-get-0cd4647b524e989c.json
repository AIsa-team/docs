                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0
                                },
                                "three": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0
                                },
                                "two": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0
                                },
                                "one": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0
