  "paths": {
    "/apis/v1/socialfetch/v1/google/ad-library/companies/ads": {
      "get": {
        "responses": {
          "200": {
            "description": "Ads for the requested company or advertiser.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "lookupStatus": {
                          "type": "string",
                          "enum": [
                            "found",
                            "not_found"
                          ],
                          "description": "Whether the company or advertiser resolved for this request."
                        },
                        "ads": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "advertiserId": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Google Ad Transparency advertiser id."
                              },
                              "creativeId": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Google Ad Transparency creative id."
                              },
                              "format": {
                                "type": "string",
                                "nullable": true,
                                "description": "Creative format when available (text, image, or video)."
                              },
                              "adUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Public Google Ad Transparency URL for this creative when available."
                              },
                              "advertiserName": {
                                "type": "string",
                                "nullable": true,
                                "description": "Advertiser display name when available."
                              },
                              "domain": {
                                "type": "string",
                                "nullable": true,
                                "description": "Advertiser domain when available."
                              },
                              "imageUrl": {
                                "type": "string",
                                "nullable": true,
                                "description": "Preview image URL when available."
                              },
                              "firstShown": {
                                "type": "string",
                                "nullable": true,
                                "description": "ISO-8601 timestamp for when the ad was first shown, when available."
                              },
                              "lastShown": {
                                "type": "string",
                                "nullable": true,
                                "description": "ISO-8601 timestamp for when the ad was last shown, when available."
                              },
                              "overallImpressions": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "min": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Lower bound for impressions when available."
                                  },
                                  "max": {
                                    "type": "integer",
                                    "nullable": true,
                                    "minimum": 0,
                                    "description": "Upper bound for impressions when available."
                                  }
                                },
                                "required": [
                                  "min",
                                  "max"
                                ],
                                "description": "Overall impression range when available; null when neither bound is reported."
                              },
                              "creativeRegions": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "regionCode": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Two-letter region code when available."
                                    },
                                    "regionName": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Human-readable region name when available."
                                    }
                                  },
                                  "required": [
                                    "regionCode",
                                    "regionName"
                                  ],
                                  "description": "Region where a Google Ad Library creative ran."
                                },
                                "description": "Regions where the creative ran, one entry per region. `regionCode` is an upper-case two-letter code, or null when no valid code is reported. Empty when not reported."
                              },
                              "variations": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "destinationUrl": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Landing page or destination URL when available."
                                    },
                                    "headline": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Ad headline when available. Text may be OCR-extracted and imperfect."
                                    },
                                    "description": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Ad description when available. Text may be OCR-extracted and imperfect."
                                    },
                                    "allText": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Combined visible text when available. Text may be OCR-extracted and imperfect."
                                    },
                                    "imageUrl": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Creative image URL when available. Falls back to the first entry in `images` when no dedicated image URL is reported."
                                    },
                                    "images": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      },
                                      "description": "All image URLs reported for this variation, such as Shopping product images. Empty when none are reported."
                                    },
                                    "visibleUrl": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Display URL shown on the ad (often a bare domain) when available."
                                    },
                                    "youtubeUrl": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "YouTube URL for video creatives when available."
                                    }
                                  },
                                  "required": [
                                    "destinationUrl",
                                    "headline",
                                    "description",
                                    "allText",
                                    "imageUrl",
                                    "images",
                                    "visibleUrl",
                                    "youtubeUrl"
                                  ],
                                  "description": "A creative variation for a Google company ad. Same fields as a Google Ad Library ad variation, plus `visibleUrl` and `youtubeUrl`."
                                },
                                "description": "Creative variations for this ad: headline, description, landing page and media. Destination URLs reported without a scheme are returned with `https://`. Empty when not reported."
                              }
                            },
                            "required": [
                              "advertiserId",
                              "creativeId",
                              "format",
                              "adUrl",
                              "advertiserName",
                              "domain",
                              "imageUrl",
                              "firstShown",
                              "lastShown",
                              "overallImpressions",
                              "creativeRegions",
                              "variations"
                            ],
                            "description": "A single Google Ad Transparency company ad."
                          },
                          "description": "Ads returned for the requested company or advertiser. This array may be empty when the lookup resolves but no ads match the filters."
                        },
                        "adsEstimate": {
                          "type": "integer",
                          "nullable": true,
                          "minimum": 0,
                          "description": "Estimated total number of matching ads when reported; otherwise null."
                        },
                        "page": {
                          "type": "object",
                          "properties": {
                            "nextCursor": {
                              "type": "string",
                              "nullable": true,
                              "description": "Cursor to pass as `cursor` in the next request when `hasMore` is true; otherwise null."
                            },
                            "hasMore": {
                              "type": "boolean",
                              "description": "Whether another page of ads can be requested."
                            }
                          },
                          "required": [
                            "nextCursor",
                            "hasMore"
                          ],
                          "description": "Pagination information for the current response."
                        }
                      },
                      "required": [
                        "lookupStatus",
                        "ads",
                        "adsEstimate",
                        "page"
                      ],
                      "description": "Endpoint-specific response payload."
