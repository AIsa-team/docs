  "paths": {
    "/apis/v1/saferproducts-gov/product-recalls/recall": {
      "post": {
        "description": "Read the full recall notice once you have its number (from search_recalls or the cpsc.gov notice).",
        "operationId": "saferproducts-gov.product-recalls.recall",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "recall_id": {
                    "type": "number",
                    "description": "CPSC RecallID, e.g. 10880. Give this or recall_number.\n\nProvider reference: minimum 1.",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1
                    }
                  },
                  "recall_number": {
                    "type": "string",
                    "description": "CPSC recall number, e.g. 26639 (the number in the recall notice). Give this or recall_id. Pattern: ^ *[0-9]{5}[A-Za-z]? *$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "recall_number": "26639"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read one CPSC recall by recall number or RecallID: title, description, dates, products with category and units, hazards, remedies and remedy options, injuries, manufacturers, retailers, importers, distributors, manufacturer countries, UPCs, images and the cpsc.gov notice URL.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `consumer_contact` | string | How consumers reach the firm; null when CPSC lists none. |\n| `description` | string | Recall description; null on the rare record without one. |\n| `distributors` | string[] | Distributor names. |\n| `hazards` | string[] | Hazard statements. |\n| `images` | object[] |  |\n| `importers` | string[] | Importer names. |\n| `injuries` | string[] | Incident and injury statements. |\n| `last_publish_date` | string | Date CPSC last published a change to the record. |\n| `manufacturer_countries` | string[] | Countries where the products were made. |\n| `manufacturers` | string[] | Manufacturer names with location as CPSC writes them. |\n| `products` | object[] |  |\n| `recall_date` | string | Date CPSC announced the recall. |\n| `recall_id` | number | CPSC Recall Central record id. |\n| `recall_number` | string | CPSC recall number: two-digit fiscal year plus sequence, with a letter suffix on some 1990-2009 recalls (e.g. 26639, 99079a). |\n| `related_urls` | string[] | Related notices CPSC links (Inconjunctions), e.g. Health Canada joint recalls. |\n| `remedies` | string[] | Remedy instructions. |\n| `remedy_options` | string[] | CPSC remedy categories such as Refund, Repair, Replace. |\n| `retailers` | string[] | Where and when the products were sold, as CPSC writes it. |\n| `source_url` | string |  |\n| `title` | string |  |\n| `upcs` | string[] | Product UPCs when CPSC lists them. |\n| `url` | string | CPSC recall notice URL as CPSC records it; a few historic rows carry typos such as `https:/www.`. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-10-07.",
                    "value": {
                      "consumer_contact": "Peony Design by email at peonydesigncoshoppe@gmail.com for more information.",
                      "description": "This recall involves Peony Design personalized handmade baby bibs and stroller bags. The bibs have scalloped edges, a snap closure, and personalized embroidery on the front. The bibs were sold in fabric designs of geese, strawberries, heart tulip, plaid checks, and floral print. The stroller bags were made in coordinating fabrics including heart tulip, plaid check, floral print, and Winnie the Pooh. Each stroller bag has two straps with snaps at the ends for attachment and is personalized with embroidery and a ruffle around the top edge.",
                      "distributors": [],
                      "hazards": [
                        "The snap can detach from the recalled bibs and stroller bags, posing a risk of serious injury or death from a choking hazard to young children."
                      ],
                      "images": [
                        {
                          "caption": "Recalled bib with strawberry print",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-1.png"
                        },
                        {
                          "caption": "Recalled bib with geese print",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-2.png"
                        },
                        {
                          "caption": "Recalled bib with plaid check print",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-3.png"
                        },
                        {
                          "caption": "Recalled bib with heart tulip print",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-4.png"
                        },
                        {
                          "caption": "Recalled bib with floral print",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-5.png"
                        },
                        {
                          "caption": "Recalled heart tulip stroller bag",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-6.png"
                        },
                        {
                          "caption": "Recalled floral print stroller bag",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-7.png"
                        },
                        {
                          "caption": "Recalled plaid check stroller bag",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-8.png"
                        },
                        {
                          "caption": "Recalled Winnie the Pooh stroller bag",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-9.png"
                        },
                        {
                          "caption": "Recalled plaid check stroller bag",
                          "url": "https://www.cpsc.gov/s3fs-public/peony-10.png"
                        }
                      ],
                      "importers": [],
                      "injuries": [
                        "The firm received three reported incidents of a broken snap on a bib and a broken snap on two stroller bags. No injuries have been reported."
                      ],
                      "last_publish_date": "2026-07-24",
                      "manufacturer_countries": [
                        "United States"
                      ],
                      "manufacturers": [
                        "Peony Design Co., of Howell, MI"
                      ],
                      "products": [
                        {
                          "category_id": null,
                          "name": "Personalized Baby Bibs and Stroller Bags",
                          "type": null,
                          "units": "About 52"
                        }
                      ],
                      "recall_date": "2026-07-23",
                      "recall_id": 10880,
                      "recall_number": "26639",
                      "related_urls": [],
                      "remedies": [
                        "Consumers should take the recalled baby bibs and stroller bags away from children immediately, stop using them, and contact Peony Design to receive a full refund. Consumers will be asked to discard the recalled baby bibs and stroller bags."
                      ],
                      "remedy_options": [
                        "Refund"
                      ],
                      "retailers": [
                        "Online at Etsy.com from October 2025 through July 2026 for between $15 and $45."
                      ],
                      "source_url": "https://www.saferproducts.gov/RestWebServices/Recall?format=json&RecallNumber=26639",
                      "title": "Peony Design Recalls Personalized Baby Bibs and Stroller Bags Due to Risk of Serious Injury or Death from Choking Hazard",
                      "upcs": [],
                      "url": "https://www.cpsc.gov/Recalls/2026/Peony-Design-Recalls-Personalized-Baby-Bibs-and-Stroller-Bags-Due-to-Risk-of-Serious-Injury-or-Death-from-Choking-Hazard"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Recall",
        "tags": [
          "CPSC Recalls (SaferProducts.gov)"
        ],
