    "/apis/v1/saferproducts-gov/product-recalls/search-recalls": {
      "post": {
        "description": "Find recalls for a product, brand, retailer or period. Use recall for the full notice (remedies, units, firms, images). Covers CPSC-regulated consumer products only, not food, drugs, vehicles or tires (FDA, USDA, NHTSA).",
        "operationId": "saferproducts-gov.product-recalls.search-recalls",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "cursor": {
                    "type": "string",
                    "description": "Continuation from a previous page (meta.page.next_cursor): the offset of the next recall. Pattern: ^[0-9]+$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "description": {
                    "type": "string",
                    "description": "Substring of the recall description.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "distributor": {
                    "type": "string",
                    "description": "Substring of a distributor name.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "importer": {
                    "type": "string",
                    "description": "Substring of an importer name.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "last_publish_date_from": {
                    "type": "string",
                    "description": "Earliest last-published date, inclusive. Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "last_publish_date_to": {
                    "type": "string",
                    "description": "Latest last-published date, inclusive. Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "limit": {
                    "type": "number",
                    "description": "Recalls per page.\n\nProvider reference: minimum 1; maximum 100; default 25.",
                    "default": 25,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 100
                    }
                  },
                  "manufacturer": {
                    "type": "string",
                    "description": "Substring of a manufacturer name.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "product_name": {
                    "type": "string",
                    "description": "Substring of a recalled product's name.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "product_type": {
                    "type": "string",
                    "description": "Substring of CPSC's product category label, e.g. Cribs, Bicycles.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "recall_date_from": {
                    "type": "string",
                    "description": "Earliest recall date, inclusive. Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "recall_date_to": {
                    "type": "string",
                    "description": "Latest recall date, inclusive. Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "retailer": {
                    "type": "string",
                    "description": "Substring of the retailer text (where sold), e.g. Walmart, Amazon.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "title": {
                    "type": "string",
                    "description": "Case-insensitive substring of the recall title (CPSC RecallTitle).",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "limit": 5,
                    "recall_date_from": "2024-01-01",
                    "recall_date_to": "2025-12-31",
                    "title": "stroller"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search CPSC consumer product recalls. Text filters are case-insensitive substrings (stroller also matches strollers); every filter must match. Returns recall summaries newest first with a client-side page and continuation. At least one filter is required; CPSC returns its entire database (10,000+ recalls) otherwise.\n\nThe response contains the tool result directly.\n\nThe provider identifies `recalls` as the primary payload key.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `hazards` | string[] | Hazard statements. |\n| `last_publish_date` | string | Date CPSC last published a change to the record. |\n| `manufacturer_countries` | string[] | Countries where the products were made. |\n| `product_names` | string[] | Non-empty product names in CPSC order. |\n| `recall_date` | string | Date CPSC announced the recall. |\n| `recall_id` | number | CPSC Recall Central record id. |\n| `recall_number` | string | CPSC recall number: two-digit fiscal year plus sequence, with a letter suffix on some 1990-2009 recalls (e.g. 26639, 99079a). |\n| `remedy_options` | string[] | CPSC remedy categories such as Refund, Repair, Replace. |\n| `title` | string |  |\n| `url` | string | CPSC recall notice URL as CPSC records it; a few historic rows carry typos such as `https:/www.`. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
