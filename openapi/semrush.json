            "required": true,
            "description": "Target domain or URL.",
            "schema": {
              "type": "string",
              "example": "ahrefs.com"
            }
          },
          {
            "name": "target_type",
            "in": "query",
            "required": true,
            "description": "One of `root_domain`, `domain`, or `url`.",
            "schema": {
              "type": "string",
              "example": "root_domain"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Semicolon-delimited rows. Header: `neighbour;similarity`.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "neighbour;similarity\nsemrush.com;0.477280"
              }
            }
          }
        }
      }
    }
  },
  "components": {
