    "/apis/v1/megekko-nl/products/search": {
      "post": {
        "description": "Finding Megekko products and prices from a Dutch or English keyword, model name or part number, e.g. 'rtx 5070', 'samsung 990 pro', 'MZ-V9P1T0BW'.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0005 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
