  "paths": {
    "/apis/v1/megekko-nl/products/product": {
      "post": {
        "description": "Reading one Megekko product after search, or from a pasted megekko.nl/product/ URL.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0005 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "megekko-nl.products.product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "product_id": {
                    "type": "string",
                    "description": "Megekko article number, e.g. 293095 (the product_id from search). Pattern: ^[0-9]{1,10}$."
                  },
                  "url": {
                    "type": "string",
                    "description": "megekko.nl product URL, e.g. https://www.megekko.nl/product/5093/293095/SSD-M-2/Samsung-990-PRO-1TB-M-2-SSD. Supply this or product_id. Pattern: ^https?://(?:www\\.)?megekko\\.nl/product/(?:[0-9]+/)?[0-9]+(?:[/?#]|$)."
                  }
                },
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "product_id": {}
                        },
                        "required": [
                          "product_id"
                        ]
                      },
                      {
                        "properties": {
                          "url": {}
                        },
                        "required": [
                          "url"
                        ]
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "product_id": "293095"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Megekko product details by article number or product URL: name, brand, manufacturer part number, EAN, EUR price and reference price, schema.org availability, stock and delivery text, category path, images, the full specification table and the customer review score.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `availability` | string | schema.org availability of the offer, e.g. InStock, OutOfStock. |\n| `brand` | string |  |\n| `category_path` | string[] |  |\n| `country` | string | Market of the storefront: always NL. |\n| `currency` | string | Currency of every price: EUR. |\n| `delivery_text` | string | Delivery part of the stock line, e.g. '1 werkdag (maandag)' or 'uitverkocht'. |\n| `description` | string | Short Dutch product description. |\n| `ean` | string | EAN / GTIN-13. |\n| `for_sale` | boolean | False when the price widget says the article is no longer for sale ('niet (meer) te koop'); the last price is still reported. |\n| `images` | string[] |  |\n| `in_stock` | boolean |  |\n| `language` | string | Storefront language: always nl (labels and texts are Dutch). |\n| `manufacturer_part_number` | string | Manufacturer part number (schema.org mpn, 'Vendorcode' in the specs). Megekko truncates long codes to 30 characters. |\n| `name` | string |  |\n| `observed_at_ms` | number | Unix epoch milliseconds when the source answered. |\n| `price` | object |  |\n| `product_id` | string | Megekko article number. |\n| `rating` | object | Customer reviews Megekko shows for the product (they can include reviews written for sibling variants of the same product family). Null when the product has no reviews. Megekko publishes no aggregate score, so average is computed over the reviews rendered on the product page. |\n| `reference_price` | number | 'Meest getoonde prijs laatste 90 dagen' in EUR when shown; null otherwise. |\n| `specs` | object[] | Full specification table ('Specificaties'), in page order. |\n| `stock_text` | string | Stock and delivery line as shown, e.g. 'Uit eigen voorraad leverbaar. Levertijd: 1 werkdag (maandag)'. |\n| `url` | string | Canonical product page. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-10-24.",
                    "value": {
                      "availability": "InStock",
                      "brand": "Samsung",
                      "category_path": [
                        "Computer",
                        "Componenten",
                        "SSD (Solid state drive)",
                        "SSD M.2"
                      ],
                      "country": "NL",
                      "currency": "EUR",
                      "delivery_text": "1 werkdag (maandag)",
                      "description": "De Samsung 990 PRO 1TB M.2 SSD is een krachtige en snelle SSD die gebruik maakt van NVMe PCIe 4.0 technologie. Met een maximale leessnelheid van 7450 MB/s en schrijfsnelheid van 6900 MB/s, biedt deze SSD een uitstekende prestatie voor zowel gaming als professioneel gebruik. De DRAM cache en compatibiliteit met de PS5 maken de 990 PRO tot een aantrekkelijke keuze voor gebruikers die op zoek zijn naar een betrouwbare en toonaangevende solid-state drive.",
                      "ean": "8806094215021",
                      "for_sale": true,
                      "images": [
                        "https://www.megekko.nl/productimg/293095/nw/0_Samsung-990-PRO-1TB-M-2-SSD.jpg",
                        "https://www.megekko.nl/productimg/293095/nw/1_Samsung-990-PRO-1TB-M-2-SSD.jpg",
                        "https://www.megekko.nl/productimg/293095/nw/2_Samsung-990-PRO-1TB-M-2-SSD.jpg"
                      ],
                      "in_stock": true,
                      "language": "nl",
                      "manufacturer_part_number": "MZ-V9P1T0BW",
                      "name": "Samsung 990 PRO 1TB M.2 SSD",
                      "observed_at_ms": 1792807400000,
                      "price": {
                        "amount": 229.9,
                        "currency": "EUR"
                      },
                      "product_id": "293095",
                      "rating": {
                        "average": 5,
                        "review_count": 4,
                        "reviews_shown": 4,
                        "scale": 5
                      },
                      "reference_price": null,
                      "specs": [
                        {
                          "group": "Beveiliging",
                          "name": "Ondersteunde beveiligingsalgoritmen",
                          "value": "256-bit AES"
                        },
                        {
                          "group": "Energie",
