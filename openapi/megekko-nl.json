                          "value": "3,3 V"
                        },
                        {
                          "group": "Energie",
                          "name": "Stroomverbruik (idle)",
                          "value": "0,05 W"
                        },
                        {
                          "group": "Energie",
                          "name": "Vermogensverbruik (avg)",
                          "value": "5,4 W"
                        },
                        {
                          "group": "Energie",
                          "name": "Vermogensverbruik (max)",
                          "value": "7,8 W"
                        }
                      ],
                      "stock_text": "Uit eigen voorraad leverbaar. Levertijd: 1 werkdag (maandag)",
                      "url": "https://www.megekko.nl/product/5093/293095/SSD-M-2/Samsung-990-PRO-1TB-M-2-SSD"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
