        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Day of the file (YYYY-MM-DD, 2015 on). Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$."
                  },
                  "preview": {
                    "type": "boolean",
                    "description": "Decode the first rows from a 1 MiB Range read (default false).",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "preview_rows": {
                    "type": "number",
                    "description": "Rows to return with preview=true (default 100).\n\nProvider reference: minimum 1; maximum 1000.",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 1000
                    }
                  }
                },
                "required": [
                  "date"
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "date": "2026-06-30",
                    "preview": true,
                    "preview_rows": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
