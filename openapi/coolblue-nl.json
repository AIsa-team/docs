    "/apis/v1/coolblue-nl/products/product": {
      "post": {
        "description": "Get a Coolblue.nl product by product number or URL: name, brand, EUR price and list price, stock state and delivery promise, rating (1-10) and review count, key specs, the full specification table, EAN when published, and pros and cons when published.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0005 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "coolblue-nl.products.product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "product_id": {
                    "type": "number",
                    "description": "Coolblue product number (Artikelnummer), the number after /product/ in its URL.\n\nProvider reference: minimum 1; maximum 999999999."
                  },
                  "url": {
                    "type": "string",
                    "description": "HTTPS coolblue.nl product URL. Supply this or product_id. Pattern: ^https://(?:www\\.)?coolblue\\.nl/(?:en/)?product/[0-9]+(?:[/?#]|$)."
                  }
                },
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "product_id": {}
                        },
                        "required": [
                          "product_id"
                        ]
                      },
                      {
                        "properties": {
                          "url": {}
                        },
                        "required": [
                          "url"
                        ]
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "product_id": 949371
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Get a Coolblue.nl product by product number or URL: name, brand, EUR price and list price, stock state and delivery promise, rating (1-10) and review count, key specs, the full specification table, EAN when published, and pros and cons when published.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `brand` | string |  |\n| `cons` | string[] | Minus points (Minpunten) as published; null when the page has none. |\n| `country` | string |  |\n| `currency` | string |  |\n| `delivery_promise` | string | Delivery/stock promise in the order block, in Dutch, e.g. 'Op voorraad' or 'Bezorgd op donderdag'. Reflects the default (no postal code) promise. |\n| `description` | string |  |\n| `ean` | string | EAN/GTIN when Coolblue publishes it (JSON-LD or a specification row); Coolblue usually does not, so this is mostly null. |\n| `image_url` | string |  |\n| `in_stock` | boolean | stock_status is OnStock. |\n| `key_specs` | string[] | Coolblue's short highlight specs for the product (may be empty). |\n| `list_price` | number | Struck-through reference price (Adviesprijs) in EUR when it is above the selling price, else null. |\n| `manufacturer_code` | string | Manufacturer part number (Fabrikantcode). |\n| `name` | string |  |\n| `observed_at_ms` | number |  |\n| `price` | number | Selling price in EUR including VAT. |\n| `product_id` | number |  |\n| `product_type` | string | Coolblue product type, singular, in Dutch (e.g. laptop). |\n| `pros` | string[] | Plus points (Pluspunten) as published; null when the page has none. |\n| `rating` | number | Average customer score on Coolblue's 1-10 scale; null without reviews. |\n| `review_count` | number |  |\n| `specifications` | object[] | Full specification table grouped as on the page (Dutch labels). |\n| `stock_status` | string | Coolblue availability state, e.g. OnStock, BackOrder, TemporaryOutOfStock, OutOfStock. |\n| `url` | string |  |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
