    "/apis/v1/earthquake-usgs-gov/earthquakes/event": {
      "post": {
        "description": "Look up one known earthquake's authoritative parameters and impact estimates: how strong the shaking was, the PAGER alert and whether fatalities or economic losses drove it, how many people reported feeling it. Use search to find event ids.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0005 USD (not a fixed price). Declared unit rate: $0.0001 USD per provider_credit. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "earthquake-usgs-gov.earthquakes.event",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "ComCat event id such as us6000jllz or official20110311054624120_30 (case-insensitive). Pass id or url, not both. Pattern: ^[A-Za-z0-9_-]{2,64}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "url": {
                    "type": "string",
                    "description": "USGS event page URL, https://earthquake.usgs.gov/earthquakes/eventpage/<id>[/...].",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "id": "us6000jllz"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One ComCat event by id (or event page URL) from /fdsnws/event/1/query?eventid=..., with the normalized event record plus curated summaries of its preferred ShakeMap (maximum estimated intensity, version, review status), PAGER (overall alert level, fatality and economic alert levels from the PAGER alerts.json, which of them set the overall alert) and Did You Feel It? (maximum reported intensity, response count) products. Each summary is null when the event has no such product. Any associated id (e.g. usp000hvnu) resolves to the preferred event.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `dyfi` | object | Preferred Did You Feel It? product; null when there are no reports. |\n| `event` | object | One ComCat event's preferred solution, normalized from the FDSN GeoJSON feature. |\n| `pager` | object | Preferred PAGER (losspager) product; null when PAGER did not run. |\n| `shakemap` | object | Preferred ShakeMap product; null when none was produced. |\n| `source_url` | string |  |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
