          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": false,
                "properties": {
                  "country": {
                    "description": "Two-letter Apple storefront country, such as 'us' or 'gb' ('uk' is accepted). Default 'us'.",
                    "pattern": "^[a-zA-Z]{2}$",
                    "type": "string"
                  },
                  "product_id": {
                    "description": "Positive decimal Apple app identifier, such as '570060128'.",
                    "pattern": "^[1-9][0-9]{0,19}$",
                    "type": "string"
                  },
                  "type": {
                    "description": "App product type; only 'app' is supported.",
