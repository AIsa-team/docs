    "/apis/v1/google/ad-library/companies/ads": {
      "get": {
        "description": "Lists ads a company or advertiser is running in Google Ads Transparency, with optional topic, region, date, platform and format filters. When `topic` is `political`, `region` is required. Provide `domain` or `advertiserId`. Results are paged: while `data.page.hasMore` is true, send `data.page.nextCursor` as `cursor` to get the next page.",
        "operationId": "google.ad-library.companies.ads",
        "parameters": [
          {
            "in": "query",
            "name": "advertiserId",
            "required": false,
            "schema": {
              "description": "Google Ad Transparency advertiser id when you have it instead of a domain.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "Opaque pagination cursor from a previous response.",
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "description": "Company domain when you do not have an advertiser id.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "endDate",
            "required": false,
            "schema": {
              "description": "Optional end date filter in YYYY-MM-DD format.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "description": "Optional creative format filter.",
              "enum": [
                "image",
                "text",
                "video"
              ],
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "description": "Optional Google surface filter.",
              "enum": [
                "google_maps",
                "google_play",
                "google_search",
                "google_shopping",
                "youtube"
              ],
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "description": "Optional region filter as a two-letter country code.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "startDate",
            "required": false,
            "schema": {
              "description": "Optional start date filter in YYYY-MM-DD format.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "topic",
            "required": false,
            "schema": {
              "description": "Optional topic filter. When `political`, `region` is required.",
              "enum": [
                "all",
                "political"
              ],
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
