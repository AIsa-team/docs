  "openapi": "3.0.3",
  "paths": {
    "/twitter/spaces/detail": {
      "get": {
        "description": "按 Space ID 获取某个 X Space（实时语音房间）的详情——标题、状态、主持人、参与者和排期。适合在决定引用或参加之前，先确认该 Space 是已排期、进行中还是已结束，以及由谁主持。在 `data` 下返回该对象。\n\n<!-- aisa-pricing:start -->\n当前未提供请求参考价格；请使用接口支持的报价功能确认费用。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "get_twitter_spaces_detail",
        "parameters": [
          {
            "description": "空间的 ID。",
            "in": "query",
            "name": "space_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceDetailResponse"
                }
              }
            },
            "description": "成功响应"
          }
        },
        "summary": "获取空间详情",
        "tags": [
          "https://docs.twitterapi.io/api-reference/endpoint/get_space_detail"
        ],
        "x-aisa-pricing": {
          "cost_tier": "low",
          "model": "per_request"
        },
        "x-aisa-status": "disabled"
      }
    }
  },
