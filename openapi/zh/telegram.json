    "/apis/v1/telegram/channels/{handle}/posts": {
      "get": {
        "description": "Lists recent posts from a public Telegram channel. Groups are not supported. Results are paged: while `data.page.hasMore` is true, send `data.page.nextCursor` as `cursor` to get the next page.",
        "operationId": "telegram.channels.handle.posts",
        "parameters": [
          {
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "description": "Telegram public username (channel or group), with or without leading @.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "Opaque pagination cursor from a previous response. Omit for the first page.",
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "aisa_pagination": {
                      "additionalProperties": false,
                      "description": "AIsa pagination. Pass next_cursor as cursor to fetch the next page; has_more is false on the last page.",
                      "properties": {
                        "has_more": {
                          "type": "boolean"
                        },
                        "next_cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "next_param": {
                          "const": "cursor",
                          "type": "string"
                        }
                      },
                      "required": [
                        "has_more",
                        "next_cursor",
                        "next_param"
                      ],
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet.",
            "headers": {
              "X-AISA-Has-More": {
                "description": "Mirrors aisa_pagination.has_more.",
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              },
              "X-AISA-Next-Cursor": {
                "description": "Mirrors aisa_pagination.next_cursor; absent on the last page.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
