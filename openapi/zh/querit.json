  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.0",
  "paths": {
    "/apis/v1/querit/search": {
      "post": {
        "description": "Perform a search query using AI to retrieve relevant information based on the provided criteria.",
        "operationId": "any_querit_apis_v1_querit_search",
        "responses": {
          "200": {
            "description": "Official response table. Fields on each results.result[] item: url, title, snippet, page_age (plaintext UTC+0 time), site_name, site_icon, sentence (string[], present only when needContent: true and body text is available), highlights (string[], present only when highlights is set on the request and body text is available). Every result field is optional. Some results in the same response may have no sentence or highlights. Treat a missing field as \"body text unavailable,\" not as an error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "took": {
                      "type": "string",
                      "description": "Server-side processing time"
                    },
                    "error_code": {
                      "type": "integer",
                      "description": "Error code, consistent with the HTTP status code; 200 on success"
                    },
                    "error_msg": {
                      "type": "string",
                      "description": "Error detail"
                    },
                    "search_id": {
                      "type": "integer",
                      "description": "Unique request identifier; give it to support when reporting an issue"
                    },
                    "query_context": {
                      "type": "object",
                      "properties": {
                        "query": {
                          "type": "string",
                          "description": "The query that was actually executed"
                        }
                      }
                    },
                    "results": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          },
                          "description": "Result array"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Search AI Data",
        "tags": [
          "default"
        ],
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
          "quote": {
            "header": "X-AISA-Cost-Mode",
            "value": "quote"
          },
          "mpp": true,
          "x402": false
        },
        "x-aisa-category": "2",
        "x-aisa-passthrough": true,
        "x-aisa-pricing": {
          "cost_contract": "fixed_success",
          "customer_pricing": "fixed_success",
          "default_request_estimate_usd": 0.0048,
          "estimate_source": "profile_seed",
          "evidence_source": "request_snapshot"
        },
        "x-aisa-query-policy": {
          "ignore_undeclared": false,
          "request_wins": true
        },
        "x-aisa-revision": {
          "customer_pricing_ref": "34560fa32a84",
          "plan_policy_version": "e70a0959cd1b93b84ae16dffd7a538273ddb9c1d46277b82823c37ff1b6bc0fb",
          "profile_ref": "bc2a7e061032"
        },
        "x-aisa-status": "enabled",
        "x-aisa-upstream-path": "/v1/search",
        "x-aisa-validation": "provider",
        "x-aisa-catalog-id": "querit",
        "x-aisa-runtime-operation": {
          "operation_id": "any_querit_apis_v1_querit_search",
          "method": "ANY",
          "path": "/apis/v1/querit/search"
        },
        "requestBody": {
          "required": true,
          "description": "Top-level parameters:\nhighlights object form:\nfilters sub-object:\ntimeRange.date syntax:\nd[n] / w[n] / m[n] / y[n]: last n days / weeks / months / years, e.g. d7, m3\nYYYY-MM-DDtoYYYY-MM-DD: a range, e.g. 2022-04-01to2022-07-30; a single day uses the same to form\ngeo.countries.include allowed values: argentina, australia, brazil, canada, colombia, france, germany, india, indonesia, japan, mexico, nigeria, philippines, south korea, spain, united kingdom, united states.\nlanguages.include allowed values: english, japanese, korean, german, french, spanish, portuguese.\nvertical allowed values: code, finance. Lowercase and strictly enumerated; omit the field for universal search.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Search term. Supports long natural-language descriptions"
                  },
                  "count": {
                    "type": "integer",
                    "description": "Maximum number of results returned. Default: server default (value unspecified)."
                  },
                  "chunksPerDoc": {
                    "type": "integer",
                    "description": "Summary chunks per document. Free / PAYG support up to 1; Enterprise up to 3. Deprecated — still available, but migrate to highlights",
                    "default": 1
                  },
                  "highlights": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "query": {
                            "type": "string",
                            "description": "Keyword that guides the extraction; falls back to the top-level query when omitted"
                          },
                          "maxCharacters": {
                            "type": "integer",
                            "description": "Length of each extracted fragment, in characters, between 100 and 8000; the model picks the most suitable length when omitted",
                            "minimum": 100,
                            "maximum": 8000
                          }
                        }
                      }
                    ],
                    "description": "Request relevant fragments from the body text. true extracts against the original query at the length the model judges best; the object form takes query and maxCharacters, see below"
                  },
                  "needContent": {
                    "type": "boolean",
                    "description": "Whether to return body text. When true, body text lands in each result's sentence field (sentence array)",
                    "default": false
                  },
                  "filters": {
                    "type": "object",
                    "description": "Filter conditions, see below",
                    "properties": {
                      "sites": {
                        "type": "object",
                        "properties": {
                          "include": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Only pull results from these sites; an empty array means no restriction"
                          },
                          "exclude": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Exclude these sites"
                          }
                        }
                      },
                      "timeRange": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "description": "Time range, syntax below"
                          }
                        }
                      },
                      "geo": {
                        "type": "object",
                        "properties": {
                          "countries": {
                            "type": "object",
                            "properties": {
                              "include": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "argentina",
                                    "australia",
                                    "brazil",
                                    "canada",
                                    "colombia",
                                    "france",
                                    "germany",
                                    "india",
                                    "indonesia",
                                    "japan",
                                    "mexico",
                                    "nigeria",
                                    "philippines",
                                    "south korea",
                                    "spain",
                                    "united kingdom",
                                    "united states"
                                  ]
                                },
                                "description": "Only return results from these countries"
                              }
                            }
                          }
                        }
                      },
                      "languages": {
                        "type": "object",
                        "properties": {
                          "include": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "english",
                                "japanese",
                                "korean",
                                "german",
                                "french",
                                "spanish",
                                "portuguese"
                              ]
                            },
                            "description": "Only return results in these languages"
                          }
                        }
                      },
                      "vertical": {
                        "type": "string",
                        "description": "Vertical search. Supported values: \"code\", \"finance\"; omit for universal search",
                        "enum": [
                          "code",
                          "finance"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
