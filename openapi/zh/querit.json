  "openapi": "3.1.0",
  "paths": {
    "/apis/v1/querit/search": {
      "post": {
        "description": "Perform a search query using AI to retrieve relevant information based on the provided criteria.\n\n<!-- aisa-pricing:start -->\n公开参考价格：每次成功请求 $0.0048 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "any_querit_apis_v1_querit_search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "chunksPerDoc": {
                    "default": 1,
                    "description": "Summary chunks per document. Free / PAYG support up to 1; Enterprise up to 3. Deprecated — still available, but migrate to highlights",
                    "type": "integer"
                  },
                  "contentMaxChars": {
                    "description": "Optional body-text length limit per result, from 1 to 1,000,000 Unicode code points. Used with needContent: true; omit or send null to return the full available body text without truncation. Default: Full available body text (value unspecified).",
                    "type": "integer"
                  },
                  "count": {
                    "description": "Maximum number of results returned. Default: server default (value unspecified).",
                    "type": "integer"
                  },
                  "filters": {
                    "description": "Filter conditions, see below",
                    "properties": {
                      "geo": {
                        "properties": {
                          "countries": {
                            "properties": {
                              "include": {
                                "description": "Only return results from these countries",
                                "items": {
                                  "enum": [
                                    "argentina",
                                    "australia",
                                    "brazil",
                                    "canada",
                                    "colombia",
                                    "france",
                                    "germany",
                                    "india",
                                    "indonesia",
                                    "japan",
                                    "mexico",
                                    "nigeria",
                                    "philippines",
                                    "south korea",
                                    "spain",
                                    "united kingdom",
                                    "united states"
                                  ],
                                  "type": "string"
                                },
                                "type": "array"
                              }
                            },
                            "type": "object"
                          }
                        },
                        "type": "object"
                      },
                      "languages": {
                        "properties": {
                          "include": {
                            "description": "Only return results in these languages",
                            "items": {
                              "enum": [
                                "english",
                                "japanese",
                                "korean",
                                "german",
                                "french",
                                "spanish",
                                "portuguese",
                                "russian"
                              ],
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "sites": {
                        "properties": {
                          "exclude": {
                            "description": "Exclude these sites",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "include": {
                            "description": "Only pull results from these sites; an empty array means no restriction",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "timeRange": {
                        "properties": {
                          "date": {
                            "description": "Time range, syntax below",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "vertical": {
                        "description": "Vertical search. Supported values: \"code\", \"finance\"; omit for universal search",
                        "enum": [
                          "code",
                          "finance"
                        ],
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "highlights": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "properties": {
                          "maxCharacters": {
                            "description": "Length of each extracted fragment, in characters, between 100 and 8000; the model picks the most suitable length when omitted",
                            "maximum": 8000,
                            "minimum": 100,
                            "type": "integer"
                          },
                          "query": {
                            "description": "Keyword that guides the extraction; falls back to the top-level query when omitted",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    ],
                    "description": "Request relevant fragments from the body text. true extracts against the original query at the length the model judges best; the object form takes query and maxCharacters, see below"
                  },
                  "needContent": {
                    "default": false,
                    "description": "Whether to return body text. When true, body text lands in each result's sentence field (sentence array)",
                    "type": "boolean"
                  },
                  "query": {
                    "description": "Search term. Supports long natural-language descriptions",
                    "type": "string"
                  },
                  "rank": {
                    "description": "Ranking preference. rank.preference boosts one factor on top of the default ranking, see below. Not supported with filters.vertical: \"code\". Default: Default ranking (value unspecified).",
                    "properties": {
                      "preference": {
                        "description": "Factor to boost. Allowed values: \"relevance\" (closer match to the query), \"freshness\" (more recently published or updated). Required whenever rank is sent",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "description": "Top-level parameters:\nhighlights object form:\ncontentMaxChars body-text limit:\nThis is a top-level integer, not a field inside highlights. Only send it when you need to limit returned body text. With needContent: true and body-content access enabled, it limits the total characters across all strings in each result's sentence array, independently per result. Omit it or send null for the full available body text.\nThe limit counts Unicode code points in UTF-8 body text, preserves sentence order, and may cut the last retained sentence short. It does not include JSON formatting or separators added by your application. It does not limit snippet or highlights, and it does not change page-based billing. Use highlights.maxCharacters (100–8000) to control query-focused fragments separately.\nfilters sub-object:\ntimeRange.date syntax:\nd[n] / w[n] / m[n] / y[n]: last n days / weeks / months / years, e.g. d7, m3\nYYYY-MM-DDtoYYYY-MM-DD: a range, e.g. 2022-04-01to2022-07-30; a single day uses the same to form\ngeo.countries.include allowed values: argentina, australia, brazil, canada, colombia, france, germany, india, indonesia, japan, mexico, nigeria, philippines, south korea, spain, united kingdom, united states.\nlanguages.include allowed values: english, japanese, korean, german, french, spanish, portuguese, russian.\nvertical allowed values: code, finance. Lowercase and strictly enumerated; omit the field for universal search.\nrank sub-object:\nrank.preference is a boost, not a sort. The default ranking still dominates; results that score better on the chosen factor move up moderately. Do not assume the output is monotonic in that factor, and do not expect a result ranked far down by default to appear just because it is the freshest. Omit rank entirely to keep the default ranking.\nrank returns 400 when:\npreference is missing or empty, e.g. {\"rank\": {}} or {\"rank\": {\"preference\": \"\"}}\npreference is any value other than relevance or freshness\nit is combined with filters.vertical: \"code\" — the code vertical does not support rank yet\nrank can be combined with sort.pageAge, but freshness overlaps heavily with a time sort and adds little visible change.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cost": {
                      "description": "Optional request cost on supported HTTP 200 responses; absence means unavailable, not free",
                      "properties": {
                        "currency": {
                          "description": "Always \"USD\"; required inside cost",
                          "type": "string"
                        },
                        "total": {
                          "description": "Nonnegative charge for this request in dollars, with up to six decimal places; 0 is valid; required inside cost",
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "error_code": {
                      "description": "Error code, consistent with the HTTP status code; 200 on success",
                      "type": "integer"
                    },
                    "error_msg": {
                      "description": "Error detail",
                      "type": "string"
                    },
                    "query_context": {
                      "properties": {
                        "query": {
                          "description": "The query that was actually executed",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "results": {
                      "properties": {
                        "result": {
                          "description": "Result array",
                          "items": {
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "search_id": {
                      "description": "Unique request identifier; give it to support when reporting an issue",
                      "type": "integer"
                    },
                    "took": {
                      "description": "Server-side processing time",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Official response table. Fields on each results.result[] item: url, title, snippet, page_age (plaintext UTC+0 time), site_name, site_icon, sentence (string[], present only when needContent: true and body text is available), highlights (string[], present only when highlights is set on the request and body text is available). Every result field is optional. Some results in the same response may have no sentence or highlights. Treat a missing field as \"body text unavailable,\" not as an error."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Search AI Data",
        "tags": [
          "default"
        ],
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
          "mpp": true,
          "mpp_methods": [
            "POST"
          ],
          "quote": {
            "header": "X-AISA-Cost-Mode",
            "value": "quote"
          },
          "x402": false
        },
