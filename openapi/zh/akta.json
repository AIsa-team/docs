                      "format": "float",
                      "type": "number"
                    },
                    "data": {
                      "description": "Enriched company data keyed by section name.",
                      "type": "object"
                    },
                    "status": {
                      "example": "success",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
