    "/apis/v1/akta/list/generate/companies": {
      "post": {
        "description": "Build targeted company lists from structured filters or a natural-language query, with optional per-section enrichment.\n\n<!-- aisa-pricing:start -->\n公开参考价格：每次成功请求 $0.05 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "post_akta_list_generate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "additionalProperties": true,
                    "description": "Structured filter conditions. Use the Filter Builder API to generate valid filters. Cannot be used with query. See filter options at /api-reference/listgen-api.",
                    "type": "object"
                  },
                  "limit": {
                    "description": "Maximum companies to return. Default: 50, Max: 500",
                    "type": "integer"
                  },
                  "offset": {
                    "description": "Number of results to skip for pagination. Default: 0",
                    "type": "integer"
                  },
                  "query": {
                    "description": "Natural language search query (e.g. 'SaaS companies in the US with Series A funding'). Cannot be used with filters.",
                    "type": "string"
                  },
                  "sections": {
                    "description": "Data enrichment sections to include. Values: firmographic, business_model, company_assessment, trust_signal, company_hierarchy, digital_presence, financial_estimate, location, management_profile, product_offering, strategic_signal, customer_profile, industry, technology, funding_detail (Subscription, Enterprise), mna_and_investment (Subscription, Enterprise)",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "sort_by": {
                    "description": "Field to sort results by. Default: relevance",
                    "enum": [
                      "relevance",
                      "revenue_estimate",
                      "valuation_estimate",
                      "employee_range",
                      "total_funding",
                      "founded_year"
                    ],
                    "type": "string"
                  },
                  "sort_order": {
                    "description": "Sort direction. Default: desc",
                    "enum": [
                      "asc",
                      "desc"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response73D692Ab31Ca_ListGenerationResponse"
                }
              }
            },
            "description": "成功响应"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "List Generation",
        "tags": [
          "list-generation"
        ],
