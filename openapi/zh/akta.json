              "type": "string"
            },
            "type": "array"
          },
          "sort_by": {
            "description": "Field to sort results by. Default: relevance",
            "enum": [
              "relevance",
              "revenue_estimate",
              "valuation_estimate",
              "employee_range",
              "total_funding",
              "founded_year"
            ],
            "type": "string"
          },
          "sort_order": {
            "description": "Sort direction. Default: desc",
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
