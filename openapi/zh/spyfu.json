    "/apis/v1/spyfu/google-domain-paid-keywords": {
      "get": {
        "description": "rows carry keyword, searchVolume, liveSearchVolume, rankingDifficulty, totalMonthlyClicks, broad/phrase/exactCostPerClick, broad/phrase/exactMonthlyCost, paidCompetitors, distinctCompetitors and serpFeaturesCsv. Note the path segment is `keyword_api`, unlike the other PPC endpoints which live under `serp_api`.",
        "operationId": "spyfu.google-domain-paid-keywords",
        "parameters": [
          {
            "in": "query",
            "name": "adultFilter",
            "required": false,
            "schema": {
              "description": "default true — filters adult keywords out",
              "type": "boolean"
            }
