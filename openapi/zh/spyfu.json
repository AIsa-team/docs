            "examples": {
              "default": {
                "value": 1
              },
              "minimal": {
                "value": 1
              }
            },
            "in": "query",
            "name": "pastNMonths",
            "required": true,
            "schema": {
              "description": "how many recent months to return, ONE ROW PER MONTH. Ask for 1 unless you need the trend",
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            }
          }
