    "/apis/v1/spyfu/google-domain-overview": {
      "get": {
        "description": "`/apis/domain_stats_api/v2/getAllDomainStats` is the same report over the domain's ENTIRE\nhistory — one row per month since SpyFu started tracking it, which for an old domain is\n150+ billable rows from a call that looks parameterless. That full-history variant is what\ntreg's registry probes; prefer this endpoint with an explicit `pastNMonths` for real work.",
        "operationId": "spyfu.google-domain-overview",
        "parameters": [
          {
            "in": "query",
            "name": "countryCode",
            "required": false,
            "schema": {
              "description": "two-letter code from SpyFu's 28-value enum; default US",
              "examples": [
                "US"
              ],
              "type": "string"
            }
          },
          {
            "examples": {
              "default": {
                "value": "example.com"
              },
              "minimal": {
                "value": "example.com"
              }
            },
            "in": "query",
            "name": "domain",
            "required": true,
            "schema": {
              "description": "bare domain, no scheme",
              "minLength": 1,
              "type": "string"
            }
          },
