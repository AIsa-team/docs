            "required": false,
            "schema": {
              "description": "restrict to ads that ran on keywords matching this",
              "type": "string"
            }
          },
          {
            "examples": {
              "default": {
                "value": 1
              },
              "minimal": {
                "value": 1
              }
            },
            "in": "query",
            "name": "pageSize",
            "required": true,
            "schema": {
              "description": "1 to 10,000, DEFAULT 5.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
