                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-09-15T21:47:56Z.",
                    "value": {
                      "description": "Guidant’s patented technology enables cemeteries to sell cemetery property and other products completely online from their own website, offering a seamless, consumer-friendly e-commerce experience. \n\nFor consumers, it gives them the capability to search, shop, and purchase cemetery property directly from the cemetery’s website. The experience is quick, convenient, and completely on their terms. It’s as simple as booking a seat on an airplane or buying a ticket to the ballgame. Guidant enables cemeteries to give their families an easy, transparent way to make choices that feel right for them.\n\nSell 24/7 - Families can browse, select, and purchase property any time - even after hours.\n\nCapture Customers You Never See In-Person - Convert online shoppers, pre-need planners, and out-of-town families who prefer to buy digitally.\n\nSave Staff Time - Reduce the manual process and payment tracking so your team can focus on family service and customer support.\n\nDeliver a Modern Experience - Offer families an online buying experience from the comfort of their own home at their own pace.",
                      "employee_count": 8,
                      "industries": [
                        "eCommerce",
                        "Information Technology",
                        "Marketing Tech",
                        "Software",
                        "Analytics",
                        "Business Intelligence",
                        "Consulting"
                      ],
