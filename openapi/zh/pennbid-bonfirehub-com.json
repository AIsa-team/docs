  "paths": {
    "/apis/v1/pennbid-bonfirehub-com/public-tenders/get-opportunity": {
      "post": {
        "description": "Resolve a PennBid ProjectID or a pasted https://pennbid.bonfirehub.com/opportunities/... URL to its listing record and learn whether it is still open or already closed/awarded.",
        "operationId": "pennbid-bonfirehub-com.public-tenders.get-opportunity",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "description": "Bonfire ProjectID, as in the listings. Exactly one of `project_id` and `url`. Pattern: ^[0-9]{1,12}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "url": {
                    "type": "string",
                    "description": "Detail URL: https://pennbid.bonfirehub.com/opportunities/{ProjectID} or https://pennbid.bonfirehub.com/opportunities/private/{PrivateProjectID}.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "project_id": "252422"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One PennBid opportunity's public listing record, found by Bonfire ProjectID or by a pasted detail URL (/opportunities/{ProjectID} or /opportunities/private/{PrivateProjectID}): name, awarding agency reference, status ids, closing date (UTC), award flag and which list (open or past) it sits in. Searches the open list first, then the full past list; an id in neither is `not_found`. The detail page (statement of work, open/questions dates, documents, Q&A, bid results) is behind a Cloudflare managed challenge and is not read by this version.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `date_close` | string | Closing instant in UTC. |\n| `department_id` | string |  |\n| `is_public_award` | boolean | Bonfire IsPublicAward from the past list (the award decision is published); null for open opportunities, which carry no such flag. |\n| `listing` | string | Which public list the record came from: `open` (accepting submissions) or `past` (closed). |\n| `name` | string |  |\n| `observed_at_ms` | number |  |\n| `private_project_id` | string |  |\n| `project_id` | string |  |\n| `reference` | string | Awarding agency and county as PennBid fills Bonfire's ReferenceID. |\n| `status_id` | number | Bonfire ProjectStatusID as stated (3, 4, 5 observed); labels are not resolved here. |\n| `sub_status_id` | number |  |\n| `url` | string |  |\n| `visibility_id` | number |  |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-10-10.",
                    "value": {
                      "date_close": "2026-10-09T14:00:00Z",
                      "department_id": "8474",
                      "is_public_award": false,
                      "listing": "past",
                      "name": "Myra Avenue Sanitary Sewer Replacement",
                      "observed_at_ms": 1791621367569,
                      "private_project_id": "1adbb1d04515cb0eedf5269bec556103",
                      "project_id": "252422",
                      "reference": "Yeadon Borough, Delaware County",
                      "status_id": 3,
                      "sub_status_id": 1,
                      "url": "https://pennbid.bonfirehub.com/opportunities/252422",
                      "visibility_id": 1
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
