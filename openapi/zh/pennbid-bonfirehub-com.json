    "/apis/v1/pennbid-bonfirehub-com/public-tenders/list-open-opportunities": {
      "post": {
        "description": "Find currently open bids/RFPs on PennBid by keyword (project name or awarding agency) or closing window, then pass `project_id` to `get_opportunity`.",
        "operationId": "pennbid-bonfirehub-com.public-tenders.list-open-opportunities",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "closing_from": {
                    "type": "string",
                    "description": "Keep opportunities closing at or after this UTC instant. A date alone means the start of that day (00:00:00Z). Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "closing_to": {
                    "type": "string",
                    "description": "Keep opportunities closing at or before this UTC instant. A date alone means the end of that day (23:59:59Z). Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "limit": {
                    "type": "number",
                    "description": "Page size applied locally (default 50).\n\nProvider reference: minimum 1; maximum 200; default 50.",
                    "default": 50,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 200
                    }
                  },
                  "offset": {
                    "type": "number",
                    "description": "Zero-based position in the filtered, sorted list; pass `next_offset` from the previous page.\n\nProvider reference: minimum 0; default 0.",
                    "default": 0,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 0
                    }
                  },
                  "q": {
                    "type": "string",
                    "description": "Case-insensitive substring matched against the project name and the reference (awarding agency / county) text.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "limit": 5,
                    "q": "Lancaster"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Open (accepting submissions) public opportunities on PennBid, from the portal's JSON listing endpoint. The upstream endpoint returns the complete list in one response and accepts no parameters; the text filter, date window and paging are applied by this program. Sorted by closing date ascending, then project id. All dates are UTC (ISO 8601 `Z`), converted from the portal's UTC database strings.\n\nThe response contains the tool result directly.\n\nThe provider identifies `items` as the primary payload key.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `date_close` | string | Closing instant in UTC. |\n| `department_id` | string | Bonfire DepartmentID; the portal publishes no department lookup table for this tenant. |\n| `name` | string |  |\n| `private_project_id` | string | Bonfire PrivateProjectID; alternate detail URL /opportunities/private/{id}. |\n| `project_id` | string | Bonfire ProjectID; the key for `get_opportunity` and the detail URL. |\n| `reference` | string | Bonfire ReferenceID as PennBid fills it: the awarding agency and county, free text (not a bid number). |\n| `status_id` | number | Bonfire ProjectStatusID as stated by the portal (2 observed for open projects); labels are rendered client-side and are not resolved here. |\n| `sub_status_id` | number |  |\n| `url` | string | Public detail page https://pennbid.bonfirehub.com/opportunities/{project_id}. |\n| `visibility_id` | number |  |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
