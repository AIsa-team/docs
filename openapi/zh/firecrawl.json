                      "type": "string",
                      "format": "uri"
                    },
                    "minItems": 1,
                    "maxItems": 1000,
                    "description": "1 到 1000 个唯一的 HTTPS URL 用于抓取。不支持 PDF URL。",
                    "example": [
                      "https://docs.firecrawl.dev",
                      "https://docs.firecrawl.dev/introduction"
                    ]
                  },
                  "maxConcurrency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "description": "并发抓取数的上限（1 到 20）。"
                  },
                  "onlyMainContent": {
                    "type": "boolean",
                    "description": "只返回每个页面的正文内容。",
                    "default": true
