{
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "properties": {
          "frequency_penalty": {
            "default": 1,
            "description": "根据新词元目前在文本中的出现频率对其施加惩罚。正值会降低逐字重复同一行的可能性。",
            "maximum": 2,
            "minimum": 0,
            "type": "number"
          },
          "max_tokens": {
            "description": "响应中要生成的最大词元数。",
            "type": "integer"
          },
          "messages": {
            "description": "由截至目前的对话内容组成的消息列表。",
            "items": {
              "properties": {
                "content": {
                  "description": "消息内容。",
                  "type": "string"
                },
                "role": {
                  "description": "消息作者的角色。",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "model": {
            "description": "要使用的 Sonar 模型。",
            "enum": [
              "sonar",
              "sonar-pro",
              "sonar-reasoning-pro",
              "sonar-deep-research"
            ],
            "type": "string"
          },
          "presence_penalty": {
            "default": 0,
            "description": "根据新词元此前是否已出现在文本中对其施加惩罚。正值会提高谈论新主题的可能性。",
            "maximum": 2,
            "minimum": -2,
            "type": "number"
          },
          "return_citations": {
            "default": true,
            "description": "是否在响应中返回引用和搜索结果。",
            "type": "boolean"
          },
          "search_context": {
            "default": "low",
            "description": "控制使用的搜索上下文量。会影响单次请求的成本。",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "search_domain_filter": {
            "description": "将搜索限制在特定域名。",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "search_recency_filter": {
            "description": "按时效性筛选搜索结果。",
            "enum": [
              "month",
              "week",
              "day",
              "hour"
            ],
            "type": "string"
          },
          "stream": {
            "default": false,
            "description": "是否使用服务器发送事件以流式方式返回响应。",
            "type": "boolean"
          },
          "temperature": {
            "default": 0.2,
            "description": "介于 0 和 2 之间的采样温度。较低的值会使输出更集中且更具确定性。",
            "maximum": 2,
            "minimum": 0,
            "type": "number"
          },
          "top_k": {
            "default": 0,
            "description": "用于 top-k 筛选的保留词元数。",
            "maximum": 2048,
            "minimum": 0,
            "type": "integer"
          },
          "top_p": {
            "default": 0.9,
            "description": "核采样参数。模型会考虑累计概率质量达到 top_p 的词元。",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "type": "object"
      },
      "ChatCompletionResponse": {
        "properties": {
          "choices": {
            "items": {
              "properties": {
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length"
                  ],
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "message": {
                  "properties": {
                    "content": {
                      "description": "AI 生成的答案，包含类似 [1][2] 的内联引用。",
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "citations": {
            "description": "答案中引用的来源 URL 列表。",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created": {
            "description": "补全创建时间的 Unix 时间戳。",
            "type": "integer"
          },
          "id": {
            "description": "补全结果的唯一标识符。",
            "type": "string"
          },
          "model": {
            "description": "用于生成补全内容的模型。",
            "type": "string"
          },
          "object": {
            "example": "chat.completion",
            "type": "string"
          },
          "search_results": {
            "description": "包含标题、摘要和 URL 的详细搜索结果。",
            "items": {
              "properties": {
                "date": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "usage": {
            "properties": {
              "completion_tokens": {
                "type": "integer"
              },
              "prompt_tokens": {
                "type": "integer"
              },
              "search_context_size": {
                "type": "string"
              },
              "total_tokens": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Perplexity Sonar API——内置网页搜索功能的 LLM。返回 AI 生成的答案，并附有网页来源引用。",
    "title": "Perplexity Sonar API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {},
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://api.aisa.one/apis/v1"
    }
  ]
}
