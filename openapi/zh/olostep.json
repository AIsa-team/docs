    "/apis/v1/olostep/web-scrape": {
      "post": {
        "description": "This is the fixed one-credit surface. Olostep parsers and LLM extraction are not accepted by this catalog tool; a team can call them directly through its own raw Olostep tool.\n\n<!-- aisa-pricing:start -->\n当前未提供请求参考价格；请使用接口支持的报价功能确认费用。 声明的单位费率：每 provider_credit $0.000001 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "olostep.web-scrape",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "formats": {
                    "description": "Structured parsers, JSON extraction and llm_extract are deliberately excluded because they have separate variable credit prices.",
                    "items": {
                      "enum": [
                        "markdown"
                      ],
                      "type": "string"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                  },
                  "links_on_page": {
                    "properties": {
                      "exclude_links": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "include_links": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "query_to_order_links_by": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "max_age": {
                    "default": 0,
                    "description": "Reuse an Olostep scrape no older than this many seconds; 0 requests a fresh scrape.",
                    "maximum": 604800,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "remove_images": {
                    "default": false,
                    "type": "boolean"
                  },
                  "transformer": {
                    "enum": [
                      "postlight",
                      "none"
                    ],
                    "type": "string"
                  },
                  "url_to_scrape": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "formats",
                  "url_to_scrape"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
