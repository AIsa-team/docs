    "/apis/v1/olostep/web-map-search": {
      "post": {
        "description": "Olostep bills one credit for the first 1,000 returned URLs and another credit per additional 1,000. Requiring top_n <= 1,000 makes the platform hold exact. Unbounded mapping is available through a team's own raw Olostep tool.\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.002 USD（不是固定价格）。 声明的单位费率：每 provider_credit $0.000001 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "olostep.web-map-search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "exclude_urls": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "include_subdomain": {
                    "default": true,
                    "type": "boolean"
                  },
                  "include_urls": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "search_query": {
                    "examples": [
                      "billing and credit documentation"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "top_n": {
                    "description": "The 1,000-URL cap keeps this request inside Olostep's first one-credit map band.",
                    "examples": [
                      10
                    ],
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "url": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "search_query",
                  "top_n",
                  "url"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet."
