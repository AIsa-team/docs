    "/pinterest/pin": {
      "get": {
        "tags": [
          "Pinterest API"
        ],
        "operationId": "get_pinterest-pin",
        "summary": "固定",
        "description": "按 URL 获取单个 Pinterest Pin 的详细信息，返回 title、description、link、dominantColor、originPinner、pinner、多种分辨率的图片（imageSpec_236x 至 imageSpec_orig），以及包含视觉标注的 pinJoin。支持 trim 选项以返回更精简的响应。",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Pinterest Pin URL",
            "schema": {
              "type": "string"
            },
            "example": "https://www.pinterest.com/pin/1124351863225567517/"
          },
          {
            "name": "trim",
            "in": "query",
            "required": false,
            "description": "设为 true 以返回精简版响应",
            "schema": {
              "type": "boolean"
            },
            "example": "false"
          },
          {
            "$ref": "#/components/parameters/XAISACostMode"
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应. 当请求带有 `X-AISA-Cost-Mode: quote` 时，HTTP 200 返回 `cost_estimate`，不会执行该操作。该报价不是预留、授权或锁价。",
            "content": {
              "application/json": {
