  "paths": {
    "/apis/v1/california-dca-license/licenses/physician": {
      "post": {
        "description": "Check the DCA status code and expiry for an exact California physician-and-surgeon license rank and number; a status alone does not establish permission to practice.\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.0005 USD（不是固定价格）。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "california-dca-license.licenses.physician",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "licRank": {
                    "type": "string",
                    "description": "Physician-and-surgeon license rank from DCA (A, C or G).\n\nProvider reference: allowed values [\"A\", \"C\", \"G\"]."
                  },
                  "licNumber": {
                    "type": "string",
                    "description": "Numeric license number without rank prefix or leading zeros."
                  }
                },
                "required": [
                  "licNumber",
                  "licRank"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One exact-rank license, or found=false if that exact type/rank/number was not returned. DCA may return other ranks for the number; other_ranks_returned warns about those records without attributing them to this licensee. Status codes are reported as DCA supplies them; only codes 20 and 65 have a verified label. This does not verify eligibility to practice.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `found` | boolean |  |\n| `license` | object | Exact matching record, or null. Includes type, rank, number, current DCA name fields when present, the uninterpreted privateName marker, issue/expiration dates, DCA status code, a label for known codes and whether other ranks were returned. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Physician",
