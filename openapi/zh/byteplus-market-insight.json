                  },
                  "Config": {
                    "additionalProperties": true,
                    "description": "TaskName and RuleExpression are required and must be nonblank. Config fields follow Go JSON case-insensitive matching and last-value behavior; additional provider fields are forwarded. Required-field, whitespace and byte checks apply in the runtime validator.",
