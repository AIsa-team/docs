    "/apis/v1/delaware-gov/entities/search": {
      "post": {
        "description": "You know an entity name or a Delaware file number and need the matching registrations and their file numbers; follow up with `entity` for the free details.",
        "operationId": "delaware-gov.entities.search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "file_number": {
                    "type": "string",
                    "description": "Delaware file number (digits only, e.g. 6872331). Exactly one of `name` or `file_number`. Pattern: ^[0-9]{1,10}$."
                  },
                  "name": {
                    "type": "string",
                    "description": "Entity name or name fragment. Wrap the whole name in double quotes for the site's exact-name search. Exactly one of `name` or `file_number`."
                  }
                },
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "file_number": {}
                        },
                        "required": [
                          "file_number"
                        ]
                      },
                      {
                        "properties": {
                          "name": {}
                        },
                        "required": [
                          "name"
                        ]
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "name": "sideguide"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search the Delaware ICIS entity registry by entity name (substring, case-insensitive; wrap the name in double quotes for the site's exact-name search) or by file number. Returns up to 50 rows of file number and entity name; the site caps a query at 50 rows without pagination, reported as `truncated: true` with the site's notice. No legal status is included (the site sells that separately).\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `count` | number | Rows returned (0 when the site reports 'No Records Found.'). |\n| `entities` | object[] |  |\n| `notice` | string | The site's result message verbatim ('No Records Found.', the 50-row cap notice), null when the site shows none. |\n| `observed_at_ms` | number |  |\n| `query` | object |  |\n| `source` | string |  |\n| `status_included` | boolean | Always false: current legal status is a paid lookup on the site and is never fetched. |\n| `truncated` | boolean | true when the site reports that the query exceeded its 50-row cap; refine the name to see the rest. The site has no pagination. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-09-24.",
                    "value": {
                      "count": 3,
                      "entities": [
                        {
                          "details_available": true,
                          "file_number": "5271344",
                          "name": "SIDEGUIDE INC."
                        },
                        {
                          "details_available": true,
                          "file_number": "7063563",
                          "name": "SIDE GUIDE SPORTS LLC"
                        },
                        {
                          "details_available": true,
                          "file_number": "6872331",
                          "name": "SIDEGUIDE TECHNOLOGIES INC."
                        }
                      ],
                      "notice": null,
                      "observed_at_ms": 1790283762263,
                      "query": {
                        "file_number": null,
                        "name": "sideguide"
                      },
                      "source": "https://icis.corp.delaware.gov/ecorp/entitysearch/NameSearch.aspx",
                      "status_included": false,
                      "truncated": false
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "搜索",
        "tags": [
