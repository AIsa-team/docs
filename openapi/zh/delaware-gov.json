                            "850 New Burton Road, Suite 201"
                          ],
                          "city": "Dover",
                          "county": "Kent County",
                          "email": "delaware.orders@cogencyglobal.com",
                          "fax": "(800)253-5177",
                          "name": "Cogency Global Inc.",
                          "phone": "(800)483-1140",
                          "postal_code": "19904",
                          "state": "DE",
                          "website": "http://www.cogencyglobal.com"
                        }
                      ],
                      "count": 1,
                      "observed_at_ms": 1790283785750,
                      "query": "cogency",
