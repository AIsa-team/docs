    "/apis/v1/delaware-gov/entities/registered-agents": {
      "post": {
        "description": "You need the contact details of a Delaware registered agent named on an entity record, or the full list of agents the Division publishes.",
        "operationId": "delaware-gov.entities.registered-agents",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Optional case-insensitive substring to match against the agent name. Omit for the whole list.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "query": "cogency"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The Delaware Division of Corporations' list of registered agents (corp.delaware.gov/agents/, one static page, about 110 agents): name, street address lines, city, state, postal code, county, phone, fax, email and website as the Division publishes them. Optional case-insensitive substring filter on the agent name.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `agents` | object[] |  |\n| `count` | number | Agents returned after the filter. |\n| `observed_at_ms` | number |  |\n| `query` | string |  |\n| `source` | string |  |\n| `total` | number | Agents on the Division's page before filtering. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-09-24.",
