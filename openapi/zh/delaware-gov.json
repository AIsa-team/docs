    "/apis/v1/delaware-gov/entities/entity": {
      "post": {
        "description": "You have a Delaware file number (from `search` or a filing) and need the registration record and registered agent.",
        "operationId": "delaware-gov.entities.entity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "file_number": {
                    "type": "string",
                    "description": "Delaware file number, digits only (e.g. 6872331). Pattern: ^[0-9]{1,10}$."
                  }
                },
                "required": [
                  "file_number"
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "file_number": "6872331"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Free Delaware entity details for one file number (the ICIS 'Entity Details' page reached through the search postback): entity name, incorporation/formation date (M/D/YYYY as the site prints it), entity kind and type, residency, state, and the registered agent's name, address, city, county, state, postal code and phone. The site's paid status, franchise tax and filing history are not fetched. Fails with not_found when the registry reports 'No Records Found.' for the file number.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `file_number` | string |  |\n| `incorporation_date` | string | Incorporation / formation date as printed by the site (M/D/YYYY); null when the site leaves the field empty. |\n| `incorporation_date_format` | string |  |\n| `kind` | string | Entity kind (e.g. Corporation, Limited Liability Company). |\n| `name` | string |  |\n| `observed_at_ms` | number |  |\n| `registered_agent` | object |  |\n| `residency` | string | Domestic or Foreign. |\n| `source` | string |  |\n| `state` | string | Jurisdiction of formation as printed (e.g. DELAWARE). |\n| `status_included` | boolean | Always false: legal status, tax and history are paid lookups on the site and are never fetched. |\n| `type` | string | Entity type (e.g. General, Public Benefit Corporation). |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-09-24.",
                    "value": {
                      "file_number": "6872331",
                      "incorporation_date": "6/22/2022",
                      "incorporation_date_format": "M/D/YYYY",
                      "kind": "Corporation",
                      "name": "SIDEGUIDE TECHNOLOGIES INC.",
                      "observed_at_ms": 1790283773379,
                      "registered_agent": {
                        "address": "850 NEW BURTON ROAD SUITE 201",
                        "city": "DOVER",
                        "county": "Kent",
                        "name": "COGENCY GLOBAL INC.",
                        "phone": "800-483-1140",
                        "postal_code": "19904",
                        "state": "DE"
                      },
                      "residency": "Domestic",
                      "source": "https://icis.corp.delaware.gov/ecorp/entitysearch/NameSearch.aspx",
                      "state": "DELAWARE",
                      "status_included": false,
                      "type": "General"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
