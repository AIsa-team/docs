    "/apis/v1/waveinflu/similar": {
      "post": {
        "description": "Finds creators similar to a seed account on Instagram, TikTok, or YouTube. `platform` and `target_account` are required; add `limit` (1–100, default 40) and optional `filters` (regions, languages, follower and play-count ranges, gender, ethnicity, creator type, face visibility, workspace dedup). Each match returns a rich profile: `biography`, `email`, `followerCount`, `averagePlayCount` / `medianPlayCount`, `averageEngagementRate` / `medianEngagementRate`, plus AI-inferred `gender`, `ageRange`, `ethnicity`, `faceVisibility`, `accountPositioning` tags, and an `aiDescription`, with a relevance `score`. Results are sorted by `score` descending. Billing is per delivered creator (`data.count`).\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.124425 USD（不是固定价格）。 声明的单位费率：每 similar_creator_point $0.004977 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "post_waveinflu_similar_creators",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "description": "Optional filters applied before matching. All fields are optional.",
                    "properties": {
                      "creatorTypes": {
                        "description": "Creator account types, e.g. [\"individual\", \"brand\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "ethnicities": {
                        "description": "Inferred creator ethnicities.",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "faceVisibilities": {
                        "description": "Face-visibility classifications, e.g. [\"clear_face\", \"mixed\", \"no_face\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "genders": {
                        "description": "Inferred creator genders, e.g. [\"female\", \"male\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "languages": {
                        "description": "创作者语言，例如 [\"en\", \"ja\", \"zh-cn\"]。",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "maxFollowers": {
                        "description": "最大关注者/订阅者数量。",
                        "type": "number"
                      },
                      "maxPlayCount": {
                        "description": "Maximum play / view count, measured by `playCountMetric`.",
                        "type": "number"
                      },
                      "minFollowers": {
                        "description": "最小关注者/订阅者数量。",
                        "type": "number"
                      },
                      "minPlayCount": {
                        "description": "Minimum play / view count, measured by `playCountMetric`.",
                        "type": "number"
                      },
                      "playCountMetric": {
                        "description": "Whether `minPlayCount` / `maxPlayCount` are compared against the median or the average play count.",
                        "enum": [
                          "median",
                          "average"
                        ],
                        "type": "string"
                      },
                      "regions": {
                        "description": "Creator regions (ISO country codes), e.g. [\"US\", \"GB\", \"JP\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "workspaceDeduplicationEnabled": {
                        "description": "When true, creators already saved in your workspace are excluded from the results.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "limit": {
                    "default": 25,
                    "description": "Maximum number of creators to return. Default 25, range 1–100. Caps the billed count.",
                    "example": 10,
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "platform": {
                    "default": "youtube",
                    "description": "Target platform.",
                    "enum": [
                      "instagram",
                      "tiktok",
                      "youtube"
                    ],
                    "example": "instagram",
                    "type": "string"
                  },
                  "target_account": {
                    "description": "Seed account: a creator handle (with or without @) or profile URL to find similar creators for.",
                    "example": "@onkimia",
                    "type": "string"
                  }
                },
                "required": [
                  "target_account"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
