  "paths": {
    "/apis/v1/waveinflu/ai-search": {
      "post": {
        "description": "Finds creators from a natural-language brief instead of a seed account. `platform` and `query` are required; add `limit` (1–100, default 40) and the same optional `filters` as Similar Creators. Describe the creators you want in plain language (for example, \"beauty creators in the US\") and the response returns matching creators in the same rich shape as Similar Creators — full profile metrics plus AI-inferred `gender`, `ageRange`, `ethnicity`, `faceVisibility`, `accountPositioning`, `aiDescription`, and a relevance `score`. Billing is per delivered creator (`data.count`).\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.124425 USD（不是固定价格）。 声明的单位费率：每 similar_creator_point $0.004977 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "post_waveinflu_ai_search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "description": "Optional filters applied before matching. All fields are optional.",
                    "properties": {
                      "creatorTypes": {
                        "description": "Creator account types, e.g. [\"individual\", \"brand\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "ethnicities": {
                        "description": "Inferred creator ethnicities.",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "faceVisibilities": {
                        "description": "Face-visibility classifications, e.g. [\"clear_face\", \"mixed\", \"no_face\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "genders": {
                        "description": "Inferred creator genders, e.g. [\"female\", \"male\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "languages": {
                        "description": "创作者语言，例如 [\"en\", \"ja\", \"zh-cn\"]。",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "maxFollowers": {
                        "description": "最大关注者/订阅者数量。",
                        "type": "number"
                      },
                      "maxPlayCount": {
                        "description": "Maximum play / view count, measured by `playCountMetric`.",
                        "type": "number"
                      },
                      "minFollowers": {
                        "description": "最小关注者/订阅者数量。",
                        "type": "number"
                      },
                      "minPlayCount": {
                        "description": "Minimum play / view count, measured by `playCountMetric`.",
                        "type": "number"
                      },
                      "playCountMetric": {
                        "description": "Whether `minPlayCount` / `maxPlayCount` are compared against the median or the average play count.",
                        "enum": [
                          "median",
                          "average"
                        ],
                        "type": "string"
                      },
                      "regions": {
                        "description": "Creator regions (ISO country codes), e.g. [\"US\", \"GB\", \"JP\"].",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "workspaceDeduplicationEnabled": {
                        "description": "When true, creators already saved in your workspace are excluded from the results.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "limit": {
                    "default": 25,
                    "description": "Maximum number of creators to return. Default 25, range 1–100. Caps the billed count.",
                    "example": 10,
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "platform": {
                    "default": "youtube",
                    "description": "Target platform.",
                    "enum": [
                      "instagram",
                      "tiktok",
                      "youtube"
                    ],
                    "example": "instagram",
                    "type": "string"
                  },
                  "query": {
                    "description": "Natural-language description of the creators you are looking for.",
                    "example": "beauty creators in the US",
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "billingRequestId": {
                      "description": "Billing reference for this call, linked to your usage log.",
                      "example": "3f522b56-2bb4-426c-9b76-5c04c91a9cb3",
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ResponseEb32A34A5274_CreatorSearchData"
                    },
                    "requestId": {
                      "description": "用于支持和监控的请求 ID。",
                      "example": "req-b6l",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Creators returned"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Creator AI Search",
        "tags": [
          "default"
        ],
