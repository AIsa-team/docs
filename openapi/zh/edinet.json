        },
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "examples": [
                "2026-07-23"
              ]
            },
            "description": "文件日期，格式为 YYYY-MM-DD。"
          },
