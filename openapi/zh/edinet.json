  "paths": {
    "/apis/v1/edinet/documents.json": {
      "get": {
        "description": "{\"methods\":[{\"methodType\":\"GET\",\"methodDesc\":\"Query the EDINET filing list for a given file date. Returns metadata only when type=1, or metadata plus filing results when type=2.\",\"requestParams\":[{\"paramName\":\"date\",\"paramType\":\"query\",\"required\":true,\"desc\":\"File date in YYYY-MM-DD format.\"},{\"paramName\":\"type\",\"paramType\":\"query\",\"desc\":\"Response mode: 1 for metadata only, 2 for metadata plus filing list. Defaults to 1 when omitted.\"},{\"paramName\":\"Subscription-Key\",\"paramType\":\"query\",\"required\":true,\"desc\":\"EDINET API key passed as a query parameter.\"}],\"responseParams\":[{\"paramName\":\"metadata\",\"desc\":\"Metadata object with title, request parameter echo, result count, processDateTime, status, and message.\"},{\"paramName\":\"results\",\"desc\":\"Array of filing document objects when type=2, including fields such as seqNumber, docID, filerName, docTypeCode, submitDateTime, and file availability flags.\"}]}]}\n\n<!-- aisa-pricing:start -->\n公开参考价格：每次成功请求 $0.00001 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "get_edinet_documents",
        "parameters": [
          {
            "description": "文件日期，格式为 YYYY-MM-DD。",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "examples": [
                "2026-07-23"
              ],
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "响应模式：1 仅返回元数据，2 返回元数据加申报列表。",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "default": 1,
              "enum": [
                1,
                2
              ],
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "metadata": {
                      "description": "元数据对象，包含标题、请求参数回显、结果数量、processDateTime、status 和 message。",
                      "type": "object"
                    },
                    "results": {
                      "description": "type=2 时返回的申报文档对象。",
                      "items": {
                        "properties": {
                          "docID": {
                            "type": "string"
                          },
                          "docTypeCode": {
                            "type": "string"
                          },
                          "filerName": {
                            "type": "string"
                          },
                          "seqNumber": {
                            "type": "integer"
                          },
                          "submitDateTime": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "EDINET 文档列表响应。"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Document List API",
        "tags": [
          "default"
        ],
