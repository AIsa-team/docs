  "paths": {
    "/apis/v1/edinet/documents.json": {
      "get": {
        "description": "{\"methods\":[{\"methodType\":\"GET\",\"methodDesc\":\"Query the EDINET filing list for a given file date. Returns metadata only when type=1, or metadata plus filing results when type=2.\",\"requestParams\":[{\"paramName\":\"date\",\"paramType\":\"query\",\"required\":true,\"desc\":\"File date in YYYY-MM-DD format.\"},{\"paramName\":\"type\",\"paramType\":\"query\",\"desc\":\"Response mode: 1 for metadata only, 2 for metadata plus filing list. Defaults to 1 when omitted.\"},{\"paramName\":\"Subscription-Key\",\"paramType\":\"query\",\"required\":true,\"desc\":\"EDINET API key passed as a query parameter.\"}],\"responseParams\":[{\"paramName\":\"metadata\",\"desc\":\"Metadata object with title, request parameter echo, result count, processDateTime, status, and message.\"},{\"paramName\":\"results\",\"desc\":\"Array of filing document objects when type=2, including fields such as seqNumber, docID, filerName, docTypeCode, submitDateTime, and file availability flags.\"}]}]}",
        "operationId": "getEdinetDocuments",
        "responses": {
          "200": {
            "description": "EDINET 文档列表响应。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "metadata": {
                      "type": "object",
                      "description": "元数据对象，包含标题、请求参数回显、结果数量、processDateTime、status 和 message。"
                    },
                    "results": {
                      "type": "array",
                      "description": "type=2 时返回的申报文档对象。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "seqNumber": {
                            "type": "integer"
                          },
                          "docID": {
                            "type": "string"
                          },
                          "filerName": {
                            "type": "string"
                          },
                          "docTypeCode": {
                            "type": "string"
                          },
                          "submitDateTime": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Document List API",
        "tags": [
          "default"
        ],
