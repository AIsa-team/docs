    "/apis/v1/edinet/documents/{docID}": {
      "get": {
        "description": "{\"methods\":[{\"methodType\":\"GET\",\"methodDesc\":\"Download a specific EDINET document by docID. The returned file type is selected by the type query parameter and the actual success payload must be interpreted from Content-Type.\",\"requestParams\":[{\"paramName\":\"docID\",\"paramType\":\"path\",\"required\":true,\"desc\":\"Document management identifier from the document list API, for example S1234567.\"},{\"paramName\":\"type\",\"paramType\":\"query\",\"required\":true,\"desc\":\"File type to download: 1 for filing body and audit report ZIP, 2 for PDF, 3 for alternate document and attachments ZIP, 4 for English document ZIP, 5 for CSV ZIP converted from XBRL.\"},{\"paramName\":\"Subscription-Key\",\"paramType\":\"query\",\"required\":true,\"desc\":\"EDINET API key passed as a query parameter.\"}],\"responseParams\":[{\"paramName\":\"Content-Type\",\"desc\":\"Response MIME type. application/octet-stream indicates ZIP, application/pdf indicates PDF, and application/json; charset=utf-8 indicates an error JSON response.\"},{\"paramName\":\"content\",\"desc\":\"Binary ZIP or PDF file content on success.\"},{\"paramName\":\"message\",\"desc\":\"Error message when the response body is JSON.\"}]}]}",
        "operationId": "getEdinetDocumentDownload",
        "responses": {
          "200": {
            "description": "根据 Content-Type，返回二进制 ZIP/PDF 文件内容或 JSON 错误载荷。",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Document Download API",
        "tags": [
          "default"
        ],
