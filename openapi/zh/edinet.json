    "/apis/v1/edinet/documents/{docID}": {
      "get": {
        "description": "{\"methods\":[{\"methodType\":\"GET\",\"methodDesc\":\"Download a specific EDINET document by docID. The returned file type is selected by the type query parameter and the actual success payload must be interpreted from Content-Type.\",\"requestParams\":[{\"paramName\":\"docID\",\"paramType\":\"path\",\"required\":true,\"desc\":\"Document management identifier from the document list API, for example S1234567.\"},{\"paramName\":\"type\",\"paramType\":\"query\",\"required\":true,\"desc\":\"File type to download: 1 for filing body and audit report ZIP, 2 for PDF, 3 for alternate document and attachments ZIP, 4 for English document ZIP, 5 for CSV ZIP converted from XBRL.\"},{\"paramName\":\"Subscription-Key\",\"paramType\":\"query\",\"required\":true,\"desc\":\"EDINET API key passed as a query parameter.\"}],\"responseParams\":[{\"paramName\":\"Content-Type\",\"desc\":\"Response MIME type. application/octet-stream indicates ZIP, application/pdf indicates PDF, and application/json; charset=utf-8 indicates an error JSON response.\"},{\"paramName\":\"content\",\"desc\":\"Binary ZIP or PDF file content on success.\"},{\"paramName\":\"message\",\"desc\":\"Error message when the response body is JSON.\"}]}]}\n\n<!-- aisa-pricing:start -->\n公开参考价格：每次成功请求 $0.00001 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "get_edinet_document_download",
        "parameters": [
          {
            "description": "来自文档列表 API 的文档管理标识符。",
            "in": "path",
            "name": "docID",
            "required": true,
            "schema": {
              "examples": [
                "S1000000"
              ],
              "type": "string"
            }
          },
          {
            "description": "要下载的文件类型：1 为申报正文和审计报告 ZIP，2 为 PDF，3 为替代文档及附件 ZIP，4 为英文文档 ZIP，5 为由 XBRL 转换的 CSV ZIP。",
            "in": "query",
            "name": "type",
            "required": true,
            "schema": {
              "enum": [
                1,
                2,
                3,
                4,
                5
              ],
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/pdf": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "根据 Content-Type，返回二进制 ZIP/PDF 文件内容或 JSON 错误载荷。"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Document Download API",
