                "additionalProperties": true,
                "properties": {
                  "cursor": {
                    "type": "string",
                    "description": "next_cursor from the previous page. Carries the pinned release and the resume point (about 20 KB, most of it the compressed 64 KiB window); treat it as opaque.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "page_size": {
                    "type": "number",
                    "description": "Rows per page.\n\nProvider reference: minimum 1; maximum 5000; default 1000.",
                    "default": 1000,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 5000
                    }
                  }
                }
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "page_size": 2
                  }
                }
              }
            }
          }
