                          "scan": 0.4,
                          "source_record_id": "N20:2026-10-18T1015:29.9444,49.68876",
                          "source_url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Northern_and_Central_Africa_24h.csv",
                          "track": 0.44,
                          "version": "2.0NRT"
                        }
                      ],
                      "retrieved_at": "2026-10-18T20:38:19Z",
                      "source": "VIIRS_NOAA20_NRT",
                      "source_url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Northern_and_Central_Africa_24h.csv",
                      "truncated": true
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
