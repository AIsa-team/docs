  "paths": {
    "/apis/v1/firms-modaps-eosdis-nasa-gov/wildfire-detections/fires-area": {
      "post": {
        "description": "Current hotspots around one place (an air base, a city, a park) rather than a whole file.",
        "operationId": "firms-modaps-eosdis-nasa-gov.wildfire-detections.fires-area",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "area": {
                    "type": "string",
                    "description": "`world` or `west,south,east,north` in decimal degrees (longitude -180..180, latitude -90..90, west < east, south < north). Pattern: ^(world|-?\\d{1,3}(\\.\\d+)?,-?\\d{1,2}(\\.\\d+)?,-?\\d{1,3}(\\.\\d+)?,-?\\d{1,2}(\\.\\d+)?)$."
                  },
                  "date": {
                    "type": "string",
                    "description": "Last day of the range, UTC. Keyed mode passes it to the API; keyless mode only accepts dates covered by the 7-day files. Pattern: ^\\d{4}-\\d{2}-\\d{2}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "day_range": {
                    "type": "number",
                    "description": "Days of data ending at `date` (or now). Each day counts as one transaction against the key's 5000 per 10 minutes.\n\nProvider reference: minimum 1; maximum 5; default 1.",
                    "default": 1,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 5
                    }
                  },
                  "limit": {
                    "type": "number",
                    "description": "Maximum records returned; `truncated` says when more matched.\n\nProvider reference: minimum 1; maximum 50000; default 5000.",
                    "default": 5000,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 50000
                    }
                  },
                  "map_key": {
                    "type": "string",
                    "description": "FIRMS MAP_KEY (32 lowercase hex characters, free by email at /api/map_key/). Omit to use the keyless files. Pattern: ^[0-9a-f]{32}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "source": {
                    "type": "string",
                    "description": "FIRMS source product name as used by /api/area. Keyless mode maps the NRT products to the file families; the `_SP` archives need `map_key`.\n\nProvider reference: allowed values [\"VIIRS_SNPP_NRT\", \"VIIRS_SNPP_SP\", \"VIIRS_NOAA20_NRT\", \"VIIRS_NOAA20_SP\", \"VIIRS_NOAA21_NRT\", \"MODIS_NRT\", \"MODIS_SP\", \"LANDSAT_NRT\"]."
                  }
                },
                "required": [
                  "area",
                  "source"
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "area": "46.0,29.0,50.0,32.0",
                    "day_range": 1,
                    "limit": 2,
                    "source": "VIIRS_NOAA20_NRT"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detections inside a bounding box (or `world`) for a source product over the last 1 to 5 days. With `map_key` (the free FIRMS MAP_KEY, downstream env FIRMS_MAP_KEY) the keyed area API is called exactly as documented, optional `date` included, and the response rows are returned. Without a key the request is served from the keyless active-fire file of the smallest published region that contains the box (Global otherwise) for the matching window (1 day: 24h, 2: 48h, 3 to 5: 7d), filtered client-side by the box and by acq_date; `_SP` sources and dates outside the files' 7-day window need the key.\n\nThe response contains the tool result directly.\n\nThe provider identifies `records` as the primary payload key.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `acq_date` | string | Acquisition date, UTC. |\n| `acq_time` | string | Acquisition time of the overpass, UTC HHMM, as published. |\n| `acquired_at` | string | acq_date and acq_time combined into an ISO-8601 UTC instant. |\n| `bright_t31` | number | MODIS channel 31 brightness temperature, Kelvin. |\n| `bright_ti4` | number | VIIRS I-4 channel brightness temperature, Kelvin. |\n| `bright_ti5` | number | VIIRS I-5 channel brightness temperature, Kelvin. |\n| `brightness` | number | MODIS channel 21/22 brightness temperature, Kelvin. |\n| `confidence` | string | As published: low/nominal/high (VIIRS, and l/n/h in the area API), 0-100 (MODIS), low/medium/high (Landsat). |\n| `daynight` | string | D or N. |\n| `extra` | object | Any published column not mapped above (for example `instrument`, `country_id` or `type` from the area API), verbatim as strings. |\n| `frp` | number | Fire radiative power in MW; null when the sensor publishes none (Landsat). |\n| `hazard_type` | string |  |\n| `instrument` | string | Derived from the file family or the API's instrument column. |\n| `latitude` | number |  |\n| `longitude` | number |  |\n| `path` | number | Landsat WRS-2 path. |\n| `publication_id` | string | `<file name>@<x-amz-meta-sha256>` of the file the row came from; for the keyed area API `area:<source>:<area>:<day_range>[:<date>]@<retrieved_at>` because the API has no version. |\n| `retrieved_at` | string | UTC ISO-8601 time of the upstream fetch. |\n| `row` | number | Landsat WRS-2 row. |\n| `satellite` | string | N (Suomi NPP), N20 (NOAA-20), N21 (NOAA-21), T (Terra), A (Aqua), L8/L9 (Landsat) as published. |\n| `scan` | number |  |\n| `source_record_id` | string | `<satellite>:<acq_date>T<acq_time>:<latitude>,<longitude>` built from the row's own values (FIRMS publishes no detection id). |\n| `source_url` | string | The file or API URL this row was read from. |\n| `track` | number |  |\n| `version` | string | Product version such as 2.0NRT or 6.1NRT; null for Landsat files, which publish none. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-10-18.",
                    "value": {
                      "area": "46.0,29.0,50.0,32.0",
                      "bbox": {
                        "east": 50,
                        "north": 32,
                        "south": 29,
                        "west": 46
                      },
                      "count": 2,
                      "date": null,
                      "day_range": 1,
                      "matched": 89,
                      "mode": "active_fire_file",
                      "observed_at_ms": 1792355899832,
                      "publication_id": "J1_VIIRS_C2_Northern_and_Central_Africa_24h.csv@91e82a45fccfb3ce29704c046d3a7bae9a307369154d6f8a18d78d70fc3b6a66",
                      "published_at": "2026-10-18T19:41:42Z",
                      "records": [
                        {
                          "acq_date": "2026-10-18",
                          "acq_time": "1015",
                          "acquired_at": "2026-10-18T10:15:00Z",
                          "bright_t31": null,
                          "bright_ti4": 340.84,
                          "bright_ti5": 313.03,
                          "brightness": null,
                          "confidence": "low",
                          "daynight": "D",
                          "extra": {},
                          "frp": 37.55,
                          "hazard_type": "wildfire",
                          "instrument": "VIIRS",
                          "latitude": 29.00811,
                          "longitude": 47.74698,
                          "path": null,
                          "publication_id": "J1_VIIRS_C2_Northern_and_Central_Africa_24h.csv@91e82a45fccfb3ce29704c046d3a7bae9a307369154d6f8a18d78d70fc3b6a66",
                          "retrieved_at": "2026-10-18T20:38:19Z",
                          "row": null,
                          "satellite": "N20",
                          "scan": 0.47,
                          "source_record_id": "N20:2026-10-18T1015:29.00811,47.74698",
                          "source_url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Northern_and_Central_Africa_24h.csv",
                          "track": 0.4,
                          "version": "2.0NRT"
                        },
                        {
                          "acq_date": "2026-10-18",
                          "acq_time": "1015",
                          "acquired_at": "2026-10-18T10:15:00Z",
                          "bright_t31": null,
                          "bright_ti4": 339.02,
                          "bright_ti5": 300.11,
                          "brightness": null,
                          "confidence": "nominal",
                          "daynight": "D",
                          "extra": {},
                          "frp": 6.13,
                          "hazard_type": "wildfire",
                          "instrument": "VIIRS",
                          "latitude": 29.9444,
                          "longitude": 49.68876,
