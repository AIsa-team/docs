    "/apis/v1/search/smart": {
      "get": {
        "description": "<!-- aisa-pricing:start -->\n公开参考价格：每次成功请求 $0.001 USD。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "any_search_apis_v1_search_smart",
        "parameters": [
          {
            "description": "Input value: no-cache. When no-cache is provided, the response results will not be cached and each request is independent; if not provided, the response results for the same query term will be cached for 10 minutes",
            "in": "header",
            "name": "Pragma",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The value must be in host address format (e.g., baijiahao.baidu.com). Excludes results from the specified site(s).",
            "in": "query",
            "name": "blockWebsites",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Timeout for reading long abstracts. If reading exceeds this time, it will terminate and no long abstract will be returned for that result. Defaults to 0 (seconds), maximum 10s.",
            "in": "query",
            "name": "contentTimeout",
            "required": false,
            "schema": {
              "default": 0.0,
              "maximum": 10.0,
              "type": "number"
            }
          },
          {
            "description": "The format of the long abstract (content) to return. Options:：- HTML- MARKDOWN- TEXT(default)",
            "in": "query",
            "name": "contentType",
            "required": false,
            "schema": {
              "default": "TEXT",
              "enum": [
                "HTML",
                "MARKDOWN",
                "TEXT"
              ],
              "type": "string"
            }
          },
          {
            "description": "The number of search results to return. Defaults to 10, maximum 50. Enumerated values: 10 / 20 / 30 / 40 / 50 The actual number returned may be less than requested. Use this parameter with the offset parameter for pagination.",
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "default": 10,
              "enum": [
                10,
                20,
                30,
                40,
                50
              ],
              "maximum": 50,
              "type": "integer"
            }
          },
          {
            "description": "ontrols whether to return long abstract content: -true: Return long abstracts -false: Do not return long abstracts Defaults to false",
            "in": "query",
            "name": "enableContent",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Filter search results by time range: - Day (past 24 hours) -Week (past 7 days) - Month (past 30 days)",
            "in": "query",
            "name": "freshness",
            "required": false,
            "schema": {
              "enum": [
                "Day",
                "Week",
                "Month"
              ],
              "type": "string"
            }
          },
          {
            "description": "Controls whether to return key fragments of dynamic abstracts:true： Return key fragmentsfalse：Do not return key fragmentsDefault false",
            "in": "query",
            "name": "mainText",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "The zero-based offset indicating how many results to skip before returning. Defaults to 0. Use with the count parameter for pagination. There is no upper limit for offset; setting a large value may result in no results being returned.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The user's search query term, which cannot be empty.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "The value must be in host address format (e.g., baijiahao.baidu.com). Returns results only from the specified site(s).",
            "in": "query",
            "name": "sites",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "queryContext": {
                      "properties": {
                        "originalQuery": {
                          "description": "The user's original search query",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "webPages": {
                      "properties": {
                        "value": {
                          "description": "Detailed result data returned",
                          "items": {
                            "properties": {
                              "content": {
                                "description": "Long abstract information of the webpage, retrieved from the main text. MARKDOWN and HTML formats include image links with anchor positions",
                                "type": "string"
                              },
                              "contentCrawled": {
                                "description": "Long abstract retrieval status: true for success (content is included in content), false for failure (content is empty)",
                                "type": "boolean"
                              },
                              "datePublished": {
                                "description": "Page publication time (included in some sites) Example: 2025-07-14T01:15:00.0000000Z",
                                "type": "string"
                              },
                              "imageList": {
                                "description": "List of image URLs in the webpage (included in some webpages, depending on whether the page contains images)",
                                "type": "array"
                              },
                              "logo": {
                                "description": "Website logo (included in some webpages)",
                                "type": "string"
                              },
                              "mainText": {
                                "description": "Dynamic abstract fragment extracted from the text, most relevant to the query. More intelligent than snippet",
                                "type": "string"
                              },
                              "name": {
                                "description": "Webpage title",
                                "type": "string"
                              },
                              "score": {
                                "description": "Content relevance score",
                                "type": "number"
                              },
                              "siteName": {
                                "description": "Website name (included in some webpages)",
                                "type": "string"
                              },
                              "snippet": {
                                "description": "Text snippet describing the webpage content",
                                "type": "string"
                              },
                              "url": {
                                "description": "Webpage URL",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Official typed response table; required fields and undeclared array item types are not inferred."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
