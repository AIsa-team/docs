    "/apis/v1/unipile/linkedin/search/parameters": {
      "get": {
        "operationId": "get_unipile_linkedin_search_parameters",
        "summary": "Search Parameters",
        "description": "Maps human keywords (locations, industries, …) to the filter ids that LinkedIn Search expects. This helper endpoint is free of charge.",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "description": "Filter facet type, e.g. `LOCATION`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keywords",
            "in": "query",
            "required": true,
            "description": "Keywords to resolve.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max results.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "LinkedinSearchParametersList"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
