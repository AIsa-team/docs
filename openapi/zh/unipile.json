        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "description": "Conversation id from List Chats.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id.",
            "schema": {
              "type": "string"
            }
