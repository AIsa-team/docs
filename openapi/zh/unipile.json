            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pagination cursor from a previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "ChatList"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/chats/{chat_id}/messages": {
      "get": {
        "operationId": "get_unipile_linkedin_chat_messages",
        "summary": "Chat Messages",
        "description": "Returns a MessageList for the given chat_id with cursor pagination. Message objects embed attachments, reactions, and read receipts inline. $0.005 per request.",
