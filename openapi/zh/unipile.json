    "/apis/v1/unipile/linkedin/search": {
      "post": {
        "operationId": "post_unipile_linkedin_search",
        "summary": "LinkedIn Search",
        "description": "Executes a LinkedIn search with structured filters (`api`, `category`, `keywords`, optional `parameters[]` ids from Search Parameters). Returns ranked results. People search via the classic API is verified in production. $0.02 per request.",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "LinkedinSearchResponse"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "api",
                  "category",
                  "keywords"
                ],
                "properties": {
                  "api": {
                    "type": "string",
                    "description": "Search API flavor.",
                    "enum": [
                      "classic",
                      "smart"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "description": "Search category.",
                    "enum": [
                      "people",
                      "companies",
                      "jobs"
                    ]
                  },
                  "keywords": {
                    "type": "string",
                    "description": "Free-text query."
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Max results."
                  },
                  "parameters": {
                    "type": "array",
                    "description": "Structured filter objects from Search Parameters.",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/recruiter/job-slots-credits/{account_id}": {
      "get": {
        "operationId": "get_unipile_linkedin_job_slots_credits",
        "summary": "Recruiter Job Slots Credits",
        "description": "Returns total / used / available job-slot credits for the LinkedIn Recruiter contract attached to a connected Recruiter account. Behind the scenes this proxies the upstream v2 endpoint `GET /v2/{account_id}/linkedin/recruiter/job-slots-credits`; on AIsa the account id rides in the request path. $0.005 per request.",
        "tags": [
          "Recruiter"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "description": "Connected Recruiter account id (`DA…`).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "JobSlotsCredits"
                      ]
                    },
                    "total": {
                      "type": "number",
                      "description": "Total job slots in the Recruiter contract."
                    },
                    "used": {
                      "type": "number",
                      "description": "Job slots currently in use."
                    },
                    "available": {
                      "type": "number",
                      "description": "Job slots still available."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
