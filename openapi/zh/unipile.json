{
  "openapi": "3.1.0",
  "info": {
    "title": "Unipile LinkedIn API",
    "version": "1.0.0",
    "description": "LinkedIn data and messaging through your connected accounts: profiles, companies, chats, posts, network, structured search, and Recruiter job-slot credits. Bring your own LinkedIn account (connect once through the hosted authorization link), then read and act through one AIsa credential."
  },
  "servers": [
    {
      "url": "https://api.aisa.one"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Accounts",
      "description": "Connected-account discovery and binding liveness."
    },
    {
      "name": "Profiles",
      "description": "Member and company profiles."
    },
    {
      "name": "Messaging",
      "description": "Conversations, messages, and attachments."
    },
    {
      "name": "Posts",
      "description": "Member posts and their comments."
    },
    {
      "name": "Network",
      "description": "Connections and invitations."
    },
    {
      "name": "Search",
      "description": "Structured LinkedIn search and its parameter helper."
    },
    {
      "name": "Recruiter",
      "description": "Recruiter contract quota endpoints."
    }
  ],
  "paths": {
    "/apis/v1/unipile/accounts": {
      "get": {
        "operationId": "get_unipile_accounts",
        "summary": "List Connected Accounts",
        "description": "Lists every LinkedIn account hosted on AIsa's Unipile tenant. Use it to discover `account_id` values (the `DA…` identifiers) required by every other endpoint, and as a liveness probe for your binding.",
        "tags": [
          "Accounts"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "description": "Filter by provider type. Omit or pass `linkedin`.",
            "schema": {
              "type": "string",
              "enum": [
                "linkedin"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "AccountList"
                      ]
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/me": {
      "get": {
        "operationId": "get_unipile_linkedin_me",
        "summary": "Own Profile",
        "description": "Returns the AccountOwnerProfile of the connected LinkedIn account: name, headline, premium status, organizations, and contact details. Requires `account_id` as a query parameter. $0.005 per request.",
        "tags": [
          "Profiles"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id from List Connected Accounts (`DA…`).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "AccountOwnerProfile"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/users/{identifier}": {
      "get": {
        "operationId": "get_unipile_linkedin_user",
        "summary": "User Profile",
        "description": "Fetch a UserProfile by Unipile internal id or public identifier (e.g. `acme-ceo`). Public identifiers resolve through the classic API only. Optional `linkedin_sections` returns detailed sections — heavy section use is throttled by LinkedIn. $0.01 per request.",
        "tags": [
          "Profiles"
        ],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "description": "Member internal id or public identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "linkedin_sections",
            "in": "query",
            "required": false,
            "description": "Comma-separated detail sections (throttled by LinkedIn).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "UserProfile"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/company/profile": {
      "get": {
        "operationId": "get_unipile_linkedin_company",
        "summary": "Company Profile",
        "description": "Fetch a CompanyProfile (industry, headcount, description, and more) by company identifier. Numeric company ids are verified working; public identifiers such as `microsoft` follow the same upstream contract. $0.01 per request.",
        "tags": [
          "Profiles"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "identifier",
            "in": "query",
            "required": true,
            "description": "Company identifier (numeric id verified; public identifier per upstream docs).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "CompanyProfile"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/chats": {
      "get": {
        "operationId": "get_unipile_linkedin_chats",
        "summary": "List Chats",
        "description": "Returns a ChatList with cursor pagination. Right after connecting an account, the first upstream sync may still be running — recent conversations can take a few minutes to appear. $0.005 per request.",
