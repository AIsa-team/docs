          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
    "/apis/v1/unipile/linkedin/messages/{message_id}/attachments/{attachment_id}": {
      "get": {
        "operationId": "get_unipile_linkedin_attachment",
        "summary": "Download Attachment",
        "description": "Streams the binary content of a message attachment. Take `message_id` and `attachment_id` from the `attachments[]` array inside message objects returned by Chat Messages. $0.005 per request.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "description": "Message id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attachment_id",
            "in": "path",
            "required": true,
            "description": "Attachment id from the message's attachments array.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Connected account id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "402": {
            "description": "Insufficient balance."
          }
        }
      }
    },
