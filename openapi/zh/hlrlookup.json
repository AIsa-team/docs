    "/apis/v1/hlrlookup/people-phone-network": {
      "post": {
        "description": "Answers arrive in results[0]: current_network_details and is_ported. live_status is NOT_AVAILABLE_NETWORK_ONLY because this route does not check the line; use hlrlookup.people.phone.verify for that. For +1 numbers telephone_number_type is omitted. NO_COVERAGE, BAD_FORMAT and per-result errors are free.\n\n<!-- aisa-pricing:start -->\n按实际用量收费。 默认请求预估费用：$0.003304 USD。 最终费用以实际用量为准。 账户适用价格可能不同；支持报价的接口可按实际请求获取报价。\n<!-- aisa-pricing:end -->",
        "operationId": "hlrlookup.people-phone-network",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "cache_days_global": {
                    "description": "0 never reads the shared cache, so the lookup is live.",
                    "enum": [
                      0
                    ],
                    "maximum": 0,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "cache_days_private": {
                    "description": "0 never reads this account's cache, so the lookup is live.",
                    "enum": [
                      0
                    ],
                    "maximum": 0,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "input_format": {
                    "description": "ISO3 country code when telephone_number is in national format, e.g. GBR.",
                    "enum": [
                      "GBR"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "output_format": {
                    "description": "Format of formatted_telephone_number: E164, PLUS_E164, NATIONAL, or an ISO3 country code.",
                    "type": "string"
                  },
                  "save_to_cache": {
                    "description": "The result is cached only for this account, never shared.",
                    "enum": [
                      "PRIVATE"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "telephone_number": {
                    "description": "International E.164 digits without the leading +, or a national number with input_format.",
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "cache_days_global",
                  "cache_days_private",
                  "input_format",
                  "save_to_cache",
                  "telephone_number"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Find which network serves a phone number",
        "tags": [
          "HLR Lookup"
        ],
