{
  "openapi": "3.0.3",
  "info": {
    "title": "Twitter API Aggregated Documentation",
    "version": "1.0.0",
    "description": "此 OpenAPI 规范将多个 Twitter API 端点聚合到单个文档中。"
  },
  "servers": [
