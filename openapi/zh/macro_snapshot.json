{
  "components": {
    "responses": {
      "BadRequestError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Bad Request",
              "message": "Invalid request parameters"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "错误请求"
      },
      "NotFoundError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Not Found",
              "message": "Ticker XXXX not found"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "未找到指定的资源"
      },
      "PaymentRequiredError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Payment Required",
              "message": "This endpoint requires a paid subscription. Please upgrade your plan."
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "该请求需要付费订阅"
      },
      "UnauthorizedError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Unauthorized",
              "message": "Invalid API key provided"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "未授权"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "description": "简短的错误消息。",
            "type": "string"
          },
          "message": {
            "description": "更详细的错误消息。",
            "type": "string"
          }
        },
        "type": "object"
      },
      "InterestRate": {
        "properties": {
          "bank": {
            "description": "中央银行的符号。",
            "type": "string"
          },
          "date": {
            "description": "利率日期，格式为 YYYY-MM-DD。",
            "type": "string"
          },
          "name": {
            "description": "中央银行的名称。",
            "type": "string"
          },
          "rate": {
            "description": "中央银行的利率。",
            "type": "number"
          }
        },
        "type": "object"
      },
      "InterestRatesResponse": {
        "properties": {
          "interest_rates": {
            "items": {
              "$ref": "#/components/schemas/InterestRate"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "中央银行利率数据（历史序列和实时快照），通过 AIsa 代理。",
    "title": "Financial Datasets API — Macro Interest Rates",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {},
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Production API",
      "url": "https://dev-api.aisa.one/apis/v1/financial"
    }
  ]
}
