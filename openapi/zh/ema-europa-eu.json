                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "ema_product_number": {
                    "type": "string",
                    "description": "Exact EMA product number, e.g. EMEA/H/C/000603. No match is not_found. Pattern: ^EMEA/[HV]/C/[0-9]{6}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "limit": {
                    "type": "number",
                    "description": "limit\n\nProvider reference: minimum 1; maximum 25; default 10.",
