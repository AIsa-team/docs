                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "limit": {
                    "default": 10,
                    "description": "limit\n\nProvider reference: minimum 1; maximum 25; default 10.",
                    "type": "number",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "max": 25,
                      "min": 1
                    }
                  },
                  "query": {
                    "description": "Words that must all appear, case-insensitive, in the medicine name, product number, INN, active substance, therapeutic area, ATC code or marketing authorisation holder, e.g. natalizumab.",
                    "type": "string",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "status": {
                    "description": "Exact medicine_status, case-insensitive, e.g. Authorised, Withdrawn, Refused, Lapsed, Expired, Revoked, Opinion, Application withdrawn.",
                    "type": "string",
                    "x-alexandria-option-metadata": {
