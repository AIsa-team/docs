    "/apis/v1/ema-europa-eu/records/medicines": {
      "post": {
        "description": "Search medicines evaluated through EMA's centralised procedure (EU EPAR medicine pages): name, EMA product number, status (Authorised, Withdrawn, Refused, ...), INN, active substance, ATC code, therapeutic area, marketing authorisation holder, procedure dates and flags such as orphan, generic, biosimilar and conditional approval. Filter by words, category or status, or resolve one ema_product_number. Therapeutic indications are withheld. Every result carries EMA attribution.",
        "operationId": "ema-europa-eu.records.medicines",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
