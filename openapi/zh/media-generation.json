          "estimate_source": "unavailable",
          "estimate_unavailable_reason": "model_dependent_price",
          "kind": "model_catalog"
        },
        "x-aisa-revision": {
          "handler_contract_hash": "3f814885c369011a20079676ad88db6c8744cf3be09f3e7b061664aa2b41e94a"
        },
        "x-aisa-runtime-operation": {
