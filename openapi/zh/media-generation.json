    "/v1/video/generations/{task_id}": {
      "get": {
        "description": "Returns a video generation task created with the same account. When status is completed, result holds the model's output, including the video URL; when status is failed, error.message says why.",
        "operationId": "retrieveVideoGeneration",
        "parameters": [
          {
            "description": "The id returned when the task was created.",
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "completed_at": {
                      "description": "Unix seconds; present once the task has ended.",
                      "type": "integer"
                    },
                    "created_at": {
                      "description": "Unix seconds.",
                      "type": "integer"
                    },
                    "customer_cost_micros_usd": {
                      "description": "The charge collected for this task, in micro-USD; zero when a failed task's hold was released. Present once the task has ended and its charge is confirmed final; absent while it runs or settles, or when finality cannot be confirmed.",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "id": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "object": {
                      "const": "video.generation",
                      "type": "string"
                    },
                    "progress": {
                      "description": "For example 0% or 100%.",
                      "type": "string"
                    },
                    "result": {
                      "description": "The model's output once completed, including the video URL (video_url or url)."
                    },
                    "status": {
                      "enum": [
                        "queued",
                        "in_progress",
                        "completed",
                        "failed",
                        "cancelled",
                        "unknown"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "object",
                    "status",
                    "model",
                    "created_at",
                    "progress"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The task."
          },
          "404": {
            "description": "No task with this id belongs to the account."
          },
          "default": {
            "description": "Validation, authentication, balance or provider error. Provider refusals, such as content checks, keep their 4xx status."
          }
        },
        "summary": "获取视频生成任务",
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
