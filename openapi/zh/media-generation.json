  "paths": {
    "/v1/images/generations": {
      "post": {
        "description": "OpenAI-compatible image generation. The gateway requires model and resolves it from the model catalog; the remaining fields are forwarded to the selected model, which validates them. Accepted sizes are model-specific (Seedream requires at least 3,686,400 pixels, for example 2048x2048). Images are returned as url or b64_json, as the model produces them. With X-AISA-Cost-Mode: quote the route returns a cost_estimate instead and generates nothing.",
        "operationId": "createImageGeneration",
        "parameters": [
          {
            "description": "Return a free, read-only cost quote for this caller and payload instead of generating.",
            "in": "header",
            "name": "X-AISA-Cost-Mode",
            "schema": {
              "enum": [
                "quote"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "description": "An image model from GET /v1/models, for example seedream-5-0-260128, wan2.7-image or gpt-image-2.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "prompt": {
                    "description": "要生成的图像的文本描述。",
                    "minLength": 1,
                    "type": "string"
                  },
                  "n": {
                    "default": 1,
                    "description": "Number of images, for models that support more than one.",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "size": {
                    "description": "WIDTHxHEIGHT, for example 2048x2048. Accepted sizes depend on the model.",
                    "type": "string",
                    "example": "2048x2048"
                  },
                  "image": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "Reference image(s) for models that start from a picture, as an https or data: URL."
                  }
                },
                "required": [
                  "model",
                  "prompt"
                ]
              },
              "examples": {
                "basic": {
                  "summary": "Single 2K image",
                  "value": {
                    "model": "seedream-5-0-260128",
                    "prompt": "A cute red panda, ultra-detailed, cinematic lighting",
                    "n": 1,
                    "size": "2048x2048"
                  }
                },
                "minimum_size": {
                  "summary": "Exactly at minimum allowed size (1920×1920)",
                  "value": {
                    "model": "seedream-5-0-260128",
                    "prompt": "A futuristic cyberpunk city, neon lights, rainy night, 8k",
                    "n": 1,
                    "size": "1920x1920"
                  }
                },
                "batch": {
                  "summary": "Four candidates for selection",
                  "value": {
                    "model": "seedream-5-0-260128",
                    "prompt": "Oil painting of a rolling hillside at sunset",
                    "n": 4,
                    "size": "2048x2048"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "created": {
                      "type": "integer"
                    },
                    "data": {
                      "items": {
                        "additionalProperties": true,
                        "properties": {
                          "b64_json": {
                            "description": "Base64-encoded image bytes.",
                            "type": "string"
                          },
                          "revised_prompt": {
                            "type": "string"
                          },
                          "url": {
                            "description": "Temporary URL of the image.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Generated images.",
            "headers": {
              "X-AISA-Customer-Cost-Micros-USD": {
                "description": "The charge settled for this request, in micro-USD. Omitted for requests paid by x402 or MPP, which report payment through that protocol.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "description": "Validation, authentication, balance or provider error. Provider refusals, such as content checks, keep their 4xx status."
          }
        },
        "summary": "生成图片",
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
          "quote": {
            "header": "X-AISA-Cost-Mode",
            "supported": true,
            "value": "quote"
          },
          "x402": false
        },
        "x-aisa-contract-source": "handler",
        "x-aisa-pricing": {
          "description": "Charged at the selected model's catalog price. A fixed-price model charges its listed price once per request, whatever n is; a token-priced model charges the usage it reports. A quote for the caller and payload says whether its amount is exact or an estimate.",
          "estimate_source": "unavailable",
          "estimate_unavailable_reason": "model_dependent_price",
          "kind": "model_catalog"
        },
        "x-aisa-revision": {
          "handler_contract_hash": "5bdfd0468378848ae2cd9bde741c82821b5d14dc745fbe3f9b26e2db0ccda5a2"
        },
        "x-aisa-status": "enabled",
        "x-aisa-validation": "mixed",
        "x-aisa-catalog-id": "media-generation",
        "x-aisa-runtime-operation": {
          "operation_id": "createImageGeneration",
          "method": "POST",
          "path": "/v1/images/generations"
        },
        "x-aisa-source": {
          "kind": "manual",
          "url": "https://github.com/AIsa-team/docs/blob/7783840e4710bb00886143feab84606f8aaea67c/openapi/openai-images-generations.json",
          "fetched_at": "2026-09-29T21:25:55+08:00",
          "content_hash": "sha256:484be4e9322c28bcdf73b1f17c9ecde87e56057df21d9fba233e7994ad258e3c",
          "converter": "scripts/import_existing_contracts.py@1",
          "path_space": "public",
          "owner": "AIsa-team/docs",
          "refresh_policy": "manual",
          "review_period_days": 30,
          "policy_revision": "sha256:0d852438cc6d89ccfe24b7d7803dc9eb1963516122a1afd4c32a751a30f5ab03"
        },
        "x-aisa-docs-url": "/api-reference/chat/post_images-generations"
      }
    },
