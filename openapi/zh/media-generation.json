          "operation_id": "createVideoGeneration",
          "path": "/v1/video/generations"
        },
        "x-aisa-source": {
          "content_hash": "sha256:989befbd5e6a4c0106a71aa7064db1749cef3232f0396b1ab715623d87943f0e",
          "converter": "manual:aisaservices-video-handler-contract@1",
          "fetched_at": "2026-10-30T20:00:00+08:00",
          "kind": "manual",
          "owner": "AIsa-team/docs",
          "path_space": "public",
          "policy_revision": "sha256:39ef87da0423db20b45d0ea4cc09a0b2c1aac7c3710f536685de2165cef00bf0",
          "refresh_policy": "manual",
          "review_period_days": 30,
          "url": "https://github.com/AIsa-team/AIsaServices/blob/c03a076b24caee6fed1665fede5f72fa1f7b6700/services/api-service/internal/httpapi/api_contract_media.go"
        },
        "x-aisa-status": "enabled",
        "x-aisa-validation": "mixed",
        "x-codeSamples": [
          {
            "label": "Reference example",
            "lang": "text",
            "source": "# Fixed reference example. Playground inputs do not update this sample.\ncurl --request POST \\\n  --url https://api.aisa.one/v1/video/generations \\\n  --header 'Authorization: Bearer <token>' \\\n  --header 'Content-Type: application/json' \\\n  --data '{\n  \"model\": \"dreamina-seedance-2-0-260128\",\n  \"content\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"A small red boat on a calm lake at dawn\"\n    }\n  ],\n  \"ratio\": \"16:9\",\n  \"duration\": 5,\n  \"generate_audio\": true,\n  \"watermark\": false\n}'"
          }
        ]
      }
