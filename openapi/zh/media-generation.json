    "/v1/video/generations/{task_id}": {
      "get": {
        "description": "Returns a video generation task created with the same account. When status is completed, result holds the model's output, including the video URL; when status is failed, error.message says why.\n\n<!-- aisa-pricing:start -->\n当前未提供请求参考价格；请使用接口支持的报价功能确认费用。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "retrieveVideoGeneration",
        "parameters": [
          {
            "description": "The id returned when the task was created.",
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
