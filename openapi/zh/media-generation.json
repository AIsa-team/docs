    "/v1/video/generations": {
      "post": {
        "description": "Starts an asynchronous video generation task. A video usually takes one to three minutes; poll the task with the returned id until its status is completed, failed or cancelled.\n\nStarts an asynchronous video generation task and returns it with status queued. The gateway requires model; the remaining fields are the selected model's own request fields and are forwarded to it. A video usually takes one to three minutes: poll retrieveVideoGeneration with the returned id until status is completed, failed or cancelled. Only a 503 whose code is video_submission_pending, with a non-empty id, means the task and its charge authorization were kept: retrieve it with that id and do not submit a replacement. Any other 503 means the service or the provider was unavailable and no task is pending; retry later. With X-AISA-Cost-Mode: quote the route returns a cost_estimate instead and creates no task.\n\n<!-- aisa-pricing:start -->\n当前未提供请求参考价格；请使用接口支持的报价功能确认费用。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "createVideoGeneration",
        "parameters": [
          {
            "description": "Return a free, read-only cost quote for this caller and payload instead of generating.",
            "in": "header",
            "name": "X-AISA-Cost-Mode",
            "schema": {
              "enum": [
                "quote"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "description": "A video model from GET /v1/models, for example dreamina-seedance-2-0-260128 or wan2.7-t2v.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "prompt": {
                    "description": "Text prompt, for models that take a plain prompt.",
                    "type": "string"
                  },
                  "content": {
                    "description": "Prompt and reference media, for Seedance models.",
                    "items": {
                      "additionalProperties": true,
                      "properties": {
                        "image_url": {
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "role": {
                          "description": "For images: first_frame, last_frame or reference_image; for videos: reference_video.",
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "type": {
                          "description": "text, image_url or video_url.",
                          "type": "string"
                        },
                        "video_url": {
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "duration": {
                    "description": "Output length in seconds; part of the price.",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "resolution": {
                    "description": "For example 720p or 1080p; part of the price.",
                    "type": "string"
                  },
                  "ratio": {
                    "description": "Aspect ratio, for example 16:9, 9:16 or 1:1.",
                    "type": "string"
                  },
                  "generate_audio": {
                    "type": "boolean"
                  },
                  "watermark": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "model"
                ]
              },
              "example": {
                "model": "dreamina-seedance-2-0-260128",
                "content": [
                  {
                    "type": "text",
                    "text": "A small red boat on a calm lake at dawn"
                  }
                ],
                "ratio": "16:9",
                "duration": 5,
                "generate_audio": true,
                "watermark": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "completed_at": {
                      "description": "Unix seconds; present once the task has ended.",
                      "type": "integer"
                    },
                    "created_at": {
                      "description": "Unix seconds.",
                      "type": "integer"
                    },
                    "customer_cost_micros_usd": {
                      "description": "The charge collected for this task, in micro-USD; zero when a failed task's hold was released. Present once the task has ended and its charge is confirmed final; absent while it runs or settles, or when finality cannot be confirmed.",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "id": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "object": {
                      "const": "video.generation",
                      "type": "string"
                    },
                    "progress": {
                      "description": "For example 0% or 100%.",
                      "type": "string"
                    },
                    "result": {
                      "description": "The model's output once completed, including the video URL (video_url or url)."
                    },
                    "status": {
                      "enum": [
                        "queued",
                        "in_progress",
                        "completed",
                        "failed",
