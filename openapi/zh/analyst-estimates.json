{
  "components": {
    "responses": {
      "BadRequestError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Bad Request",
              "message": "Invalid request parameters"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "错误请求"
      },
      "NotFoundError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Not Found",
              "message": "Ticker XXXX not found"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "未找到指定的资源"
      },
      "PaymentRequiredError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Payment Required",
              "message": "This endpoint requires a paid subscription. Please upgrade your plan."
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "该请求需要付费订阅"
      },
      "UnauthorizedError": {
        "content": {
          "application/json": {
            "example": {
              "error": "Unauthorized",
              "message": "Invalid API key provided"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "未授权"
      }
    },
    "schemas": {
      "AnalystEstimate": {
        "properties": {
          "earnings_per_share": {
            "description": "预估每股收益。",
            "type": "number"
          },
          "fiscal_period": {
            "description": "分析师预估的财务期间。",
            "format": "date",
            "type": "string"
          },
          "period": {
            "description": "分析师预估的周期。",
            "enum": [
              "annual",
              "quarterly"
            ],
            "type": "string"
          },
          "revenue": {
            "description": "预估收入。",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "AnalystEstimatesResponse": {
        "properties": {
          "analyst_estimates": {
            "items": {
              "$ref": "#/components/schemas/AnalystEstimate"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "description": "简短的错误消息。",
            "type": "string"
          },
          "message": {
            "description": "更详细的错误消息。",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "华尔街分析师对美国股票代码的一致预期（预期营收 + 预期每股收益），按财务期间（年度或季度）细分。由 AIsa 代理访问 Financial Datasets API。",
    "title": "Financial Datasets API — Analyst Estimates",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {},
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Production API",
      "url": "https://api.aisa.one/apis/v1/financial"
    }
  ]
}
