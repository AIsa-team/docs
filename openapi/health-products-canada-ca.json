                          "strength": "1.34",
                          "strength_unit": "MG"
                        }
                      ],
                      "ai_group_number": "0159870002",
                      "atc": {
                        "code": "A10BJ06",
                        "name": "SEMAGLUTIDE"
                      },
                      "brand_name": "OZEMPIC",
                      "class": "Human",
                      "company": {
                        "city": "Mississauga",
                        "company_code": 4763,
                        "country": "Canada",
                        "name": "NOVO NORDISK CANADA INC",
                        "postal_code": "L5N 6M1",
                        "province": "Ontario",
                        "street_address": "101-2476 Argentia Road"
                      },
                      "descriptor": "DISPENSES 1 MG DOSES. MULTIDOSE PREFILLED PEN",
                      "din": "02471469",
                      "dosage_forms": [
                        "Solution"
                      ],
                      "drug_code": 96058,
                      "last_lot": null,
                      "last_update_date": "2026-08-13",
                      "license": {
                        "attribution": "Contains information licensed under the Open Government Licence – Canada. Source: Health Canada, Drug Product Database.",
                        "name": "Open Government Licence - Canada 2.0",
                        "url": "https://open.canada.ca/en/open-government-licence-canada"
                      },
                      "monograph": {
                        "date": "2026-07-13",
                        "url": "https://pdf.hres.ca/dpd_pm/00085314.PDF"
                      },
                      "observed_at_ms": 1792528800668,
                      "original_market_date": "2018-02-22",
                      "other_drug_codes": [],
                      "packaging": "2 X2mg/Pen",
                      "pharmaceutical_standards": [],
                      "routes": [
                        "Subcutaneous"
                      ],
                      "schedules": [
                        "PRESCRIPTION",
                        "SCHEDULE D"
                      ],
                      "source_url": "https://health-products.canada.ca/dpd-bdpp/info?lang=eng&code=96058",
                      "status": "Marketed",
                      "status_date": "2018-02-22",
                      "veterinary_species": []
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
