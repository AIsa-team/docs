    "/apis/v1/health-products-canada-ca/products/search": {
      "post": {
        "description": "Start here for \"is Ozempic approved in Canada, under which DINs\", \"which companies market generic atorvastatin\" or \"which adalimumab products are marketed\" (ATC `L04AB04`), then call `get` with a DIN or drug code for forms, routes, ATC class, status dates, company address and the monograph.",
        "operationId": "health-products-canada-ca.products.search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "company": {
                    "type": "string",
                    "description": "Company (DIN owner) name or part of it, e.g. `novo nordisk`, `pfizer canada`. Narrows `query`, or lists a company's products on its own; short generic names such as `pharma` match thousands of products and can time out."
                  },
                  "limit": {
                    "type": "number",
                    "description": "Results per page.\n\nProvider reference: minimum 1; maximum 25; default 10.",
                    "default": 10,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 25
                    }
                  },
                  "offset": {
                    "type": "number",
                    "description": "`next_offset` from the previous page; repeat the same query, company and status with it.\n\nProvider reference: minimum 0; default 0.",
                    "default": 0,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 0
                    }
                  },
                  "query": {
                    "type": "string",
                    "description": "A brand name or active ingredient (`Ozempic`, `semaglutide`, `atorvastatin calcium`), a DIN (`02471469`), an ATC code or prefix of at least four characters (`L04AB04`, `L04AB`) or a 10-digit AIG number. The kind is inferred. Text matches anywhere in brand names and in active ingredient names, and both result sets are merged."
                  },
                  "status": {
                    "type": "string",
                    "description": "`active`: Approved, Marketed or Dormant, the statuses Health Canada counts as active DINs. `cancelled`: every cancelled status plus revoked or expired interim-order authorizations. `any` (default) also includes Restricted Access.\n\nProvider reference: allowed values [\"any\", \"active\", \"marketed\", \"approved\", \"dormant\", \"cancelled\"]; default \"any\".",
                    "default": "any",
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "oneOf": [
                        "any",
                        "active",
                        "marketed",
                        "approved",
                        "dormant",
                        "cancelled"
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "company": {}
                        },
                        "required": [
                          "company"
                        ]
                      },
                      {
                        "properties": {
                          "query": {}
                        },
                        "required": [
                          "query"
                        ]
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "query": "ozempic"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Find drug products in Health Canada's Drug Product Database by brand name or active ingredient, DIN, WHO ATC code, active ingredient group (AIG) number or company, optionally limited to active, marketed, approved, dormant or cancelled products. Each result has the DIN and drug code, brand name and descriptor, company, class, current status, schedules, every active ingredient with its strength, the AIG number and whether a product monograph is on file. Marketed products come first, then approved, dormant and cancelled ones, each by brand name; `status_counts` summarizes every match and `next_offset` pages onward. No match is an empty result.\n\nThe response contains the tool result directly.\n\nThe provider identifies `results` as the primary payload key.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `active_ingredients` | object[] | Every active ingredient with its strength, in DPD order. |\n| `ai_group_number` | string | Active ingredient group (AIG) number: products sharing it have the same active ingredients and strengths (generic equivalents); pass it as `query` to list them. |\n| `brand_name` | string |  |\n| `class` | string | Human, Veterinary, Disinfectant or Radiopharmaceutical. |\n| `company_name` | string | The DIN owner. |\n| `descriptor` | string | What distinguishes this DIN from others of the brand, e.g. pen or vial size; null when none. |\n| `din` | string | Drug Identification Number, 8 digits. |\n| `drug_code` | number | Health Canada drug code, the DPD key `get` takes as `drug_code`. |\n| `has_monograph` | boolean | Whether Health Canada has a product monograph (or veterinary labelling) on file; `get` returns its link. |\n| `schedules` | string[] | Regulatory schedules, e.g. PRESCRIPTION, SCHEDULE D (biologics), NARCOTICS (CDSA I), ETHICAL; empty for most over-the-counter products. |\n| `source_url` | string | The product's DPD page. |\n| `status` | string | Current status: Marketed, Approved, Dormant, Cancelled Post Market, Cancelled Pre Market, Cancelled (Unreturned Annual), Restricted Access and a few rarer values. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
