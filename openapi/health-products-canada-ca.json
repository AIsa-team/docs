  "paths": {
    "/apis/v1/health-products-canada-ca/products/get": {
      "post": {
        "description": "After `search`, or when you have a DIN (`02471469`), a drug code or a health-products.canada.ca/dpd-bdpp/info URL: what a Canadian product contains, how it is given, whether it is prescription-only, a biologic (SCHEDULE D) or a controlled drug, who holds the DIN, when it was first marketed or cancelled, and where its monograph is. The WHO ATC code links the product to other regulators' records, such as EMA's.",
        "operationId": "health-products-canada-ca.products.get",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "din": {
                    "type": "string",
                    "description": "Drug Identification Number, e.g. `02471469`; leading zeros may be omitted."
                  },
                  "drug_code": {
                    "type": "number",
                    "description": "DPD drug code from `search`, e.g. `96058`.\n\nProvider reference: minimum 1."
                  },
                  "url": {
                    "type": "string",
                    "description": "A DPD product page, e.g. `https://health-products.canada.ca/dpd-bdpp/info?lang=eng&code=96058` (French pages too), or a DPD API drugproduct URL."
                  }
                },
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "din": {}
                        },
                        "required": [
                          "din"
                        ]
                      },
                      {
                        "properties": {
                          "drug_code": {}
                        },
                        "required": [
                          "drug_code"
                        ]
                      },
                      {
                        "properties": {
                          "url": {}
                        },
                        "required": [
                          "url"
                        ]
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "din": "02471469"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One drug product from Health Canada's Drug Product Database by DIN, drug code or DPD page URL, composed from the DPD API's product, ingredient, dosage form, route, schedule, status, therapeutic class, packaging, standard and company resources plus the product page: brand name and descriptor, class, current status with the date it took effect and the original market date (and the last lot and its expiry for discontinued products), the DIN owner with address, active ingredients with strengths, AIG number, dosage forms, routes of administration, schedules, WHO ATC code, veterinary species, pharmaceutical standard, packaging and the product monograph PDF link with its date. A DIN Health Canada has reused resolves to its current product and lists the other drug codes. Unknown DINs and drug codes are `not_found`.\n\nThe response contains the tool result directly.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `active_ingredients` | object[] | Every active ingredient with its strength, in DPD order. |\n| `ai_group_number` | string | Active ingredient group number; `search` with it as `query` lists products with the same ingredients and strengths. |\n| `atc` | object | WHO Anatomical Therapeutic Chemical class; null when DPD assigns none (most veterinary products). |\n| `brand_name` | string |  |\n| `class` | string | Human, Veterinary, Disinfectant or Radiopharmaceutical. |\n| `company` | object | The DIN owner, the company that holds the market authorization. |\n| `descriptor` | string | What distinguishes this DIN from others of the brand; null when none. |\n| `din` | string |  |\n| `dosage_forms` | string[] | Dosage forms, e.g. Tablet, Solution; kits list several. |\n| `drug_code` | number |  |\n| `last_lot` | object | For discontinued products: the last lot distributed in Canada and its expiry date; null otherwise. |\n| `last_update_date` | string | When Health Canada last changed key fields of the record. |\n| `license` | object | Health Canada publishes the DPD under the Open Government Licence - Canada 2.0, which allows commercial use with attribution. Product monographs linked from records are sponsor documents and are not covered. |\n| `monograph` | object | The product monograph Health Canada holds; null when none is on file. |\n| `observed_at_ms` | number |  |\n| `original_market_date` | string | Earliest marketed date DPD records; null for products never marketed. |\n| `other_drug_codes` | number[] | Other drug codes carrying the same DIN, which Health Canada has reused for about a hundred DINs. |\n| `packaging` | string | Package sizes as the company reports them, free text. |\n| `pharmaceutical_standards` | string[] | Standards the product is made to, e.g. USP, BP, MFR (manufacturer). |\n| `routes` | string[] | Routes of administration, e.g. Oral, Subcutaneous. |\n| `schedules` | string[] | Regulatory schedules, e.g. PRESCRIPTION, SCHEDULE D, NARCOTICS (CDSA I). |\n| `source_url` | string | The product's DPD page. |\n| `status` | string | Current status, e.g. Marketed, Approved, Dormant, Cancelled Post Market. |\n| `status_date` | string | Date the current status took effect. |\n| `veterinary_species` | string[] | Target species of a veterinary product. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example",
                    "description": "Published by the provider on 2026-10-20.",
                    "value": {
                      "active_ingredients": [
                        {
