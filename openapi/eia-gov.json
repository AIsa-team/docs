              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "api_key": {
                    "type": "string",
                    "description": "Registered EIA API key. Omitted, the public data-browser key is discovered live (see `routes`). Pattern: ^[A-Za-z0-9_]+$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "cursor": {
                    "type": "string",
                    "description": "`next_cursor` from the previous page (a row offset). Omit for the first page. Pattern: ^[0-9]{1,12}$.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "data_columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Data columns to return, from the route's `data_columns`. Defaults to [\"value\"].",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "end": {
                    "type": "string",
                    "description": "Inclusive last period in the frequency's format.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "facets": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Facet filters: facet id to list of codes, e.g. {\"series\": [\"RWTC\"]} or {\"stateid\": [\"CA\"], \"sectorid\": [\"RES\"]}.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "frequency": {
                    "type": "string",
                    "description": "Frequency id from the route metadata: annual, quarterly, monthly, weekly, daily, hourly or local-hourly. Pattern: ^[a-z-]+$."
                  },
                  "page_size": {
                    "type": "number",
                    "description": "Rows per page; the API caps a page at 5000 rows.\n\nProvider reference: minimum 1; maximum 5000; default 20.",
                    "default": 20,
                    "x-alexandria-option-metadata": {
                      "in": "body",
                      "min": 1,
                      "max": 5000
                    }
                  },
                  "route": {
                    "type": "string",
                    "description": "Route path with data, such as `petroleum/pri/spt` (do not append `/data`). Pattern: ^/?[a-z0-9_-]+(/[a-z0-9_-]+)*/?$."
                  },
                  "sort": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Sort keys applied by the API. Defaults to newest period first.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "start": {
                    "type": "string",
                    "description": "Inclusive first period in the frequency's format.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                },
                "required": [
                  "frequency",
                  "route"
                ]
              },
