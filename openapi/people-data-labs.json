    "/apis/v1/people-data-labs/company/search": {
      "post": {
        "description": "Use to find companies by attribute - industry, headcount, funding stage, location - rather than to look one up you can already name. Each returned company costs 50 credits. Smaller pages reduce payload size.",
        "operationId": "people-data-labs.company.search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "query": {
                    "additionalProperties": true,
                    "type": "object",
                    "description": "Elasticsearch 7.7 query object over the company schema. Only term, terms, exists, bool, match, range, match_phrase, wildcard, prefix and match_all are accepted. Any array inside it is capped at 100 elements - a tenth of what the person endpoints allow, so a filter list carried over from there will fail. Send this or sql, never both."
                  },
                  "sql": {
                    "type": "string",
                    "description": "`SELECT * FROM company WHERE ...`. Column selection and LIMIT are ignored, and at most 20 LIKE '%...%' terms are allowed. Send this or query, never both."
                  },
                  "size": {
                    "maximum": 2,
                    "minimum": 1,
                    "type": "integer",
                    "description": "Request 1-2 companies per call, costing 50 credits per returned company. PDL supports 1-100 upstream, but Exchange authorization is capped at 100 credits, so callers must use size 1 or 2.\n\nProvider reference: minimum 1; maximum 100; default 1."
                  },
                  "scroll_token": {
                    "type": "string",
                    "description": "The scroll_token from the previous response, replayed with the identical query, for the next page. A 404 while scrolling means the results are exhausted, not that the query broke.",
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  },
                  "titlecase": {
                    "type": "boolean",
                    "description": "Return titlecased values. Responses are lowercase otherwise, which matters when the output is shown to a person rather than matched on.\n\nProvider reference: default false.",
                    "default": false,
                    "x-alexandria-option-metadata": {
                      "in": "body"
                    }
                  }
                },
                "required": [
                  "size"
                ],
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "query": {}
                        },
                        "required": [
                          "query"
                        ]
                      },
                      {
                        "properties": {
                          "sql": {}
                        },
                        "required": [
                          "sql"
                        ]
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "provider": {
                  "summary": "Official provider example; checked against AIsa request constraints",
                  "value": {
                    "size": 1,
                    "sql": "SELECT * FROM company WHERE industry = 'computer software'"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full company records under `data` (only representative fields are listed here), sorted by profile completeness, with `total` and `scroll_token` in the envelope. A query matching nothing is a 200 with total 0, not a 404 - read total, never the status code.\n\nThe response contains the tool result directly.\n\nThe provider identifies `data` as the primary payload key.\n\n| Documented field | Provider type | Description |\n| --- | --- | --- |\n| `id` | string | PDL company id, and the pdl_id every other company capability takes. |\n| `name` | string | Canonical name. |\n| `website` | string | Primary domain. |\n| `industry` | string | Industry. |\n| `size` | string | Headcount band. |\n| `employee_count` | number | Headcount. |\n| `location` | object | Headquarters, with locality, region, country, metro, street_address and postal_code under it. |\n| `total_funding_raised` | number | Total funding raised. |\n\n\nThese are the provider's documented fields. Field requiredness, nullability and nested object structures are specified only where the descriptions explicitly say so.",
            "content": {
              "application/json": {
                "schema": {
                  "not": {
                    "type": "null"
                  },
                  "x-aisa-schema-completeness": "documented-fields-only"
                },
                "examples": {
                  "provider": {
                    "summary": "Official provider example (illustrative)",
                    "description": "Published by the provider on 2026-09-30.",
                    "value": {
                      "data": [
                        {
                          "employee_count": 120,
                          "id": "example-company",
                          "industry": "computer software",
                          "location": {
                            "country": "united states"
                          },
                          "name": "Example Company",
                          "website": "example.com"
                        }
                      ],
                      "scroll_token": "example-scroll-token",
                      "status": 200,
                      "total": 1
                    }
                  }
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Company search",
        "tags": [
          "People Data Labs"
        ],
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
