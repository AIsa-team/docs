    "/apis/v1/influencersclub/creators-audience-overlap": {
      "post": {
        "description": "returns per-creator overlap and unique-audience percentages plus report totals (total_followers, total_unique_followers). The body echoes credits_cost and credits_left. One flat credit whether you compare 2 creators or 10 — batch the comparison\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.598 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "influencersclub.creators-audience-overlap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "creators": {
                    "description": "2 to 10 handles",
                    "examples": [
                      [
                        "nasa",
                        "spacex"
                      ]
                    ],
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "platform": {
                    "description": "the platform all the creators are on",
                    "examples": [
                      "instagram"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "platform",
                  "creators"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
