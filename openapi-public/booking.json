    "/apis/v1/booking/rates": {
      "post": {
        "description": "Booking Hotel Rates\n\nThis operation returns what the page at `url` shows when it is fetched. Currency, language and regional content are decided by the rendered page and the location it is fetched from, not by your URL: URL parameters that select them (for example a currency or language parameter) may be ignored. Read the currency and locale values in the response instead of assuming the ones in your URL.\n\nStay dates are those of the rendered page. Compare `data.rates[].arrival_date` and `data.rates[].los` (number of nights) with the dates in your URL before using the rates.\n\n> **Request example pending verification.** The request example for this endpoint has not yet been verified in production. Static examples describe the request format; replace sample values with your own. Check the estimated price with a free quote request (`X-AISA-Cost-Mode: quote`) before running it.",
        "operationId": "post_booking_apis_v1_booking_rates",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "pattern": "^https?://(?:[A-Za-z0-9-]+\\.)*[Bb][Oo][Oo][Kk][Ii][Nn][Gg]\\.(?:[A-Za-z]{2,}|(?:ac|co|com|edu|gov|net|org)\\.[A-Za-z]{2})(?::[0-9]+)?(?:[/?#]|$)\\S*$",
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "description": "The response envelope and container type are documented, but the business fields are not fully specified.",
                  "properties": {
                    "data": {
                      "additionalProperties": true,
                      "minProperties": 1,
                      "type": "object"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Normalized successful response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Booking Hotel Rates",
        "tags": [
          "Booking.com"
        ],
