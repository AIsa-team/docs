    "/apis/v1/trip/reviews": {
      "post": {
        "description": "Trip.com Reviews\n\n<!-- aisa-pricing:start -->\nA request reference price is not currently available; use a request quote where supported. Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "post_trip_apis_v1_trip_reviews",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": false,
                "properties": {
                  "geoCode": {
                    "description": "Two-letter ISO 3166-1 country code of the proxy the page is fetched through, e.g. 'US', 'SG'. Use the target site's own country (e.g. 'ID' for lazada.co.id, 'TH' for th.hotels.com): it sets the localized prices, currency, language and availability.",
