    "/apis/v1/hlrlookup/people-phone-network": {
      "post": {
        "description": "Answers arrive in results[0]: current_network_details and is_ported. live_status is NOT_AVAILABLE_NETWORK_ONLY because this route does not check the line; use hlrlookup.people.phone.verify for that. For +1 numbers telephone_number_type is omitted. NO_COVERAGE, BAD_FORMAT and per-result errors are free.\n\n> **Request example pending verification.** The request example for this endpoint has not yet been verified in production. Static examples describe the request format; replace sample values with your own. Check the estimated price with a free quote request (`X-AISA-Cost-Mode: quote`) before running it.",
        "operationId": "hlrlookup.people-phone-network",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "cache_days_global": {
                    "description": "0 never reads the shared cache, so the lookup is live.",
                    "enum": [
                      0
                    ],
                    "maximum": 0,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "cache_days_private": {
                    "description": "0 never reads this account's cache, so the lookup is live.",
                    "enum": [
                      0
                    ],
                    "maximum": 0,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "input_format": {
                    "description": "ISO3 country code when telephone_number is in national format, e.g. GBR.",
                    "enum": [
                      "GBR"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "output_format": {
                    "description": "Format of formatted_telephone_number: E164, PLUS_E164, NATIONAL, or an ISO3 country code.",
                    "type": "string"
                  },
                  "save_to_cache": {
                    "description": "The result is cached only for this account, never shared.",
                    "enum": [
                      "PRIVATE"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "telephone_number": {
                    "description": "International E.164 digits without the leading +, or a national number with input_format.",
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "cache_days_global",
                  "cache_days_private",
                  "input_format",
                  "save_to_cache",
                  "telephone_number"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
