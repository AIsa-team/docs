    "/apis/v1/hotels-com/reviews": {
      "post": {
        "description": "Hotels.com Hotel Reviews\n\n> **Request example pending verification.** The request example for this endpoint has not yet been verified in production. Static examples describe the request format; replace sample values with your own. Check the estimated price with a free quote request (`X-AISA-Cost-Mode: quote`) before running it.",
        "operationId": "post_hotels_com_apis_v1_hotels_com_reviews",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": false,
                "properties": {
                  "geoCode": {
                    "description": "Two-letter ISO 3166-1 country code of the proxy the page is fetched through, e.g. 'US', 'SG'. Use the target site's own country (e.g. 'ID' for lazada.co.id, 'TH' for th.hotels.com): it sets the localized prices, currency, language and availability.",
                    "pattern": "^[A-Za-z]{2}$",
                    "type": "string"
                  },
                  "pageIndex": {
                    "description": "Review page, starting at 1 (default 1).",
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "property": {
                    "description": "Full Hotels.com hotel page URL; it must contain `expediaPropertyId=<id>`, e.g. https://th.hotels.com/en/ho144899/mandarin-orchard-singapore/?expediaPropertyId=19078.",
                    "format": "uri",
                    "pattern": "[?&]expediaPropertyId=[0-9]+(?:&|$)",
                    "type": "string"
                  },
                  "size": {
                    "description": "Reviews per page (default 20).",
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "url": {
                    "description": "Hotels.com home page of the local site the reviews are read from, e.g. https://th.hotels.com",
                    "format": "uri",
                    "pattern": "^https://(?:[A-Za-z0-9-]+\\.)?hotels\\.com/?$",
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "property",
                  "geoCode"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
