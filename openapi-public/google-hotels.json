    "/apis/v1/google-hotels/rates": {
      "post": {
        "description": "Google Hotels Hotel Rates\n\nPrices, currency, market and stay dates come from the Google Hotels page as it renders when fetched, not from your URL. URL parameters such as `curr`, `hl`, `gl`, `checkin` and `checkout` may be ignored, so the result can be in another currency, for another market or for other dates than requested. Always read `data.currency`, `data.location`, `data.checkin` and `data.checkout` before using `data.booking_options[].price`.\n\n`data.booking_options[].url` values are Google redirect links that expire after a while. Some are sponsored placements: `https://www.google.com/aclk?...` links that carry Google ad click identifiers such as `gclid`. They are returned unchanged; follow them promptly and do not store them as permanent booking links.\n\n> **Request example pending verification.** The request example for this endpoint has not yet been verified in production. Static examples describe the request format; replace sample values with your own. Check the estimated price with a free quote request (`X-AISA-Cost-Mode: quote`) before running it.",
        "operationId": "post_google_hotels_apis_v1_google_hotels_rates",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "pattern": "^https?:\\/\\/(?:[A-Za-z0-9-]+\\.)*(?:[Gg][Oo][Oo][Gg][Ll][Ee])\\.(?:[A-Za-z]{2,}|(?:ac|co|com|edu|gov|net|org)\\.[A-Za-z]{2})(?::\\d+)?\\/travel\\/hotels\\/\\S*$",
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
