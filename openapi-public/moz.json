    "/apis/v1/moz/web-backlinks-list": {
      "post": {
        "description": "not every sort/filter works with anchor_text, source_root_domain or subdomains_limited_to_one — see the Parameter Compatibility table in the docs\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.006667 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "moz.web-backlinks-list",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "anchor_text": {
                    "description": "only links whose normalised anchor text equals this; \"\\u0000\" matches empty anchor text",
                    "type": "string"
                  },
                  "filter": {
                    "description": "default 'external'; combine with '+', e.g. external+follow, external+nofollow, external+deleted, external+not_redirect",
                    "type": "string"
                  },
                  "limit": {
                    "description": "1-50, default 25 — this is the cost dial",
                    "maximum": 10,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "next_token": {
                    "description": "cursor from a previous response's next_token",
                    "type": "string"
                  },
                  "sort": {
                    "description": "default source_page_authority; also source_domain_authority, source_spam_score, source_link_propensity, root_domains_to_source_page/_root_domain",
                    "type": "string"
                  },
                  "source_root_domain": {
                    "description": "only links from this source root domain",
                    "type": "string"
                  },
                  "source_scope": {
                    "description": "page | subdomain | root_domain (default page) — at subdomain/root_domain returns only the best link per source",
                    "type": "string"
                  },
                  "subdomains_limited_to_one": {
                    "description": "return only the best link from each listed subdomain",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "target": {
                    "description": "URL to get links for",
                    "examples": [
                      "moz.com/blog"
                    ],
                    "type": "string"
                  },
                  "target_scope": {
                    "description": "page | subdomain | root_domain (default page)",
                    "examples": [
                      "page"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "limit",
                  "target"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Backlinks by domain or URL — source and target metrics",
        "tags": [
          "Moz"
        ],
        "x-aisa-capabilities": {
          "idempotency": "Idempotency-Key",
          "max_price": "X-AISA-Max-Price-USD",
          "mpp": false,
          "mpp_methods": [],
          "quote": {
            "header": "X-AISA-Cost-Mode",
            "value": "quote"
          },
          "x402": false
        },
        "x-aisa-catalog-id": "moz",
        "x-aisa-category": "seo",
        "x-aisa-docs-url": "https://aisa.one/docs/api-reference/moz/moz-web-backlinks-list",
        "x-aisa-passthrough": true,
