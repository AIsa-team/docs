        "operationId": "moz.web-backlinks-summary",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "distributions": {
                    "description": "must be true for the aggregate histograms that make this a backlink summary",
                    "enum": [
                      false
                    ],
                    "type": "boolean"
                  },
                  "targets": {
                    "description": "1-50 URLs or domains",
                    "items": {
