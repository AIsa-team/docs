    "/apis/v1/seranking/google-keywords-ideas": {
      "get": {
        "description": "Three sibling endpoints share this exact parameter shape and price and differ only in how\nthey pick the ideas: /v1/keywords/related (semantically related, this entry),\n/v1/keywords/similar (same-SERP overlap) and /v1/keywords/questions (question phrasings).\n/v1/keywords/longtail is the cheap one at 1 credit per keyword, but returns bare strings\nwith no metrics.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.00179 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "seranking.google-keywords-ideas",
        "parameters": [
          {
            "in": "query",
            "name": "filter[volume_from]",
            "required": false,
            "schema": {
              "description": "the filter family is bracketed: filter[volume_from], filter[volume_to], filter[difficulty_from], filter[cpc_to], filter[serp_features], filter[intents], filter[multi_keyword_included], filter[multi_keyword_excluded] …",
              "type": "integer"
            }
          },
          {
            "examples": {
              "default": {
                "value": false
              },
              "minimal": {
                "value": false
              }
            },
            "in": "query",
            "name": "history_trend",
            "required": true,
            "schema": {
              "description": "attach 12-month volume history to each keyword",
              "enum": [
                false
              ],
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "keyword",
            "required": true,
            "schema": {
              "description": "the seed keyword",
              "examples": [
                "avocado"
              ],
              "type": "string"
            }
          },
          {
            "examples": {
              "default": {
                "value": 1
              },
              "minimal": {
                "value": 1
              }
            },
            "in": "query",
            "name": "limit",
            "required": true,
            "schema": {
              "description": "COST DIAL — rows to return; default 100 at 10 credits each = 1,000 credits",
