          {
            "in": "query",
            "name": "domain",
            "required": true,
            "schema": {
              "description": "bare domain, no scheme",
              "examples": [
                "seranking.com"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "rows to return; flat per-request pricing means a large limit costs no more",
              "examples": [
                100
              ],
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "order_field",
            "required": false,
            "schema": {
              "type": "string"
