    "/apis/v1/seranking/google-domain-ranked-keywords": {
      "get": {
        "description": "one of `domain` or `url` is required. Set `type=adv` to get the domain's paid keywords from the same endpoint.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0179 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "seranking.google-domain-ranked-keywords",
        "parameters": [
          {
            "in": "query",
            "name": "cols",
            "required": false,
            "schema": {
              "description": "comma-separated column selection",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "description": "the domain to analyse — supply either domain or url",
              "examples": [
                "seranking.com"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "1 to 1,000, default 100. Pricing is flat per request, so a LARGE limit is the cheap choice here",
              "examples": [
                100
              ],
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "description": "1-12",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "order_field",
            "required": false,
            "schema": {
              "description": "column to sort by",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order_type",
            "required": false,
            "schema": {
              "description": "asc | desc (default desc)",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "1-based page number; default 1",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": true,
            "schema": {
              "description": "regional database code",
              "examples": [
                "us"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "description": "organic (default) | adv — `adv` returns the paid keywords instead",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "url",
            "required": false,
            "schema": {
              "description": "analyse one page instead of the whole domain",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "with_subdomains",
            "required": false,
            "schema": {
              "description": "default true",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "description": "with `month`, returns a historical snapshot",
              "type": "integer"
            }
          }
        ],
        "responses": {
