    "/apis/v1/seranking/google-domain-competitors": {
      "get": {
        "description": "the competitor set is derived from keyword overlap in the chosen `source` database, so a domain's competitors differ per country.\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0179 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "seranking.google-domain-competitors",
        "parameters": [
          {
            "in": "query",
            "name": "domain",
            "required": true,
            "schema": {
              "description": "bare domain, no scheme",
              "examples": [
                "seranking.com"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "rows to return; flat per-request pricing means a large limit costs no more",
              "examples": [
                100
              ],
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "order_field",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order_type",
            "required": false,
            "schema": {
              "description": "asc | desc",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": true,
            "schema": {
              "description": "regional database code",
              "examples": [
                "us"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "description": "organic (default) | adv — `adv` returns paid-search competitors",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet."
