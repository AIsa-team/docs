            "schema": {
              "description": "default 0",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "description": "keyword | volume | cpc | difficulty | competition",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "required": false,
            "schema": {
              "description": "asc | desc",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": true,
            "schema": {
              "description": "regional database code",
              "examples": [
                "us"
