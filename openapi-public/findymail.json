    "/apis/v1/findymail/lookalike-search": {
      "post": {
        "description": "returns {companies: [{domain, name, linkedin_url, company_size, country}], total, credits_used} — `credits_used` reports the actual charge back to you\n\n<!-- aisa-pricing:start -->\nUsage-based billing; Default request estimate: $0.0198 USD (not a fixed price). Account-specific pricing and final settlement may differ.\n<!-- aisa-pricing:end -->",
        "operationId": "findymail.lookalike-search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "exclusion_list_ids": {
                    "description": "ids of saved exclusion lists whose domains should be dropped from the results",
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "limit": {
                    "description": "max companies to return, default 100, up to 10000 — THIS IS THE PRICE DIAL",
                    "maximum": 10000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "same_country": {
                    "description": "restrict results to the seed's country",
                    "type": "boolean"
                  },
                  "same_size": {
                    "description": "restrict results to the seed's headcount band",
                    "type": "boolean"
                  },
                  "seed": {
                    "description": "the seed company's domain",
                    "examples": [
                      "stripe.com"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "limit",
                  "seed"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Find lookalike companies from a seed domain",
        "tags": [
          "Findymail"
        ],
