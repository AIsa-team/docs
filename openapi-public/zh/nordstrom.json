    "/apis/v1/nordstrom/product": {
      "post": {
        "description": "Nordstrom Product Details\n\n> **请求示例待验证。** 此接口的请求示例尚未在生产环境验证。静态示例用于说明请求格式，请替换为自己的参数。正式调用前，可用免费的报价模式（`X-AISA-Cost-Mode: quote`）查看预估费用。",
        "operationId": "post_nordstrom_apis_v1_nordstrom_product",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": false,
                "properties": {
                  "geoCode": {
                    "description": "Two-letter ISO 3166-1 country code of the proxy the page is fetched through, e.g. 'US', 'SG'. Use the target site's own country (e.g. 'ID' for lazada.co.id, 'TH' for th.hotels.com): it sets the localized prices, currency, language and availability.",
                    "pattern": "^[A-Za-z]{2}$",
                    "type": "string"
                  },
                  "super": {
                    "description": "Route through premium residential proxies with stronger anti-bot bypass. Off by default; turn it on only when a plain request is blocked, since it costs far more tokens (Nordstrom: 1 token off, 38-41 on).",
                    "type": "boolean"
                  },
                  "url": {
                    "description": "Nordstrom product API URL, /pdp/product-display/<productId>, where productId is the trailing number of a /s/<name>/<productId> product page. Optional query params add data (and tokens): postal-code=<zip> for local store availability, breadcrumb=true, enticements=true, string-manager=true. e.g. https://www.nordstrom.com/pdp/product-display/3339203",
                    "format": "uri",
                    "pattern": "^https://(?:www\\.)?nordstrom\\.com/pdp/product-display/[0-9]+(?:[/?#]|$)",
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "geoCode"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
