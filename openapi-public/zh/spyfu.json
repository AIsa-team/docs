    "/apis/v1/spyfu/google-domain-paid-keywords": {
      "get": {
        "description": "rows carry keyword, searchVolume, liveSearchVolume, rankingDifficulty, totalMonthlyClicks, broad/phrase/exactCostPerClick, broad/phrase/exactMonthlyCost, paidCompetitors, distinctCompetitors and serpFeaturesCsv. Note the path segment is `keyword_api`, unlike the other PPC endpoints which live under `serp_api`.\n\n> **请求示例待验证。** 此接口的请求示例尚未在生产环境验证。静态示例用于说明请求格式，请替换为自己的参数。正式调用前，可用免费的报价模式（`X-AISA-Cost-Mode: quote`）查看预估费用。",
        "operationId": "spyfu.google-domain-paid-keywords",
        "parameters": [
          {
            "in": "query",
            "name": "adultFilter",
            "required": false,
            "schema": {
              "description": "default true — filters adult keywords out",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "countryCode",
            "required": false,
            "schema": {
              "description": "default US",
              "examples": [
                "US"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "excludeTerms",
            "required": false,
            "schema": {
              "description": "drop keywords containing these terms",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "includeTerms",
            "required": false,
            "schema": {
              "description": "only keywords containing these terms",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "isQuestion",
            "required": false,
            "schema": {
              "description": "restrict to question keywords",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "isTransactionalIntent",
            "required": false,
            "schema": {
              "description": "restrict to transactional-intent keywords",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": true,
            "schema": {
              "description": "rows to return, 1 to 10,000, DEFAULT 5.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "description": "the advertiser — a domain, subdomain, URL or path. Note this family uses `query`, not `domain`",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "searchVolume.min",
            "required": false,
            "schema": {
              "description": "range filters use this dotted form; also searchVolume.max, liveSearchVolume.min/max, costPerClick.min/max, monthlyCost.min/max, adCount.min/max, keywordDifficulty.min/max",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "description": "default SearchVolume",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sortOrder",
            "required": false,
            "schema": {
              "description": "Ascending | Descending; default Descending",
              "type": "string"
