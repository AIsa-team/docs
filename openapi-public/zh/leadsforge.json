    "/apis/v1/leadsforge/people-email-find": {
      "post": {
        "description": "one of personID | linkedinURL | firstName+lastName+company signal is required. A miss is free.\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.0245 USD（不是固定价格）。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "leadsforge.people-email-find",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "company": {
                    "description": "company NAME, not a URL",
                    "examples": [
                      "Stripe"
                    ],
                    "type": "string"
                  },
                  "companyDomain": {
                    "description": "preferred company signal over `company`",
                    "examples": [
                      "stripe.com"
                    ],
                    "type": "string"
                  },
                  "externalID": {
                    "description": "max 128 chars, echoed back verbatim for CRM correlation",
                    "examples": [
                      "crm-contact-42"
                    ],
                    "type": "string"
                  },
                  "firstName": {
                    "description": "with lastName plus a company signal",
                    "examples": [
                      "Patrick"
                    ],
                    "type": "string"
                  },
                  "lastName": {
                    "examples": [
                      "Collison"
                    ],
                    "type": "string"
                  },
                  "linkedinURL": {
                    "description": "profile URL, used when you have no personID",
                    "examples": [
                      "https://www.linkedin.com/in/john-doe"
                    ],
                    "type": "string"
                  },
                  "personID": {
                    "description": "id from leadsforge.people.search — the most reliable input",
                    "examples": [
                      "p_abc123"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet."
          },
