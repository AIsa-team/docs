            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
        "summary": "Find a work email by LinkedIn URL or name + company",
        "tags": [
          "LeadsForge"
        ],
