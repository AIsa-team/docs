    "/apis/v1/leadsforge/people-email-find": {
      "post": {
        "description": "one of personID | linkedinURL | firstName+lastName+company signal is required. A miss is free.\n\n> **请求示例待验证。** 此接口的请求示例尚未在生产环境验证。静态示例用于说明请求格式，请替换为自己的参数。正式调用前，可用免费的报价模式（`X-AISA-Cost-Mode: quote`）查看预估费用。",
        "operationId": "leadsforge.people-email-find",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "company": {
                    "description": "company NAME, not a URL",
                    "examples": [
                      "Stripe"
                    ],
                    "type": "string"
                  },
                  "companyDomain": {
                    "description": "preferred company signal over `company`",
                    "examples": [
                      "stripe.com"
                    ],
                    "type": "string"
                  },
                  "externalID": {
                    "description": "max 128 chars, echoed back verbatim for CRM correlation",
                    "examples": [
                      "crm-contact-42"
                    ],
                    "type": "string"
                  },
                  "firstName": {
                    "description": "with lastName plus a company signal",
                    "examples": [
                      "Patrick"
                    ],
                    "type": "string"
                  },
                  "lastName": {
                    "examples": [
                      "Collison"
                    ],
                    "type": "string"
                  },
                  "linkedinURL": {
                    "description": "profile URL, used when you have no personID",
                    "examples": [
                      "https://www.linkedin.com/in/john-doe"
                    ],
                    "type": "string"
                  },
                  "personID": {
                    "description": "id from leadsforge.people.search — the most reliable input",
                    "examples": [
                      "p_abc123"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
