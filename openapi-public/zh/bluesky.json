    "/apis/v1/bluesky/profiles/{handle}/posts": {
      "get": {
        "description": "Lists posts from a Bluesky profile by handle. Results are paged: while `data.page.hasMore` is true, send `data.page.nextCursor` as `cursor` to get the next page.\n\n> **请求示例待验证。** 此接口的请求示例尚未在生产环境验证。静态示例用于说明请求格式，请替换为自己的参数。正式调用前，可用免费的报价模式（`X-AISA-Cost-Mode: quote`）查看预估费用。",
        "operationId": "bluesky.profiles.handle.posts",
        "parameters": [
          {
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "description": "Bluesky handle whose posts should be listed.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "Pagination cursor returned by a previous response.",
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "userId",
            "required": false,
            "schema": {
              "description": "Optional Bluesky user id to speed up the request.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "aisa_pagination": {
                      "additionalProperties": false,
                      "description": "AIsa pagination. Pass next_cursor as cursor to fetch the next page; has_more is false on the last page.",
                      "properties": {
                        "has_more": {
                          "type": "boolean"
                        },
                        "next_cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "next_param": {
                          "const": "cursor",
                          "type": "string"
                        }
                      },
                      "required": [
                        "has_more",
                        "next_cursor",
                        "next_param"
                      ],
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response. The payload schema has not been reviewed yet.",
            "headers": {
              "X-AISA-Has-More": {
                "description": "Mirrors aisa_pagination.has_more.",
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              },
              "X-AISA-Next-Cursor": {
                "description": "Mirrors aisa_pagination.next_cursor; absent on the last page.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error response; upstream passthrough responses may use provider formats"
          }
        },
