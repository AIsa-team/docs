        "parameters": [
          {
            "in": "query",
            "name": "company_url",
            "required": false,
            "schema": {
              "examples": [
                "microsoft.com"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "first_name",
            "required": false,
            "schema": {
              "examples": [
                "Satya"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_name",
            "required": false,
            "schema": {
              "examples": [
                "Nadella"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "linkedin_url",
            "required": false,
            "schema": {
              "examples": [
                "https://linkedin.com/in/satyanadella"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
