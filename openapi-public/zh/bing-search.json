                  }
                },
                "minimal": {
                  "value": {
                    "q": "example"
                  }
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "cc": {
                    "pattern": "^[a-zA-Z]{2}$",
                    "type": "string"
                  },
                  "device": {
                    "enum": [
                      "desktop",
                      "tablet",
                      "mobile"
                    ],
                    "type": "string"
                  },
                  "filters": {
                    "maxLength": 8192,
                    "minLength": 1,
                    "type": "string"
                  },
                  "first": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "lat": {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  },
                  "location": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "lon": {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  "mkt": {
                    "pattern": "^[a-zA-Z]{2}-[a-zA-Z]{2}$",
                    "type": "string"
                  },
                  "q": {
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string"
                  },
                  "safe_search": {
                    "enum": [
                      "off",
                      "moderate",
                      "strict"
                    ],
                    "type": "string"
                  }
                },
