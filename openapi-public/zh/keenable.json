    "/apis/v1/keenable/web-search": {
      "post": {
        "description": "Results include title, URL, description, snippet, and optional published/acquired timestamps. Unknown body fields are refused locally on the shared key.\n\n<!-- aisa-pricing:start -->\n按用量计费；默认请求预估费用：$0.004 USD（不是固定价格）。 最终费用以账户适用价格及实际结算为准。\n<!-- aisa-pricing:end -->",
        "operationId": "keenable.web-search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "acquired_after": {
                    "description": "RFC 3339 date, ISO 8601 timestamp, or relative delta such as 7d, 30min, 2h, 6mo, or 1y.",
                    "examples": [
                      "7d"
                    ],
                    "type": "string"
                  },
                  "acquired_before": {
                    "description": "RFC 3339 date, ISO 8601 timestamp, or relative delta. A bare date includes that full UTC day.",
                    "type": "string"
                  },
                  "max_results": {
                    "default": 10,
                    "examples": [
                      10
                    ],
                    "maximum": 50,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "mode": {
                    "default": "pro",
                    "description": "pro performs deeper retrieval; realtime returns faster. The response echoes the mode actually used.",
                    "enum": [
                      "pro",
                      "realtime"
                    ],
                    "examples": [
                      "pro"
                    ],
                    "type": "string"
                  },
                  "published_after": {
                    "description": "RFC 3339 date, ISO 8601 timestamp, or relative delta.",
                    "examples": [
                      "30d"
                    ],
                    "type": "string"
                  },
                  "published_before": {
                    "description": "RFC 3339 date, ISO 8601 timestamp, or relative delta. A bare date includes that full UTC day.",
                    "type": "string"
                  },
                  "query": {
                    "examples": [
                      "Keenable API documentation"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "query_time": {
                    "description": "Search the index as it existed at this date or timestamp; relative filters are rebased to it.",
                    "type": "string"
                  },
                  "site": {
                    "description": "Restrict results to one domain.",
                    "examples": [
                      "docs.keenable.ai"
                    ],
                    "type": "string"
                  },
                  "snippet_max_length": {
                    "examples": [
                      500
                    ],
                    "maximum": 10000,
                    "minimum": 180,
                    "type": "integer"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
