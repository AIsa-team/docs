                    "type": "string"
                  },
                  "hotelId": {
                    "description": "Trip.com hotel id, the `hotelId` in the hotel page URL (e.g. '3267031'). Reviews come back for THIS id even if `url` names another hotel.",
                    "pattern": "^\\d+$",
                    "type": "string"
                  },
                  "locale": {
                    "description": "Review language, e.g. 'en-US', 'id-ID' (default 'en-US').",
                    "minLength": 2,
                    "type": "string"
                  },
                  "page": {
                    "description": "Review page, starting at 1 (default 1).",
                    "maximum": 9007199254740991,
