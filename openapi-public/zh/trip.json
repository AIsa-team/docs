                    "type": "integer"
                  },
                  "pageSize": {
                    "description": "Reviews per page, up to 100 (default 100).",
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "url": {
                    "description": "Full Trip.com page URL, e.g. https://us.trip.com/hotels/...",
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
