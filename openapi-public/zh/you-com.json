      "Manual576A0Ea506F3_connect_YOUSEARCH_YOU_SEARCH": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "default": 10,
            "maximum": 20,
            "minimum": 1,
            "description": "Maximum number of search results to return per section (web/news). Valid range: 1-20."
          },
          "query": {
            "type": "string",
            "examples": [
              "How to sleep early",
              "Python programming tutorial",
              "climate change news"
            ],
            "description": "Search query string. Supports search operators for refined searches."
          },
          "offset": {
            "type": "integer",
            "default": 0,
            "maximum": 9,
            "minimum": 0,
            "description": "Pagination offset in multiples of count. For example, if count=10 and offset=1, returns results 10-20. Valid range: 0-9."
          },
          "country": {
            "type": "string",
            "examples": [
              "US",
              "GB",
              "CA",
              "AU",
              "DE",
              "FR",
              "JP",
              "IN",
              "BR",
              "MX"
            ],
            "description": "Country code for localized results (ISO 3166-1 alpha-2 format)."
          },
          "language": {
            "type": "string",
            "examples": [
              "EN",
              "FR",
              "DE",
              "ES",
              "ZH-HANS",
              "JA"
            ],
            "description": "Language code in BCP 47 format (e.g., EN, FR, DE, ES, ZH-HANS, JA)."
          },
          "freshness": {
            "type": "string",
            "examples": [
              "day",
              "week",
              "month",
              "2024-01-01to2024-12-31"
            ],
            "description": "Filter results by recency. Options: 'day', 'week', 'month', 'year', or date range in format 'YYYY-MM-DDtoYYYY-MM-DD'."
          },
          "safesearch": {
            "type": "string",
            "examples": [
              "off",
              "moderate",
              "strict"
            ],
            "description": "Content filtering level. Options: 'off', 'moderate', 'strict'."
          }
        }
      },
